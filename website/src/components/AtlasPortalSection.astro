---
// website/src/components/AtlasPortalSection.astro
// Scene 07: The Atlas Portal — Bản Đồ Tư Tưởng & Thiên Văn Cổ Điển
import SectionHeader from './SectionHeader.astro';
import ArtworkPlacard from './ArtworkPlacard.astro';
---

<section id="atlas-portal" class="py-20 sm:py-28 md:py-36 bg-surface/20 relative overflow-hidden border-t border-border/40">
  <!-- Subtle Celestial Radial Background Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(194,154,119,0.06)_0%,transparent_60%)] pointer-events-none" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Visual Column: Antique Celestial Map Plate Framing (5 cols) -->
      <div class="lg:col-span-5 order-2 lg:order-1 flex flex-col gap-3">
        <a href="/atlas" class="group block relative aspect-4/5 w-full max-w-md mx-auto overflow-hidden bg-surface shadow-2xl border border-accent/40 rounded-sm">
          <img
            src="/images/themes/theme_08/slide_1_establishing.jpg"
            alt="Trường Học Athens - Raffaello Sanzio (The Atlas Centerpiece)"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <!-- Celestial Astrolabe Ring Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-bg/95 via-bg/25 to-transparent flex flex-col justify-end p-6 text-center">
            <span class="font-mono text-[10px] uppercase tracking-widest text-accent mb-1">
              ✦ Cung Đỉnh Tri Thức ✦
            </span>
            <span class="font-display italic text-lg sm:text-xl text-text drop-shadow">
              "Khám phá mạng lưới 86 tư tưởng & kiệt tác hội họa bảo tàng"
            </span>
          </div>

          <div class="absolute top-3 right-3 px-2.5 py-1 rounded-sm bg-bg/80 backdrop-blur-md border border-accent/30 text-[10px] font-mono text-accent uppercase tracking-wider">
            8 Miền Thiên Văn
          </div>
        </a>

        <div class="max-w-md mx-auto w-full pt-1">
          <ArtworkPlacard
            title="Trường Học Athens (Scuola di Atene)"
            artist="Raffaello Sanzio"
            year="1509–1511"
            museum="Điện Tông Tòa (Vatican)"
            license="Public Domain / CC0"
            compact={true}
          />
        </div>
      </div>

      <!-- Narrative Column (7 cols) -->
      <div class="lg:col-span-7 order-1 lg:order-2 flex flex-col gap-6">
        <SectionHeader
          index="07"
          tag="THE ATLAS"
          title="The Atlas · Bản Đồ Tư Tưởng Đa Chiều"
          description="Thay vì những danh mục rời rạc, The Atlas kết nối toàn bộ triết gia kinh điển, kiệt tác hội họa và trích ngôn sâu sắc thành một tấm bản đồ thiên văn sống động."
        />

        <!-- 3 Master Features of The Atlas -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 bg-surface/50 border border-border/60 rounded-sm space-y-1.5">
            <span class="text-accent font-sans text-xs tracking-widest uppercase font-semibold">01 · 8 Miền Tư Tưởng</span>
            <p class="font-sans text-xs text-muted leading-relaxed">
              Phân vùng theo bản chất hiện sinh, từ bản ngã, tự do, cô độc đến thẩm mỹ và bóng tối nội tâm.
            </p>
          </div>

          <div class="p-4 bg-surface/50 border border-border/60 rounded-sm space-y-1.5">
            <span class="text-accent font-sans text-xs tracking-widest uppercase font-semibold">02 · 118 Liên Hệ Giám Tuyển</span>
            <p class="font-sans text-xs text-muted leading-relaxed">
              Mỗi chùm sao liên kết đều có lời giải thích rành mạch 'Vì sao liên quan?', bác bỏ các mindmap vô nghĩa.
            </p>
          </div>

          <div class="p-4 bg-surface/50 border border-border/60 rounded-sm space-y-1.5">
            <span class="text-accent font-sans text-xs tracking-widest uppercase font-semibold">03 · Tuyến Khám Phá</span>
            <p class="font-sans text-xs text-muted leading-relaxed">
              8 hành trình có hướng dẫn đưa bạn đi qua từng câu hỏi bản thể với câu hỏi gợi mở cho riêng mình.
            </p>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="/atlas"
            class="px-6 py-3.5 rounded-sm bg-accent text-on-accent font-sans text-xs uppercase tracking-widest font-semibold hover:brightness-110 transition-all shadow-md flex items-center gap-2 group"
          >
            <span>Khám Phá The Atlas Ngay</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a
            href="/themes"
            class="px-5 py-3.5 rounded-sm bg-surface hover:bg-surface-raised border border-border text-text font-sans text-xs uppercase tracking-widest font-medium transition-all"
          >
            Mục Lục Chủ Đề
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
