---
// BackToTop.astro - Contemplative Floating Action Widget (Museum V3.1)
---

<button
  id="back-to-top-fab"
  type="button"
  aria-label="Cuộn lên đầu trang"
  title="Lên đầu trang"
  class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full border border-border/80 bg-surface/90 backdrop-blur-md shadow-2xl flex items-center justify-center text-muted hover:text-accent hover:border-accent/60 hover:scale-105 active:scale-95 opacity-0 pointer-events-none translate-y-3 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent"
>
  <svg class="w-4 h-4 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script is:inline>
  const fab = document.getElementById('back-to-top-fab');

  if (fab) {
    function toggleFabVisibility() {
      if (window.scrollY > 300) {
        fab.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
        fab.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        fab.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
        fab.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    }

    window.addEventListener('scroll', toggleFabVisibility, { passive: true });

    fab.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  }
</script>
