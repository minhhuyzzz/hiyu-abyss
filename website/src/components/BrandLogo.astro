---
// BrandLogo.astro - Subtle Modern Monogram (Abyss Lens & Mirror Portals)
interface Props {
  variant?: 'full' | 'compact' | 'icon-only';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
---

<a
  href="/"
  class={`group inline-flex items-center gap-2.5 sm:gap-3 focus:outline-none focus:ring-1 focus:ring-accent rounded transition-opacity duration-200 hover:opacity-90 ${className}`}
  aria-label="Về trang chủ Hiyu Abyss"
>
  <!-- Architectural Monogram Icon: The Mirror & The Abyss Horizon -->
  <div class="relative w-7 h-7 sm:w-8 sm:h-8 flex-shrink-0 flex items-center justify-center">
    <svg
      class="w-full h-full text-accent transition-transform duration-500 group-hover:scale-105"
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Outer Contemplative Ring -->
      <circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="1.25" stroke-opacity="0.35" />
      
      <!-- Converging Reflective Arcs (The Mind & The Mirror) -->
      <path
        d="M 14 13 C 21 19 21 29 14 35"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
      />
      <path
        d="M 34 13 C 27 19 27 29 34 35"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
      />
      
      <!-- Central Horizon Line (The Abyss Axis) -->
      <line x1="24" y1="11" x2="24" y2="37" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      
      <!-- Focal Singularity Point -->
      <circle cx="24" cy="24" r="2" fill="currentColor" />
    </svg>
  </div>

  {variant !== 'icon-only' && (
    <span class="font-display text-sm sm:text-lg tracking-[0.16em] sm:tracking-[0.24em] font-bold uppercase text-text leading-tight group-hover:text-accent transition-colors">
      HIYU ABYSS
    </span>
  )}
</a>
