---
// EditorialMosaic.astro - Scene 03: Curator's Selection (Museum Asymmetric Wall)
import type { PublicQuote, TopicDefinition } from '../lib/types';
import SectionHeader from './SectionHeader.astro';
import ArtworkPlacard from './ArtworkPlacard.astro';

interface Props {
  featuredQuotes: PublicQuote[];
  topics: TopicDefinition[];
}

const { featuredQuotes, topics } = Astro.props;
const leadQuote = featuredQuotes[0];
const secondaryQuotes = featuredQuotes.slice(1, 4);
---

<section class="py-20 sm:py-28 md:py-36 bg-surface/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Systematic 03 / CURATOR'S SELECTION) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-16 pb-4">
      <SectionHeader
        index="03"
        tag="CURATOR'S SELECTION"
        title="Tuyển Tập Giám Tuyển Độc Bản"
        description="Những lát cắt tư tưởng sắc bén được chọn lọc từ kho tàng, đối chứng trực tiếp với các kiệt tác mỹ thuật bảo tàng."
      />
      <a
        href="/library"
        class="text-xs tracking-[0.2em] uppercase text-muted hover:text-accent font-semibold transition-colors self-start sm:self-auto flex items-center gap-2 group whitespace-nowrap pb-2"
      >
        <span>Xem toàn bộ thư viện</span>
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <!-- Editorial Asymmetric Wall (No SaaS card bento) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Lead Feature (7 cols): Large artwork spread with thoughtful reading -->
      {leadQuote && (
        <article class="lg:col-span-7 flex flex-col gap-6 group">
          <div class="relative aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden bg-surface border border-border/80 shadow-xl">
            <img
              src={leadQuote.artInfo?.slides?.slide_1 || `/images/themes/${leadQuote.imageRef}/slide_1_establishing.jpg`}
              alt={leadQuote.artInfo?.alt_vi || leadQuote.cleanTitle}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3 text-xs tracking-wider uppercase font-sans text-muted">
              <span class="text-accent font-semibold">{leadQuote.primaryTopicTitle}</span>
              <span class="text-border">·</span>
              <span>{leadQuote.author}</span>
            </div>

            <h3 class="font-display text-2xl sm:text-3xl text-text font-medium leading-snug group-hover:text-accent transition-colors">
              <a href={`/library/${leadQuote.slug}`}>
                {leadQuote.cleanTitle}
              </a>
            </h3>

            <blockquote class="font-serif text-base sm:text-lg text-text/85 italic border-l-2 border-accent/60 pl-4 my-1 leading-relaxed">
              "{leadQuote.content}"
            </blockquote>

            {leadQuote.artInfo && (
              <div class="pt-2">
                <ArtworkPlacard
                  title={leadQuote.artInfo.title}
                  artist={leadQuote.artInfo.artist}
                  year={leadQuote.artInfo.year}
                  museum={leadQuote.artInfo.museum}
                  license={leadQuote.artInfo.license}
                  compact={true}
                />
              </div>
            )}
          </div>
        </article>
      )}

      <!-- Secondary Sequence (5 cols): Editorial Column with Quiet Dividers -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        {secondaryQuotes.map((q, idx) => (
          <article class="flex flex-col gap-3 pb-8 border-b border-border/60 last:border-b-0 group">
            <div class="flex items-center justify-between text-xs tracking-wider uppercase font-sans text-muted">
              <span class="text-accent font-semibold">{q.primaryTopicTitle}</span>
              <span>{q.author}</span>
            </div>

            <h4 class="font-display text-lg sm:text-xl text-text font-medium group-hover:text-accent transition-colors leading-snug">
              <a href={`/library/${q.slug}`}>
                {q.cleanTitle}
              </a>
            </h4>

            <p class="font-serif text-sm text-text/80 italic leading-relaxed line-clamp-3">
              "{q.content}"
            </p>

            <div class="pt-1 flex items-center justify-between text-xs text-muted font-sans">
              <span class="text-[10px] uppercase tracking-wider">{q.quoteTypeLabel}</span>
              <a
                href={`/library/${q.slug}`}
                class="text-accent group-hover:underline flex items-center gap-1 font-semibold text-[11px] uppercase tracking-widest"
              >
                <span>Đọc bài</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>

  </div>
</section>
