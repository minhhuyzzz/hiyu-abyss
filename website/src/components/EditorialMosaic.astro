---
// EditorialMosaic.astro - Asymmetrical Bento Grid with Doppelrand Hardware Architecture
import type { PublicQuote, TopicDefinition } from '../lib/types';

interface Props {
  featuredQuotes: PublicQuote[];
  topics: TopicDefinition[];
}

const { featuredQuotes, topics } = Astro.props;
const heroQuote = featuredQuotes[0];
const subQuotes = featuredQuotes.slice(1, 4);
---

<section class="py-20 sm:py-28 md:py-36 bg-surface/30 border-b border-border/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Masthead -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-16 pb-6 border-b border-border/60">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] uppercase tracking-[0.2em] font-sans font-medium text-accent border border-accent/30 bg-accent/10 mb-2">
          Curated Editorial Mosaic
        </div>
        <h2 class="font-display text-2xl sm:text-4xl text-text font-medium mt-1">
          Nhịp Điệu Mỹ Học & Tư Tưởng
        </h2>
      </div>
      <a
        href="/library"
        class="group inline-flex items-center gap-2 text-xs tracking-[0.15em] uppercase text-muted hover:text-accent font-semibold transition-colors self-start sm:self-auto"
      >
        <span>Xem toàn bộ 100 tác phẩm</span>
        <span class="w-6 h-6 rounded-full border border-border flex items-center justify-center transition-transform group-hover:translate-x-1 group-hover:border-accent">
          →
        </span>
      </a>
    </div>

    <!-- Magazine Asymmetric Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      <!-- Left Column (5 cols): Reading Cards (Double-Bezel Architecture) -->
      <div class="md:col-span-5 flex flex-col gap-6">
        {subQuotes.map((q) => (
          <article class="group p-1 rounded-2xl bg-surface border border-border/80 hover:border-accent/60 transition-all duration-500 shadow-md hover:shadow-xl flex flex-col justify-between">
            <div class="p-6 rounded-[calc(1rem-0.125rem)] bg-bg/60 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between text-xs text-muted mb-2 font-sans">
                  <span class="tracking-widest uppercase font-semibold text-accent text-[11px]">{q.primaryTopicTitle}</span>
                  <span class="text-[11px]">{q.author}</span>
                </div>
                <h3 class="font-display text-lg sm:text-xl text-text font-medium group-hover:text-accent transition-colors leading-snug">
                  <a href={`/library/${q.slug}`}>
                    {q.cleanTitle}
                  </a>
                </h3>
                <p class="font-serif text-sm text-text/80 line-clamp-3 italic leading-relaxed pt-1">
                  "{q.content}"
                </p>
              </div>
              <div class="pt-3 border-t border-border/40 flex items-center justify-between text-xs text-muted font-sans">
                <span class="text-[10px] uppercase tracking-wider">{q.quoteTypeLabel}</span>
                <a href={`/library/${q.slug}`} class="text-accent group-hover:underline flex items-center gap-1 font-semibold text-[11px] uppercase tracking-wider">
                  <span>Đọc tiếp</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Right Column (7 cols): Monument Showcase & Mirror Teaser -->
      <div class="md:col-span-7 flex flex-col justify-between gap-8">
        
        <!-- The Mirror Interactive Teaser Banner (Double-Bezel Hardware Architecture) -->
        <div class="relative overflow-hidden p-1.5 rounded-[2rem] bg-gradient-to-br from-accent/20 via-surface to-border/40 border border-accent/40 shadow-2xl">
          <div class="relative rounded-[calc(2rem-0.375rem)] overflow-hidden bg-bg/90 p-8 sm:p-12 z-10 flex flex-col justify-between">
            <div class="max-w-lg space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] uppercase tracking-[0.2em] font-sans font-medium text-accent border border-accent/30 bg-accent/10">
                Trải Nghiệm Chiêm Nghiệm
              </div>
              <h3 class="font-display text-3xl sm:text-4xl text-text font-medium leading-tight">
                The Mirror: Chiếc Gương Phản Tư
              </h3>
              <p class="font-serif text-base sm:text-lg text-text/90 italic leading-relaxed">
                "Bạn muốn một sự thật làm mình bất an, hay một lời giải thích giúp mình yên lòng?"
              </p>
              <p class="font-sans text-xs sm:text-sm text-muted leading-relaxed">
                Bước vào hành trình đối thoại 5 nhịp, nơi câu hỏi quan trọng hơn câu trả lời. Hoàn toàn riêng tư tại trình duyệt của bạn.
              </p>
            </div>

            <div class="pt-8">
              <a
                href="/mirror/su-that-va-binh-yen"
                class="group inline-flex items-center gap-3 pl-7 pr-2.5 py-2.5 rounded-full bg-accent text-on-accent font-sans text-xs tracking-[0.15em] uppercase font-bold hover:opacity-95 transition-all shadow-xl active:scale-[0.98]"
              >
                <span>Bắt Đầu Hành Trình</span>
                <span class="w-8 h-8 rounded-full bg-on-accent/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1">
                  →
                </span>
              </a>
            </div>

            <!-- Decorative Subtle Ring Lines -->
            <div class="absolute -right-12 -bottom-12 w-64 h-64 rounded-full border border-accent/15 pointer-events-none"></div>
            <div class="absolute -right-24 -bottom-24 w-88 h-88 rounded-full border border-accent/10 pointer-events-none"></div>
          </div>
        </div>

        <!-- Topics Quick Cloud Card -->
        <div class="p-6 sm:p-8 rounded-2xl border border-border/80 bg-surface/70 space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <h4 class="font-display text-base tracking-[0.15em] uppercase font-semibold text-text">
              Dòng Tư Tưởng Mở
            </h4>
            <a href="/themes" class="text-xs uppercase tracking-wider font-sans text-accent hover:underline">
              Xem tất cả ({topics.length}) →
            </a>
          </div>
          <div class="flex flex-wrap gap-2 pt-1">
            {topics.slice(0, 10).map((t) => (
              <a
                href={`/themes/${t.slug}`}
                class="px-3.5 py-1.5 rounded-full text-xs font-sans border border-border/80 bg-bg/80 text-muted hover:text-text hover:border-accent hover:bg-surface transition-all"
              >
                #{t.title} <span class="text-[10px] opacity-60">({t.count})</span>
              </a>
            ))}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
