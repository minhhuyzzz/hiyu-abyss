---
// EditorialMosaic.astro
import type { PublicQuote, TopicDefinition } from '../lib/types';

interface Props {
  featuredQuotes: PublicQuote[];
  topics: TopicDefinition[];
}

const { featuredQuotes, topics } = Astro.props;
const heroQuote = featuredQuotes[0];
const subQuotes = featuredQuotes.slice(1, 4);
---

<section class="py-16 md:py-24 bg-surface/50 border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Masthead -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 pb-4 border-b border-border/60">
      <div>
        <span class="font-sans text-xs tracking-[0.25em] text-accent uppercase font-semibold">
          Curated Editorial Mosaic
        </span>
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-text font-bold mt-1">
          Nhịp Điệu Mỹ Học & Tư Tưởng
        </h2>
      </div>
      <a
        href="/library"
        class="inline-flex items-center gap-2 text-xs tracking-[0.15em] uppercase text-muted hover:text-accent font-semibold transition-colors"
      >
        <span>Xem toàn bộ 100 tác phẩm</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Magazine Asymmetric Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <!-- Left Column (4 cols): Reading Cards -->
      <div class="md:col-span-5 flex flex-col gap-6">
        {subQuotes.map((q) => (
          <article class="p-6 rounded-lg border border-border bg-bg/70 hover:border-accent/70 transition-all duration-300 group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-muted mb-3 font-sans">
                <span class="tracking-widest uppercase font-semibold text-accent">{q.primaryTopicTitle}</span>
                <span>{q.author}</span>
              </div>
              <h3 class="font-display text-lg text-text font-bold mb-2 group-hover:text-accent transition-colors leading-snug">
                <a href={`/library/${q.slug}`}>
                  {q.cleanTitle}
                </a>
              </h3>
              <p class="font-serif text-sm text-text/80 line-clamp-3 italic leading-relaxed">
                "{q.content}"
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-border/40 flex items-center justify-between text-xs text-muted">
              <span class="text-[11px] uppercase tracking-wider">{q.quoteTypeLabel}</span>
              <a href={`/library/${q.slug}`} class="text-accent hover:underline flex items-center gap-1 font-medium">
                Đọc tiếp →
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Right Column (7 cols): Monument Showcase & Mirror Teaser -->
      <div class="md:col-span-7 flex flex-col gap-8">
        
        <!-- The Mirror Interactive Teaser Banner -->
        <div class="relative overflow-hidden rounded-xl border border-accent/40 bg-gradient-to-br from-surface to-bg p-8 sm:p-10 shadow-lg">
          <div class="max-w-md z-10 relative">
            <span class="font-sans text-xs tracking-[0.25em] text-accent uppercase font-bold">
              Trải Nghiệm Tương Tác
            </span>
            <h3 class="font-display text-2xl sm:text-3xl text-text font-bold mt-2 mb-3">
              The Mirror: Chiếc Gương Phản Tư
            </h3>
            <p class="font-serif text-sm sm:text-base text-muted leading-relaxed mb-6">
              "Bạn muốn một sự thật làm mình bất an, hay một lời an ủi giúp mình yên lòng?" — Bước vào hành trình đối thoại 5 nhịp không phán xét.
            </p>
            <a
              href="/mirror/su-that-va-binh-yen"
              class="inline-flex items-center justify-center px-6 py-3 rounded bg-accent text-on-accent font-sans text-xs sm:text-sm tracking-[0.15em] uppercase font-bold hover:opacity-90 transition-opacity"
            >
              Bắt Đầu Hành Trình →
            </a>
          </div>
          <!-- Decorative Background Silhouette -->
          <div class="absolute -right-8 -bottom-8 w-64 h-64 rounded-full border border-accent/20 pointer-events-none opacity-40"></div>
          <div class="absolute -right-16 -bottom-16 w-80 h-80 rounded-full border border-accent/10 pointer-events-none opacity-20"></div>
        </div>

        <!-- Topics Quick Cloud -->
        <div class="p-6 rounded-lg border border-border bg-bg/50">
          <h4 class="font-display text-sm tracking-[0.2em] uppercase font-bold text-text mb-4">
            Bản Đồ Chủ Đề Triết Học Mở
          </h4>
          <div class="flex flex-wrap gap-2">
            {topics.slice(0, 12).map((t) => (
              <a
                href={`/themes/${t.slug}`}
                class="px-3 py-1.5 rounded text-xs border border-border bg-surface text-muted hover:text-accent hover:border-accent transition-colors"
              >
                {t.title} <span class="text-[10px] opacity-70">({t.count})</span>
              </a>
            ))}
            <a
              href="/themes"
              class="px-3 py-1.5 rounded text-xs border border-accent/50 bg-accent/10 text-accent hover:bg-accent hover:text-on-accent transition-colors font-medium"
            >
              Xem tất cả chủ đề →
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
