---
// Footer.astro - Pure Vietnamese Museum Editorial Footer (V3.1)
import BrandLogo from './BrandLogo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-surface border-t border-border mt-auto transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Brand & Mission Column (7 cols) -->
      <div class="md:col-span-7 flex flex-col gap-4">
        <BrandLogo variant="full" />
        <p class="font-serif text-sm sm:text-base text-muted leading-relaxed max-w-lg mt-1">
          Không gian lưu giữ và giám tuyển tư tưởng triết học, tâm lý học hành vi và mỹ học cổ điển. 
          Nơi câu chữ sâu lắng đối thoại cùng các kiệt tác bảo tàng để khơi gợi sự tự soi chiếu nội tâm.
        </p>
        <div class="flex items-center gap-2.5 text-xs tracking-widest text-muted uppercase mt-1 font-mono text-[11px]">
          <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <span data-i18n-vi="KHO LƯU TRỮ ĐANG MỞ RỘNG LIÊN TỤC" data-i18n-en="CONTINUOUS LIVING ARCHIVE">KHO LƯU TRỮ ĐANG MỞ RỘNG LIÊN TỤC</span>
        </div>
      </div>

      <!-- Quick Navigation Links (5 cols) -->
      <div class="md:col-span-5 flex flex-col gap-3 md:pl-8">
        <h3 class="font-display text-xs tracking-[0.22em] uppercase font-bold text-text mb-2">
          Điều Hướng
        </h3>
        <ul class="grid grid-cols-2 gap-3 text-sm text-muted">
          <li>
            <a href="/library" class="hover:text-accent transition-colors font-medium">Thư Viện</a>
          </li>
          <li>
            <a href="/mirror" class="hover:text-accent transition-colors font-medium">Chiếc Gương</a>
          </li>
          <li>
            <a href="/themes" class="hover:text-accent transition-colors font-medium">Bản Đồ Chủ Đề</a>
          </li>
          <li>
            <a href="/search" class="hover:text-accent transition-colors font-medium">Tìm Kiếm Toàn Văn</a>
          </li>
        </ul>

        <div class="pt-4 mt-2 border-t border-border/40 flex items-center gap-4">
          <a
            href="https://www.tiktok.com/@hiyuabyss"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs uppercase tracking-widest text-accent hover:text-text font-semibold flex items-center gap-1.5 transition-colors"
          >
            <span>Kênh TikTok @hiyuabyss</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Line -->
    <div class="border-t border-border/50 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted">
      <p>© {currentYear} Hiyu Abyss. Bảo tồn di sản tư tưởng & mỹ học cổ điển.</p>
      <div class="flex items-center gap-4 text-[11px] font-mono tracking-wider">
        <span>Black Archive</span>
        <span class="text-border">·</span>
        <span>Pale Archive</span>
      </div>
    </div>
  </div>
</footer>
