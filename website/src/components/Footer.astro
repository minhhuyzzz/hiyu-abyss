---
// Footer.astro - Pure Museum Editorial Footer (Taste-Skill / Awwwards-Tier Architecture)
import BrandLogo from './BrandLogo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="relative w-full bg-[#0A0907] text-[#D8D2C6] mt-auto transition-colors duration-300 overflow-hidden pt-16 sm:pt-20 pb-8">
  <!-- Subtle Ambient Top Hairline (Fades smoothly to edges, eliminating harsh line cuts) -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-border/70 to-transparent"></div>
  
  <!-- Subtle Ambient Radial Halo (Awwwards-tier depth) -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[220px] bg-accent/5 blur-[100px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 4-Column Architectural Grid with Harmonious Spacing -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-12 items-start">
      
      <!-- Brand & Mission Column (4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <BrandLogo variant="compact" />

        <p class="font-serif italic text-sm text-muted/90 leading-relaxed max-w-sm pt-1">
          Kho lưu trữ triết học và tâm lý học đa chiều — nơi bóc trần những nghịch lý bản ngã, các cơ chế phòng vệ và khơi mở cuộc đối thoại sâu sắc cùng những tư tưởng kinh điển.
        </p>

        <!-- Live Status Hardware Badge (No limits/numbers) -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-accent/30 bg-accent/10 text-accent font-mono text-[10px] tracking-[0.2em] uppercase font-semibold w-fit mt-1">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span data-i18n-vi="KHO LƯU TRỮ ĐANG MỞ RỘNG LIÊN TỤC" data-i18n-en="CONTINUOUS LIVING ARCHIVE">KHO LƯU TRỮ ĐANG MỞ RỘNG LIÊN TỤC</span>
        </div>
      </div>

      <!-- Quick Portals (3 cols) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <h3 class="font-mono text-[10px] tracking-[0.25em] uppercase font-bold text-accent mb-1">
          KHÔNG GIAN
        </h3>
        <ul class="space-y-2.5 text-xs font-sans text-muted">
          <li>
            <a href="/library" class="hover:text-text transition-colors">Thư Viện Triết Ngôn</a>
          </li>
          <li>
            <a href="/mirror" class="hover:text-text transition-colors">Chiếc Gương (The Mirror)</a>
          </li>
          <li>
            <a href="/themes" class="hover:text-text transition-colors">Chủ Đề & Căn Nguyên</a>
          </li>
          <li>
            <a href="/agora" class="hover:text-text transition-colors">Đối Thoại (The Agora)</a>
          </li>
          <li>
            <a href="/saved" class="hover:text-text transition-colors">Kho Lưu Trữ Cá Nhân</a>
          </li>
        </ul>
      </div>

      <!-- Standards & Methodology (2 cols) -->
      <div class="lg:col-span-2 flex flex-col gap-3">
        <h3 class="font-mono text-[10px] tracking-[0.25em] uppercase font-bold text-accent mb-1">
          TIÊU CHUẨN
        </h3>
        <ul class="space-y-2.5 text-xs font-sans text-muted">
          <li>
            <a href="/library" class="hover:text-text transition-colors">Tranh Sơn Dầu Cổ Điển</a>
          </li>
          <li>
            <a href="/agora/guidelines" class="hover:text-text transition-colors">Tiêu Chuẩn Biên Tập</a>
          </li>
          <li>
            <a href="/search" class="hover:text-text transition-colors">Thẩm Định Nguồn Gốc</a>
          </li>
          <li>
            <a href="/account" class="hover:text-text transition-colors">Bảo Mật & Danh Tính</a>
          </li>
        </ul>
      </div>

      <!-- Outreach & Connected Network (3 cols) -->
      <div class="lg:col-span-3 flex flex-col gap-3.5">
        <h3 class="font-mono text-[10px] tracking-[0.25em] uppercase font-bold text-accent mb-1">
          LAN TỎA
        </h3>
        
        <!-- TikTok Channel Card (Double-Bezel Mini Card) -->
        <a
          href="https://www.tiktok.com/@hiyu.abyss"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3.5 rounded-xl border border-border/70 bg-surface/40 hover:bg-surface/80 hover:border-accent/70 transition-all duration-300 group flex items-center justify-between"
        >
          <div class="space-y-0.5">
            <span class="text-xs font-sans font-bold text-text group-hover:text-accent transition-colors block">
              Kênh TikTok @hiyu.abyss
            </span>
            <span class="text-[11px] font-serif italic text-muted block">
              Trích ngôn & tranh sơn dầu
            </span>
          </div>
          <span class="w-7 h-7 rounded-full bg-surface-raised border border-border/60 text-accent flex items-center justify-center text-xs transition-transform duration-300 group-hover:rotate-45">
            ↗
          </span>
        </a>

        <!-- Quick Search Bar Shortcut -->
        <a
          href="/search"
          class="px-3.5 py-2.5 rounded-xl border border-border/60 bg-surface/30 hover:border-accent/50 text-xs font-sans text-muted hover:text-text flex items-center justify-between transition-colors"
        >
          <span>Tìm kiếm chiêm nghiệm...</span>
          <kbd class="px-1.5 py-0.5 rounded bg-black/40 text-[10px] font-mono text-accent/80 border border-border/40">
            /
          </kbd>
        </a>
      </div>

    </div>

    <!-- Architectural Hairline Divider -->
    <div class="w-full h-px bg-border/40 my-10"></div>

    <!-- Bottom Signature Line -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted/80 font-sans">
      <p>© {currentYear} HIYU ABYSS. Bảo tồn di sản tư tưởng & mỹ học cổ điển.</p>

      <div class="flex items-center gap-6">
        <!-- Dual Theme Status -->
        <div class="flex items-center gap-3 text-[11px] font-mono tracking-wider">
          <span class="text-accent font-semibold">● BLACK ARCHIVE</span>
          <span class="text-border">·</span>
          <span class="text-muted/60">○ PALE ARCHIVE</span>
        </div>
      </div>
    </div>

    <!-- Monumental Architectural Watermark (Responsive SVG Typography - Guaranteed No Truncation) -->
    <div class="w-full select-none pointer-events-none pt-8 sm:pt-12 pb-2 flex items-center justify-center opacity-[0.035] overflow-hidden">
      <svg
        viewBox="0 0 1000 90"
        class="w-full max-w-5xl h-auto"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <text
          x="500"
          y="68"
          text-anchor="middle"
          fill="currentColor"
          class="font-display font-bold uppercase"
          style="font-size: 76px; letter-spacing: 0.18em;"
        >
          HIYU ABYSS
        </text>
      </svg>
    </div>

  </div>
</footer>
