---
// Header.astro - Refined Wide Floating Navigation Header (V3.2 / Taste-Skill)
import BrandLogo from './BrandLogo.astro';
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/library', label: 'Thư Viện', enLabel: 'The Library' },
  { href: '/mirror', label: 'Chiếc Gương', enLabel: 'The Mirror' },
  { href: '/themes', label: 'Chủ Đề', enLabel: 'Themes' },
  { href: '/search', label: 'Tìm Kiếm', enLabel: 'Search' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-3 sm:top-5 z-50 w-full px-3 sm:px-6 lg:px-8 pointer-events-none transition-all duration-300">
  <!-- Expanded Width: max-w-6xl for elegant architectural presence -->
  <div class="max-w-6xl mx-auto w-full pointer-events-auto">
    <!-- Fluid Floating Glass Island (h-13 sm:h-14, px-2.5 sm:px-7) -->
    <div class="h-13 sm:h-14 px-2.5 sm:px-7 rounded-full border border-border/80 bg-surface/90 backdrop-blur-md shadow-xl flex items-center justify-between transition-all duration-300 hover:border-accent/40">
      
      <!-- Brand Logo (Pure wordmark without secondary tag) -->
      <BrandLogo variant="compact" />

      <!-- Desktop Navigation Links with Generous Spacing -->
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-3" aria-label="Điều hướng chính">
        {navLinks.map((link) => {
          const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`nav-link-item relative px-3.5 py-1.5 rounded-full text-xs uppercase tracking-[0.16em] font-sans transition-all duration-200 ${
                isActive
                  ? 'bg-accent/15 text-accent font-semibold border border-accent/25 shadow-xs'
                  : 'text-muted hover:text-text hover:bg-surface-raised/70'
              }`}
              data-href={link.href}
              data-i18n-vi={link.label}
              data-i18n-en={link.enLabel}
            >
              <span class="nav-label-text">{link.label}</span>
              {isActive && (
                <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-accent" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Header Actions (Saved Archive + Language + Theme + Mobile Trigger) -->
      <div class="flex items-center gap-1 sm:gap-2.5">
        
        <!-- Saved Archive Drawer Trigger Button with Dynamic Counter Badge -->
        <button
          id="open-saved-drawer-btn"
          type="button"
          class="px-2 sm:px-3 py-1.5 text-xs font-sans text-muted hover:text-accent rounded-full border border-border/70 hover:border-accent/50 bg-surface/60 hover:bg-surface-raised transition-all flex items-center gap-1.5 sm:gap-2 min-h-[36px]"
          aria-label="Mở kho tác phẩm đã lưu"
          title="Kho lưu trữ cá nhân"
        >
          <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          <span
            class="hidden sm:inline text-[11px] tracking-wider uppercase font-medium"
            id="saved-header-label"
            data-i18n-vi="Kho"
            data-i18n-en="Saved"
          >
            Kho
          </span>
          <span
            id="saved-count-badge"
            class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-semibold bg-accent/20 text-accent border border-accent/30"
          >
            0
          </span>
        </button>

        <!-- Bilingual Switcher [VI | EN] (Applies globally across the entire site) -->
        <button
          id="lang-toggle-btn"
          type="button"
          class="px-2 sm:px-2.5 py-1.5 text-[11px] sm:text-xs tracking-wider sm:tracking-widest font-mono font-semibold text-muted hover:text-text rounded-full border border-border/70 hover:border-accent/50 bg-surface/60 hover:bg-surface-raised transition-all min-h-[36px] flex items-center"
          aria-label="Chuyển đổi ngôn ngữ Tiếng Việt / English"
          title="Switch language (VI / EN)"
        >
          <span id="lang-indicator-vi" class="text-accent font-bold">VI</span>
          <span class="text-border mx-1">/</span>
          <span id="lang-indicator-en" class="text-muted/60">EN</span>
        </button>

        <!-- Dual-Theme Switcher -->
        <ThemeToggle />

        <!-- Mobile Animated Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden relative w-9 h-9 rounded-full flex flex-col items-center justify-center gap-1.2 p-1.5 text-muted hover:text-text hover:bg-surface-raised transition-all"
          aria-label="Mở danh mục điều hướng"
          aria-expanded="false"
        >
          <span class="hamburger-bar w-4 h-0.5 bg-current transition-all duration-300 transform origin-center"></span>
          <span class="hamburger-bar w-4 h-0.5 bg-current transition-all duration-300 transform origin-center"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Overlay -->
    <div
      id="mobile-menu"
      class="hidden md:hidden mt-2 p-5 rounded-2xl border border-border/80 bg-surface/98 backdrop-blur-2xl shadow-2xl transition-all duration-300"
    >
      <nav class="flex flex-col gap-1.5">
        {navLinks.map((link) => {
          const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`nav-mobile-link flex items-center justify-between px-4 py-2.5 rounded-xl text-xs uppercase tracking-[0.15em] font-sans transition-all ${
                isActive
                  ? 'bg-accent/15 text-accent font-semibold border border-accent/25'
                  : 'text-text hover:bg-surface-raised'
              }`}
              data-i18n-vi={link.label}
              data-i18n-en={link.enLabel}
            >
              <span class="mobile-label-text">{link.label}</span>
              <span class="text-[10px] text-muted tracking-widest font-serif lowercase italic">
                {link.enLabel}
              </span>
            </a>
          );
        })}
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile Hamburger Toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const bars = document.querySelectorAll('.hamburger-bar');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', !isExpanded);
      mobileMenu.classList.toggle('hidden');

      if (!isExpanded) {
        if (bars[0]) bars[0].style.transform = 'translateY(3px) rotate(45deg)';
        if (bars[1]) bars[1].style.transform = 'translateY(-3px) rotate(-45deg)';
      } else {
        if (bars[0]) bars[0].style.transform = '';
        if (bars[1]) bars[1].style.transform = '';
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        if (bars[0]) bars[0].style.transform = '';
        if (bars[1]) bars[1].style.transform = '';
      }
    });
  }

  // Global Language Switcher Trigger
  const langToggleBtn = document.getElementById('lang-toggle-btn');
  const viIndicator = document.getElementById('lang-indicator-vi');
  const enIndicator = document.getElementById('lang-indicator-en');

  function updateHeaderLangUI(lang) {
    if (viIndicator && enIndicator) {
      if (lang === 'en') {
        viIndicator.className = 'text-muted/60';
        enIndicator.className = 'text-accent font-bold';
      } else {
        viIndicator.className = 'text-accent font-bold';
        enIndicator.className = 'text-muted/60';
      }
    }
  }

  const currentLang = localStorage.getItem('hiyu_lang') || 'vi';
  updateHeaderLangUI(currentLang);

  if (langToggleBtn) {
    langToggleBtn.addEventListener('click', () => {
      const activeLang = localStorage.getItem('hiyu_lang') || 'vi';
      const nextLang = activeLang === 'vi' ? 'en' : 'vi';
      localStorage.setItem('hiyu_lang', nextLang);
      updateHeaderLangUI(nextLang);
      window.dispatchEvent(new CustomEvent('hiyu-lang-changed', { detail: { lang: nextLang } }));
    });
  }

  window.addEventListener('hiyu-lang-changed', (e) => {
    updateHeaderLangUI(e.detail.lang);
  });

  // Sync Saved Count Badge in Header
  function syncHeaderSavedBadge() {
    try {
      const badge = document.getElementById('saved-count-badge');
      if (!badge) return;
      const saved = JSON.parse(localStorage.getItem('hiyu_saved_quotes') || '[]');
      badge.textContent = saved.length.toString();
      if (saved.length > 0) {
        badge.classList.remove('opacity-50');
      } else {
        badge.classList.add('opacity-50');
      }
    } catch (e) {}
  }

  syncHeaderSavedBadge();
  window.addEventListener('storage', syncHeaderSavedBadge);
  window.addEventListener('hiyu-bookmark-updated', syncHeaderSavedBadge);
</script>
