---
// Header.astro
import BrandLogo from './BrandLogo.astro';
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/library', label: 'Thư Viện', enLabel: 'The Library' },
  { href: '/mirror', label: 'Chiếc Gương', enLabel: 'The Mirror' },
  { href: '/themes', label: 'Chủ Đề', enLabel: 'Themes' },
  { href: '/search', label: 'Tìm Kiếm', enLabel: 'Search' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-bg/95 backdrop-blur-md border-b border-border/60 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <BrandLogo variant="full" />

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Điều hướng chính">
      {navLinks.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`group relative py-1 text-sm tracking-[0.1em] uppercase font-medium transition-colors duration-200 ${
              isActive ? 'text-accent font-semibold' : 'text-muted hover:text-text'
            }`}
          >
            <span>{link.label}</span>
            <span class={`absolute bottom-0 left-0 h-[2px] bg-accent transition-all duration-300 ${
              isActive ? 'w-full' : 'w-0 group-hover:w-full'
            }`} />
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Search icon + Theme Toggle + Mobile Menu Trigger) -->
    <div class="flex items-center gap-2 sm:gap-4">
      <a
        href="/search"
        class="p-2 text-muted hover:text-text rounded-full hover:bg-surface transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center md:hidden"
        aria-label="Tìm kiếm"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8" stroke-width="1.75" />
          <path d="m21 21-4.35-4.35" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </a>

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 text-muted hover:text-text rounded-lg hover:bg-surface transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
        aria-label="Mở danh mục điều hướng"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-b border-border bg-surface/98 backdrop-blur-lg px-6 py-6 transition-all duration-300"
  >
    <nav class="flex flex-col gap-4">
      {navLinks.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`flex items-center justify-between py-3 text-base tracking-[0.1em] uppercase font-medium border-b border-border/30 ${
              isActive ? 'text-accent font-semibold' : 'text-text hover:text-accent'
            }`}
          >
            <span>{link.label}</span>
            <span class="text-xs text-muted tracking-widest font-serif lowercase italic">{link.enLabel}</span>
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      if (hamIcon && closeIcon) {
        hamIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });
  }
</script>
