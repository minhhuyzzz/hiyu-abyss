---
// HeroArtwork.astro - Scene 01: The Entrance (Museum Editorial Architecture)
import ArtworkPlacard from './ArtworkPlacard.astro';

interface Props {
  quote: {
    cleanTitle: string;
    content: string;
    author: string;
    quoteTypeLabel: string;
    imageRef: string;
    slug: string;
    artInfo?: {
      title: string;
      artist: string;
      year?: string;
      museum: string;
      license?: string;
      alt_vi?: string;
      slides: { slide_1: string };
    };
  };
}

const { quote } = Astro.props;
const artSrc = quote.artInfo?.slides?.slide_1 || `/images/themes/${quote.imageRef}/slide_1_establishing.jpg`;
const artTitle = quote.artInfo?.title || "Tác phẩm mỹ thuật cổ điển";
const artArtist = quote.artInfo?.artist || "Danh họa";
const artYear = quote.artInfo?.year;
const artMuseum = quote.artInfo?.museum || "Bảo tàng quốc tế";
const artLicense = quote.artInfo?.license || "Public Domain / CC0";
const artAlt = quote.artInfo?.alt_vi || `${artTitle} - ${artArtist}`;
---

<section class="relative w-full py-16 sm:py-24 md:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial Split Grid: Asymmetric 7/5 columns -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Master Typography & Thought (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-6 sm:gap-8 order-2 lg:order-1">
        
        <!-- Systematic Header Tag (No White Dashes) -->
        <div class="flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-sans text-muted">
          <span class="text-accent font-semibold">01</span>
          <span class="text-muted/30">/</span>
          <span>{quote.quoteTypeLabel} · {quote.author}</span>
        </div>

        <!-- Master Title / Question -->
        <h1 class="font-display text-3xl sm:text-5xl md:text-6xl text-text font-medium leading-[1.14] tracking-tight text-balance">
          {quote.cleanTitle}
        </h1>

        <!-- Inscription of Truth -->
        <div class="relative pl-6 py-1 border-l-2 border-accent">
          <blockquote class="font-serif text-lg sm:text-2xl text-text/90 italic leading-relaxed sm:leading-loose">
            "{quote.content}"
          </blockquote>
        </div>

        <p class="font-sans text-sm sm:text-base text-muted max-w-xl leading-relaxed">
          Hiyu Abyss là một thư viện tư tưởng và ấn phẩm mỹ thuật sống. Nơi triết học hành vi đối thoại cùng các kiệt tác hội họa qua hàng thế kỷ để khơi gợi sự tự soi chiếu nội tâm.
        </p>

        <!-- Museum Editorial Actions (No SaaS Pill Buttons) -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href={`/library/${quote.slug}`}
            class="px-7 py-3.5 bg-accent text-on-accent font-sans text-xs tracking-[0.18em] uppercase font-bold hover:opacity-90 transition-opacity duration-200 min-h-[48px] inline-flex items-center justify-center shadow-sm"
          >
            Đọc Chiêm Nghiệm
          </a>

          <a
            href="/mirror/su-that-va-binh-yen"
            class="px-6 py-3.5 border border-border/80 bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs tracking-[0.18em] uppercase font-semibold transition-colors duration-200 min-h-[48px] inline-flex items-center gap-2"
          >
            <span>Vào Chiếc Gương Phản Tư</span>
            <span class="text-xs">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Classical Artwork Exhibition Frame (5 cols) -->
      <div class="lg:col-span-5 order-1 lg:order-2 flex flex-col gap-3">
        <div class="relative aspect-[9/16] w-full max-w-sm sm:max-w-md mx-auto overflow-hidden bg-surface border border-border/80 shadow-2xl">
          <img
            src={artSrc}
            alt={artAlt}
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-[1.02]"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Museum Gallery Placard Below the Artwork -->
        <div class="max-w-sm sm:max-w-md mx-auto w-full pt-1">
          <ArtworkPlacard
            title={artTitle}
            artist={artArtist}
            year={artYear}
            museum={artMuseum}
            license={artLicense}
            compact={true}
          />
        </div>
      </div>

    </div>
  </div>
</section>
