---
// HeroArtwork.astro - The Living Codex of Hiyu Abyss (Physical Open Book & Sanctuary Introduction)
interface Props {
  quote?: any; // Optional for backward compatibility
}

const masterpiece = {
  src: '/images/hero/school_of_athens.jpg',
  title: 'Scuola di Atene (Trường Học Athens)',
  artist: 'Raffaello Sanzio',
  year: '1509–1511',
  medium: 'Bích họa Sơn Dầu Phục Hưng',
  museum: 'Phòng Raffaello, Điện Tông Tòa (Vatican)',
  license: 'Public Domain / CC0',
  alt: 'Kiệt tác bích họa Trường Học Athens của danh họa Raphael',
};
---

<section class="relative w-full py-5 sm:py-8 lg:py-10 min-h-[calc(100vh-5.5rem)] flex items-center overflow-hidden" aria-label="Giới thiệu không gian Hiyu Abyss">
  <!-- Ambient Atmospheric Radiant Halos (Warm golden light radiating from the book) -->
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[650px] h-[450px] bg-accent/10 blur-[140px] pointer-events-none rounded-full"></div>
  <div class="absolute top-1/3 left-1/4 -translate-x-1/2 w-[500px] h-[350px] bg-oxide/5 blur-[120px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    
    <!-- 2-Column Asymmetric Balance: Left 45% (Editorial Manifesto) / Right 55% (Open Physical Antique Codex) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
      
      <!-- Left Column: Permanent Brand Identity & Manifesto (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4 sm:gap-5 order-1">
        
        <!-- Eyebrow Tag Pill -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-accent/10 border border-accent/25 text-accent font-mono text-[10px] tracking-[0.24em] uppercase w-fit">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span>THE LIVING ARCHIVE · HIYU ABYSS</span>
        </div>

        <!-- Monumental Brand Statement (Refined Typographic Hierarchy) -->
        <div class="space-y-1.5">
          <h1 class="font-display text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.1rem] text-text font-normal leading-[1.12] tracking-tight text-balance">
            Đọc để nhìn <br/>
            <span class="italic font-serif text-accent">thế giới khác đi.</span>
          </h1>
          <p class="font-serif italic text-lg sm:text-xl text-text/80 leading-snug">
            Suy ngẫm để thấu tỏ chính mình.
          </p>
        </div>

        <!-- Brand Purpose Narrative (Pure, Sharp & Philosophical Editorial) -->
        <p class="font-sans text-xs sm:text-sm text-muted/90 max-w-lg leading-relaxed">
          Tuyển tập những câu nói hay và góc nhìn sâu sắc về cuộc sống, tâm lý con người bên cạnh mỹ thuật kinh điển. Không vỗ về bằng sự tích cực giả tạo — đây là chiếc gương soi chiếu để bạn bóc trần những chiếc mặt nạ xã hội và thấu suốt bản ngã.
        </p>

        <!-- Elegant Micro-Pillars Strip (Airy breathing points with warm accents) -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] font-sans text-muted/90 py-0.5">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span class="font-medium text-text">Bóc trần nghịch lý</span>
          </span>
          <span class="text-border">·</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span class="font-medium text-text">Mỹ thuật bảo tàng</span>
          </span>
          <span class="text-border">·</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span class="font-medium text-text">Đối thoại mở</span>
          </span>
        </div>

        <!-- Button-in-Button Primary & Secondary CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <!-- Primary CTA: The Library -->
          <a
            href="/library"
            class="group pl-5 pr-2.5 py-2 bg-accent text-on-accent rounded-full font-sans text-xs tracking-wider uppercase font-bold hover:opacity-95 hover:shadow-[0_0_24px_rgba(184,137,96,0.35)] transition-all duration-300 inline-flex items-center gap-3 shadow-lg active:scale-98"
          >
            <span>Khám Phá Thư Viện</span>
            <span class="w-6 h-6 rounded-full bg-black/20 text-white flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5">
              →
            </span>
          </a>

          <!-- Secondary CTA: The Mirror -->
          <a
            href="/mirror"
            class="group pl-5 pr-2.5 py-2 border border-border/80 bg-surface/80 text-text hover:border-accent hover:text-accent rounded-full font-sans text-xs tracking-wider uppercase font-semibold transition-all duration-300 inline-flex items-center gap-3 active:scale-98"
          >
            <span>The Mirror</span>
            <span class="w-6 h-6 rounded-full bg-surface-raised border border-border/60 text-accent flex items-center justify-center text-[10px] transition-transform duration-300 group-hover:rotate-45">
              ◈
            </span>
          </a>

          <!-- Tertiary CTA: The Agora -->
          <a
            href="/agora"
            class="px-3 py-2 text-xs text-muted hover:text-accent font-sans tracking-wider uppercase transition-colors inline-flex items-center gap-1 font-medium"
          >
            <span>The Agora</span>
            <span class="text-accent text-sm">↗</span>
          </a>
        </div>

        <!-- Museum Authority Strip -->
        <div class="flex items-center gap-3 pt-1 text-[10px] font-mono text-muted/70 tracking-widest uppercase">
          <span class="text-accent font-semibold">● KHO LƯU TRỮ SỐNG</span>
          <span class="text-border">·</span>
          <span>KHẮC KỶ & HIỆN SINH</span>
          <span class="text-border">·</span>
          <span>MỸ THUẬT BẢO TÀNG</span>
        </div>

      </div>

      <!-- Right Column: Physical Antique Leather Book (7 cols) - Spread Layout -->
      <div class="lg:col-span-7 flex flex-col items-center justify-center order-2">
        
        <!-- Physical Antique Codex Container -->
        <div class="relative w-full max-w-xl lg:max-w-2xl xl:max-w-3xl mx-auto filter drop-shadow-[0_25px_45px_rgba(0,0,0,0.6)]">
          
          <!-- Outer Leather Binding Edge / Antique Book Cover Casing -->
          <div class="relative p-2.5 sm:p-3 rounded-2xl bg-[#15120E] border-2 border-[#3D3322] shadow-[0_30px_70px_rgba(0,0,0,0.85)]">
            
            <!-- Book Spine Central Gutter Line & Silk Ribbon -->
            <div class="hidden sm:flex absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-8 pointer-events-none z-30 justify-center">
              <!-- Central Trough Shadow (Realistic spine depression) -->
              <div class="w-4 h-full bg-gradient-to-r from-black/60 via-black/10 to-black/60 opacity-95"></div>
              <!-- Golden Silk Ribbon Bookmark with Chevron Notched Tail -->
              <div class="absolute -top-1 w-3.5 h-32 bg-gradient-to-b from-[#C29A77] via-[#B88960] to-[#734F31] shadow-xl border-x border-[#5E3F24]/70" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 88%, 0 100%);">
                <div class="w-full h-full bg-gradient-to-b from-transparent via-white/25 to-black/35"></div>
              </div>
            </div>

            <!-- Two Facing Pages (Open Book Spread Layout - Warm Antique Parchment with Stacked Page Thickness) -->
            <div class="relative grid grid-cols-1 sm:grid-cols-2 rounded-xl overflow-hidden bg-[#F6EFE3] text-[#241F18] border border-[#3D3322]/25 shadow-[inset_0_2px_8px_rgba(0,0,0,0.12),inset_0_-2px_8px_rgba(0,0,0,0.08)]">
              
              <!-- Stacked Page Thickness Illusion (Gờ xếp trang vật lý) -->
              <div class="hidden sm:block absolute bottom-0 inset-x-0 h-[3px] bg-gradient-to-b from-[#E6DCBF] to-[#BFA985] opacity-80 z-20 pointer-events-none border-t border-[#3D3322]/15"></div>

              <!-- ============================================== -->
              <!-- LEFT PAGE: The Classical Painting Plate (Trang Trái: Bức Họa Kiệt Tác) -->
              <!-- ============================================== -->
              <div class="p-3.5 sm:p-4.5 flex flex-col justify-between border-b sm:border-b-0 sm:border-r border-[#3D3322]/20 relative bg-gradient-to-r from-[#FAF5EC] via-[#F6EFE3] to-[#E9DFCE] z-10 overflow-hidden">
                
                <!-- Page Header: Folio & Classical Plate -->
                <div class="flex items-center justify-between text-[8.5px] font-mono tracking-[0.2em] uppercase text-[#6B6457] pb-1.5 border-b border-[#3D3322]/15">
                  <span>TABULA PICTA</span>
                  <span>FOLIO I · PRIMUM</span>
                </div>

                <!-- Museum Plate Image Frame with Dramatic Radiance Light Spill -->
                <div class="my-2 relative">
                  <div class="relative aspect-[4/3] w-full overflow-hidden rounded-sm border border-[#3D3322]/40 shadow-md group">
                    <img
                      src={masterpiece.src}
                      alt={masterpiece.alt}
                      class="w-full h-full object-cover filter brightness-[0.97] contrast-[1.04] transition-transform duration-700 group-hover:scale-105"
                      loading="eager"
                      decoding="async"
                    />
                    <!-- Subtle Museum Corner Inset -->
                    <div class="absolute inset-0 pointer-events-none border border-white/20 m-1 rounded-xs"></div>
                  </div>

                  <!-- Radiance Light Spill Flare (Ánh sáng vàng ấm quang học tràn ra từ tranh sang trang sách) -->
                  <div class="absolute -top-6 -bottom-6 -right-10 w-36 bg-gradient-to-r from-amber-400/35 via-amber-300/20 to-transparent blur-xl pointer-events-none z-20 mix-blend-screen"></div>
                  <div class="absolute -inset-3 bg-gradient-to-tr from-amber-500/25 via-accent/20 to-transparent blur-lg pointer-events-none -z-10"></div>
                </div>

                <!-- Painting Placard Inscription -->
                <div class="pt-1.5 border-t border-[#3D3322]/15 space-y-0.5 text-left">
                  <h3 class="font-display text-xs sm:text-[13px] font-bold text-[#1F1B15] leading-tight">
                    {masterpiece.title}
                  </h3>
                  <p class="font-serif italic text-[9.5px] text-[#6E6454]">
                    {masterpiece.artist} ({masterpiece.year}) · {masterpiece.museum}
                  </p>
                </div>

              </div>

              <!-- ============================================== -->
              <!-- RIGHT PAGE: The Sanctuary Manifesto Prologue (Trang Phải: Lời Tựa Cuốn Sách) -->
              <!-- ============================================== -->
              <div class="p-4 sm:p-5 flex flex-col justify-between relative bg-gradient-to-l from-[#FAF5EC] via-[#F6EFE3] to-[#E9DFCE] z-10">
                
                <!-- Volumetric Warm Light Spilling Onto Right Page Surface -->
                <div class="pointer-events-none absolute inset-y-0 left-0 w-28 bg-gradient-to-r from-amber-400/20 via-accent/10 to-transparent blur-lg z-20"></div>

                <!-- Page Header: Codex Marking -->
                <div class="flex items-center justify-between text-[8.5px] font-mono tracking-[0.2em] uppercase text-[#6B6457] pb-1.5 border-b border-[#3D3322]/15">
                  <span>CODEX ABYSSI</span>
                  <span>PROLOGUS</span>
                </div>

                <!-- Page Body: Official Manifesto Inscription -->
                <div class="my-auto py-1.5 space-y-2 relative z-25">
                  
                  <!-- Tag: Lời Mở Đầu -->
                  <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#3D3322]/10 border border-[#3D3322]/20 text-[8.5px] font-mono tracking-widest uppercase font-semibold text-[#8E5A3C]">
                    <span class="w-1 h-1 rounded-full bg-[#8E5A3C]"></span>
                    <span>LỜI TỰA · KHO LƯU TRỮ SỐNG</span>
                  </div>

                  <!-- Book Prologue Manifesto (Chân thật, bản sắc, không trích dẫn lẻ tẻ) -->
                  <blockquote class="font-serif italic text-xs sm:text-[12.5px] md:text-[13px] text-[#1F1B15] leading-relaxed my-0.5">
                    "Khi bạn lật mở những trang sách này, bạn không tìm kiếm những ảo ảnh xoa dịu nhất thời. Đây là chiếc gương soi chiếu những phần sâu kín nhất của bản ngã — nơi ánh sáng của tri thức và bóng tối của nhân tính gặp gỡ."
                  </blockquote>

                  <p class="font-sans text-[9.5px] sm:text-[10.5px] text-[#5E5648] leading-relaxed pt-0.5">
                    Bảo tồn các cơ chế tâm lý hành vi, giải phẫu những nghịch lý bản ngã và khơi mở cuộc đối thoại đa chiều cùng những kiệt tác mỹ thuật bảo tàng.
                  </p>
                </div>

                <!-- Page Footer: Library Ex Libris & Deep Action -->
                <div class="pt-2 mt-auto border-t border-[#3D3322]/15 flex items-center justify-between text-[9.5px] font-sans relative z-25">
                  <div>
                    <strong class="font-mono text-[8.5px] text-[#8E5A3C] uppercase tracking-wider block font-bold">EX LIBRIS</strong>
                    <span class="font-mono text-[7.5px] text-[#8C8373] uppercase">HIYU ABYSS · ARCHIVE</span>
                  </div>

                  <a
                    href="/library"
                    class="text-[#8E5A3C] hover:text-[#5E3A26] font-semibold text-[9.5px] uppercase tracking-wider flex items-center gap-1 group/link"
                    title="Khám phá toàn bộ tác phẩm trong thư viện"
                  >
                    <span>Khám phá kho</span>
                    <span class="transition-transform group-hover/link:translate-x-0.5">→</span>
                  </a>
                </div>

              </div>

            </div>

          </div>

          <!-- Bottom Book Shadow / Table Surface Cast -->
          <div class="w-11/12 mx-auto h-4 bg-black/60 blur-xl rounded-full -mt-2"></div>
        </div>

      </div>

    </div>
  </div>
</section>
