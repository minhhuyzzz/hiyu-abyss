---
// HeroArtwork.astro
interface Props {
  quote: {
    cleanTitle: string;
    content: string;
    author: string;
    quoteTypeLabel: string;
    imageRef: string;
    slug: string;
    artInfo?: {
      title: string;
      artist: string;
      museum: string;
      slides: { slide_1: string };
    };
  };
}

const { quote } = Astro.props;
const artSrc = quote.artInfo?.slides?.slide_1 || `/images/themes/${quote.imageRef}/slide_1_establishing.jpg`;
---

<section class="relative w-full overflow-hidden border-b border-border bg-bg py-12 md:py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Master Typography & Thought -->
      <div class="lg:col-span-7 flex flex-col gap-6 z-10 order-2 lg:order-1">
        <!-- Sub-badge -->
        <div class="inline-flex items-center gap-2 self-start px-3 py-1 rounded-full border border-border bg-surface text-xs tracking-[0.2em] uppercase font-sans text-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          <span>{quote.quoteTypeLabel} · {quote.author}</span>
        </div>

        <!-- Master Title / Question -->
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-text font-bold leading-[1.15] tracking-tight">
          {quote.cleanTitle}
        </h1>

        <!-- Blockquote Inscription -->
        <blockquote class="font-serif text-lg sm:text-xl md:text-2xl text-text/90 italic leading-relaxed border-l-2 border-accent pl-5 my-2">
          "{quote.content}"
        </blockquote>

        <p class="font-sans text-sm text-muted max-w-xl leading-relaxed">
          Mỗi tác phẩm trong kho tàng Hiyu Abyss là một cuộc đối thoại không khoan nhượng giữa bóng tối tâm lý và ánh sáng mỹ học, giúp bóc trần những chiếc mặt nạ ta vẫn mang mỗi ngày.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href={`/library/${quote.slug}`}
            class="inline-flex items-center justify-center px-6 py-3 rounded border border-accent bg-accent text-on-accent font-sans text-xs sm:text-sm tracking-[0.15em] uppercase font-semibold hover:opacity-90 transition-all duration-200 min-h-[44px]"
          >
            Đọc Chiêm Nghiệm
          </a>
          <a
            href="/mirror"
            class="inline-flex items-center justify-center px-6 py-3 rounded border border-border bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs sm:text-sm tracking-[0.15em] uppercase font-semibold transition-all duration-200 min-h-[44px]"
          >
            Vào Chiếc Gương Phản Tư
          </a>
        </div>
      </div>

      <!-- Right Column: Curated Museum Artwork Frame -->
      <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center">
        <div class="group relative w-full max-w-md aspect-[9/16] rounded-lg overflow-hidden border border-border/80 shadow-2xl bg-surface">
          <!-- Artwork Image -->
          <img
            src={artSrc}
            alt={quote.artInfo?.alt_vi || quote.cleanTitle}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="eager"
            decoding="async"
          />

          <!-- Gradient Wash Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-300"></div>

          <!-- Bottom Artwork Caption -->
          {quote.artInfo && (
            <div class="absolute bottom-4 left-4 right-4 p-3 rounded bg-bg/85 backdrop-blur-md border border-border/60 text-xs">
              <p class="font-serif italic text-text font-medium truncate">
                "{quote.artInfo.title}"
              </p>
              <p class="text-[11px] text-muted truncate mt-0.5">
                {quote.artInfo.artist} · {quote.artInfo.museum}
              </p>
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</section>
