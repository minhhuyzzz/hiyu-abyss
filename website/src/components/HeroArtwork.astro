---
// HeroArtwork.astro - The Living Codex of the Abyss (V3.5 Physical Book Architecture)
import ArtworkPlacard from './ArtworkPlacard.astro';

interface Props {
  quote: {
    cleanTitle: string;
    content: string;
    description?: string;
    author: string;
    primaryTopicTitle: string;
    quoteTypeLabel: string;
    imageRef: string;
    slug: string;
    id: string;
    artInfo?: {
      title: string;
      artist: string;
      year?: string;
      museum: string;
      license?: string;
      alt_vi?: string;
      slides: { slide_1: string };
    };
  };
}

const { quote } = Astro.props;
const artSrc = quote.artInfo?.slides?.slide_1 || `/images/themes/${quote.imageRef}/slide_1_establishing.jpg`;
const artTitle = quote.artInfo?.title || "Tác phẩm mỹ thuật cổ điển";
const artArtist = quote.artInfo?.artist || "Danh họa";
const artYear = quote.artInfo?.year;
const artMuseum = quote.artInfo?.museum || "Bảo tàng quốc tế";
const artLicense = quote.artInfo?.license || "Public Domain / CC0";
const artAlt = quote.artInfo?.alt_vi || `${artTitle} - ${artArtist}`;

// Extract editorial reflection for curator insight note
let curatorInsight = '';
if (quote.description) {
  const sentences = quote.description.split(/(?<=[.?!])\s+/);
  curatorInsight = sentences.slice(0, 2).join(' ');
}
if (!curatorInsight) {
  curatorInsight = `Một chiêm nghiệm sâu sắc về bản ngã, các cơ chế phòng vệ và ranh giới tâm lý con người trong đời sống hiện đại.`;
}
---

<section class="relative w-full py-10 sm:py-16 md:py-20 overflow-hidden" aria-label="Khu vực mở đầu">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial 2-Column Asymmetric Balance (Left 45% Brand / Right 55% Book) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Permanent Brand Identity & Curator Direction (5 cols) - Order 1 on all viewports -->
      <div class="lg:col-span-5 flex flex-col gap-6 order-1">
        
        <!-- Eyebrow Tag Pill -->
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/40 bg-accent/10 text-accent font-mono text-[10px] tracking-[0.2em] uppercase font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            <span data-i18n-vi="KHO LƯU TRỮ SỐNG" data-i18n-en="THE LIVING ARCHIVE">KHO LƯU TRỮ SỐNG</span>
          </span>
          <span class="text-muted/40 font-mono text-xs">/</span>
          <span class="text-xs font-mono tracking-widest uppercase text-muted/80 font-semibold">
            HIYU ABYSS
          </span>
        </div>

        <!-- Monumental Brand Statement (Refined Typographic Hierarchy) -->
        <div class="space-y-3">
          <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.35rem] text-text font-normal leading-[1.08] tracking-tight text-balance">
            Đọc để nhìn <br/>
            <span class="italic font-serif text-accent">thế giới khác đi.</span>
          </h1>
          <p class="font-serif italic text-xl sm:text-2xl text-text/80 leading-snug">
            Suy ngẫm để thấu tỏ chính mình.
          </p>
        </div>

        <!-- Brand Purpose Narrative (Sharp & Philosophical) -->
        <p class="font-sans text-sm sm:text-base text-muted/90 max-w-xl leading-relaxed">
          Không chỉ là trích dẫn. Hiyu Abyss là không gian bóc trần những nghịch lý bản ngã, soi chiếu bóng tối nội tâm và khơi mở cuộc đối thoại đa chiều cùng những tư tưởng kinh điển.
        </p>

        <!-- Curator Accession & Provenance Strip (Replaces redundant quote box) -->
        <div class="flex items-center gap-3 py-2.5 px-3.5 rounded-xl bg-surface/60 border border-border/70 backdrop-blur-sm max-w-xl">
          <div class="w-2 h-2 rounded-full bg-accent flex-shrink-0 animate-pulse"></div>
          <div class="text-xs font-sans text-text/90 flex-1 truncate">
            <span class="text-muted text-[10px] uppercase tracking-wider font-mono mr-1.5">Tác Phẩm Hôm Nay:</span>
            <span class="font-serif italic font-medium">Folio #{quote.id.replace('TXT-', '')}</span>
            <span class="text-muted/60 mx-1.5">·</span>
            <span class="text-accent font-semibold">{quote.author}</span>
            <span class="text-muted/60 mx-1.5">·</span>
            <span class="text-muted text-[11px]">#{quote.primaryTopicTitle}</span>
          </div>
          <a
            href={`/library/${quote.slug}`}
            class="text-[11px] font-mono text-accent hover:underline uppercase tracking-wider flex-shrink-0 font-medium"
          >
            Chi tiết →
          </a>
        </div>

        <!-- Button-in-Button Primary & Secondary CTAs -->
        <div class="flex flex-wrap items-center gap-3.5 pt-1">
          <!-- Primary CTA -->
          <a
            href="/library"
            class="group pl-6 pr-2.5 py-2.5 bg-accent text-on-accent rounded-full font-sans text-xs tracking-wider uppercase font-bold hover:opacity-95 hover:shadow-[0_0_24px_rgba(184,137,96,0.35)] transition-all duration-300 inline-flex items-center gap-3 shadow-lg active:scale-[0.98]"
          >
            <span data-i18n-vi="Khám Phá Thư Viện" data-i18n-en="Explore Library">Khám Phá Thư Viện</span>
            <span class="w-7 h-7 rounded-full bg-black/20 text-white flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5">
              →
            </span>
          </a>

          <!-- Secondary CTA -->
          <a
            href="/mirror"
            class="group pl-5 pr-2.5 py-2.5 border border-border/80 bg-surface/70 text-text hover:border-accent hover:text-accent rounded-full font-sans text-xs tracking-wider uppercase font-semibold transition-all duration-300 inline-flex items-center gap-3 active:scale-[0.98]"
          >
            <span data-i18n-vi="Chiếc Gương (The Mirror)" data-i18n-en="The Mirror">Chiếc Gương (The Mirror)</span>
            <span class="w-7 h-7 rounded-full bg-surface-raised border border-border/60 text-accent flex items-center justify-center text-[10px] transition-transform duration-300 group-hover:rotate-45">
              ◈
            </span>
          </a>

          <!-- Tertiary CTA: The Agora -->
          <a
            href="/agora"
            class="px-3 py-2 text-xs text-muted hover:text-accent font-sans tracking-wider uppercase transition-colors inline-flex items-center gap-1.5"
          >
            <span data-i18n-vi="Đối Thoại (Agora)" data-i18n-en="The Agora">Đối Thoại (Agora)</span>
            <span class="text-accent text-sm">↗</span>
          </a>
        </div>

        <!-- Museum Authority Metrics -->
        <div class="flex items-center gap-4 sm:gap-6 pt-1 text-[11px] font-mono text-muted/70 tracking-widest uppercase">
          <div class="flex items-center gap-1.5">
            <span class="text-accent font-semibold font-sans text-xs">●</span>
            <span>Kho Lưu Trữ Sống</span>
          </div>
          <span class="text-border">·</span>
          <div class="flex items-center gap-1.5">
            <span class="text-accent font-semibold font-sans text-xs">Khắc Kỷ & Hiện Sinh</span>
            <span>Tư Tưởng</span>
          </div>
          <span class="text-border">·</span>
          <div class="flex items-center gap-1.5">
            <span class="text-accent font-semibold font-sans text-xs">Sơn Dầu</span>
            <span>Bảo Tàng</span>
          </div>
        </div>
      </div>

      <!-- Right Column: The Physical Open Codex / Manuscript Spread (7 cols) - Order 2 on all viewports -->
      <div class="lg:col-span-7 order-2 flex flex-col items-center">
        
        <!-- Physical Antique Codex Container -->
        <div class="relative w-full max-w-xl lg:max-w-2xl mx-auto filter drop-shadow-[0_20px_35px_rgba(0,0,0,0.45)]">
          
          <!-- Outer Leather Binding Edge / Book Cover Casing -->
          <div class="relative p-2.5 sm:p-3.5 rounded-2xl bg-[#14120E] border border-[#3A3224] shadow-[0_25px_60px_rgba(0,0,0,0.65)]">
            
            <!-- Book Spine Central Gutter Line & Silk Ribbon (Only active on horizontal 2-page spread sm: and above) -->
            <div class="hidden sm:flex absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-8 pointer-events-none z-20 justify-center">
              <!-- Central Trough Shadow -->
              <div class="w-2.5 h-full bg-gradient-to-r from-black/50 via-black/15 to-black/50 opacity-90"></div>
              <!-- Golden Silk Ribbon Bookmark -->
              <div class="absolute -top-1 w-3 h-28 bg-[#B88960] shadow-md rounded-b-sm border-x border-[#734F31]/50">
                <div class="w-full h-full bg-gradient-to-b from-transparent via-white/15 to-black/25"></div>
              </div>
            </div>

            <!-- Two Facing Pages (Open Book Spread Layout - Pure Warm Parchment across all themes) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 rounded-xl overflow-hidden bg-[#F5EFE4] text-[#201C16] border border-[#3A3224]/30 shadow-inner">
              
              <!-- LEFT PAGE: The Classical Painting Plate (Trang Trái: Tranh bảo tàng thu nhỏ) -->
              <div class="p-4 sm:p-5 flex flex-col justify-between border-b sm:border-b-0 sm:border-r border-[#3A3224]/20 relative bg-gradient-to-r from-transparent via-transparent to-black/[0.07]">
                
                <!-- Page Header: Folio & Exhibition Tag -->
                <div class="flex items-center justify-between text-[9px] font-mono tracking-[0.2em] uppercase text-[#6B6457] pb-2 border-b border-[#3A3224]/15">
                  <span>TABULA PICTA</span>
                  <span>PL. {quote.id.replace('TXT-', '')}</span>
                </div>

                <!-- Museum Plate Image Frame -->
                <div class="my-3">
                  <div class="relative aspect-[9/13] w-full overflow-hidden rounded-sm border border-[#3A3224]/35 shadow-inner group">
                    <img
                      src={artSrc}
                      alt={artAlt}
                      class="w-full h-full object-cover filter brightness-[0.95] contrast-[1.02] transition-transform duration-700 group-hover:scale-105"
                      loading="eager"
                      decoding="async"
                    />
                    <!-- Subtle Museum Corner Brackets -->
                    <div class="absolute inset-0 pointer-events-none border border-white/20"></div>
                  </div>

                  <!-- Museum Attribution Placard below artwork -->
                  <div class="pt-2 text-center space-y-0.5">
                    <p class="font-display text-xs text-[#201C16] font-semibold tracking-wide truncate">
                      {artTitle}
                    </p>
                    <p class="font-sans text-[10px] text-[#5E5648] tracking-wider truncate">
                      {artArtist}{artYear ? ` · ${artYear}` : ''}
                    </p>
                    <p class="font-mono text-[9px] text-[#918776] uppercase tracking-widest truncate">
                      {artMuseum}
                    </p>
                  </div>
                </div>

                <!-- Left Page Bottom Index -->
                <div class="pt-2 border-t border-[#3A3224]/15 flex items-center justify-between text-[9px] font-mono text-[#6B6457]">
                  <span>HIYU ARCHIVE</span>
                  <span>#{quote.primaryTopicTitle}</span>
                </div>
              </div>

              <!-- RIGHT PAGE: The Curated Philosophical Inscription (Trang Phải: Văn tự & Trích tuyển) -->
              <div class="p-4 sm:p-5 flex flex-col justify-between relative bg-gradient-to-l from-transparent via-transparent to-black/[0.07]">
                
                <!-- Page Header: Codex Inscription -->
                <div class="flex items-center justify-between text-[9px] font-mono tracking-[0.2em] uppercase text-[#6B6457] pb-2 border-b border-[#3A3224]/15">
                  <span>CODEX ABYSSI</span>
                  <span>FOLIO {quote.id.replace('TXT-', '')}</span>
                </div>

                <!-- Codex Manuscript Body -->
                <div class="py-3 sm:py-4 space-y-3">
                  <span class="inline-block px-2 py-0.5 rounded text-[9px] font-mono tracking-wider uppercase bg-[#E3D9C7]/70 text-[#5E5648] border border-[#3A3224]/15 font-semibold">
                    {quote.quoteTypeLabel}
                  </span>

                  <blockquote class="font-serif italic text-base sm:text-lg lg:text-[1.125rem] leading-relaxed text-[#201C16]">
                    "{quote.content}"
                  </blockquote>

                  <p class="font-sans text-[11px] text-[#5E5648] leading-relaxed line-clamp-3 pt-1">
                    {quote.description || curatorInsight}
                  </p>
                </div>

                <!-- Page Footer: Verified Sign-off & Deep Reading Link -->
                <div class="pt-3 mt-auto border-t border-[#3A3224]/15 flex items-center justify-between text-[11px] font-sans">
                  <div>
                    <strong class="font-display font-bold text-[#201C16] block">{quote.author}</strong>
                    <span class="font-mono text-[9px] text-[#918776] uppercase">{quote.id}</span>
                  </div>

                  <a
                    href={`/library/${quote.slug}`}
                    class="text-[#8E5A3C] hover:text-[#5E3A26] font-semibold text-[11px] uppercase tracking-wider flex items-center gap-1 group/link"
                    title="Đọc toàn bộ chiêm nghiệm và bối cảnh"
                  >
                    <span>Xem bài</span>
                    <span class="transition-transform group-hover/link:translate-x-0.5">→</span>
                  </a>
                </div>

              </div>

            </div>

          </div>

          <!-- Bottom Book Shadow / Desk Surface Cast -->
          <div class="w-11/12 mx-auto h-4 bg-black/40 blur-lg rounded-full -mt-2"></div>
        </div>

      </div>

    </div>
  </div>
</section>
