---
// HeroArtwork.astro - Flagship Sanctuary Hero & Museum Introduction (Taste-Skill / Awwwards Masterpiece)
interface Props {
  quote?: any; // Kept optional for backward compatibility
}

const masterpiece = {
  src: '/images/hero/school_of_athens.jpg',
  title: 'Scuola di Atene (Trường Học Athens)',
  artist: 'Raffaello Sanzio',
  year: '1509–1511',
  medium: 'Bích họa Sơn Dầu Phục Hưng',
  museum: 'Phòng Raffaello, Điện Tông Tòa (Vatican)',
  license: 'Public Domain / CC0',
  alt: 'Kiệt tác bích họa Trường Học Athens của danh họa Raphael',
  curatorNote: 'Nơi những đỉnh cao tư tưởng hội tụ để chất vấn thực tại, phân định ranh giới giữa bản ngã và chân lý — linh hồn và nền tảng của mọi cuộc đối thoại tại Hiyu Abyss.',
};
---

<section class="relative w-full py-12 sm:py-18 md:py-24 overflow-hidden" aria-label="Giới thiệu không gian Hiyu Abyss">
  <!-- Ambient Atmospheric Glows -->
  <div class="absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-accent/5 blur-[140px] pointer-events-none rounded-full"></div>
  <div class="absolute top-1/3 right-1/4 translate-x-1/2 w-[600px] h-[350px] bg-oxide/5 blur-[120px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 2-Column Asymmetric Balance: Left 45% (Brand Manifesto) / Right 55% (Masterpiece Art Installation) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- Left Column: Permanent Brand Identity & Manifesto (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6 order-1">
        
        <!-- Eyebrow Tag Pill -->
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-accent/40 bg-accent/10 text-accent font-mono text-[10px] tracking-[0.2em] uppercase font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            <span data-i18n-vi="KHO LƯU TRỮ SỐNG" data-i18n-en="THE LIVING ARCHIVE">KHO LƯU TRỮ SỐNG</span>
          </span>
          <span class="text-muted/40 font-mono text-xs">/</span>
          <span class="text-xs font-mono tracking-widest uppercase text-muted/80 font-semibold">
            HIYU ABYSS
          </span>
        </div>

        <!-- Monumental Brand Statement (Refined Typographic Hierarchy) -->
        <div class="space-y-3">
          <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.35rem] text-text font-normal leading-[1.08] tracking-tight text-balance">
            Đọc để nhìn <br/>
            <span class="italic font-serif text-accent">thế giới khác đi.</span>
          </h1>
          <p class="font-serif italic text-xl sm:text-2xl text-text/80 leading-snug">
            Suy ngẫm để thấu tỏ chính mình.
          </p>
        </div>

        <!-- Brand Purpose Narrative (Sharp & Philosophical Introduction) -->
        <p class="font-sans text-sm sm:text-base text-muted/90 max-w-xl leading-relaxed">
          Không chỉ là trích dẫn. Hiyu Abyss là không gian bóc trần những nghịch lý bản ngã, soi chiếu bóng tối nội tâm và khơi mở cuộc đối thoại đa chiều cùng những tư tưởng kinh điển.
        </p>

        <!-- Sanctuary Micro-Features Strip (Manifesto Value Pillars) -->
        <div class="p-3.5 sm:p-4 rounded-xl bg-surface/60 border border-border/80 backdrop-blur-sm max-w-xl space-y-2">
          <div class="flex items-start gap-2.5 text-xs font-sans text-text/90">
            <span class="text-accent text-[11px] font-bold mt-0.5 font-mono">01</span>
            <p class="leading-relaxed">
              <strong class="font-medium text-text">Bóc trần nghịch lý:</strong> Giải phẫu các cơ chế phòng vệ và động cơ ẩn giấu sau những lời nói đạo lý bề mặt.
            </p>
          </div>
          <div class="w-full h-px bg-border/40"></div>
          <div class="flex items-start gap-2.5 text-xs font-sans text-text/90">
            <span class="text-accent text-[11px] font-bold mt-0.5 font-mono">02</span>
            <p class="leading-relaxed">
              <strong class="font-medium text-text">Đối thoại cùng mỹ thuật:</strong> Mỗi góc nhìn được hòa quyện cùng kiệt tác hội họa bảo tàng để đánh thức sự tự vấn.
            </p>
          </div>
        </div>

        <!-- Button-in-Button Primary & Secondary CTAs -->
        <div class="flex flex-wrap items-center gap-3.5 pt-1">
          <!-- Primary CTA -->
          <a
            href="/library"
            class="group pl-6 pr-2.5 py-2.5 bg-accent text-on-accent rounded-full font-sans text-xs tracking-wider uppercase font-bold hover:opacity-95 hover:shadow-[0_0_24px_rgba(184,137,96,0.35)] transition-all duration-300 inline-flex items-center gap-3 shadow-lg active:scale-[0.98]"
          >
            <span data-i18n-vi="Khám Phá Thư Viện" data-i18n-en="Explore Library">Khám Phá Thư Viện</span>
            <span class="w-7 h-7 rounded-full bg-black/20 text-white flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5">
              →
            </span>
          </a>

          <!-- Secondary CTA -->
          <a
            href="/mirror"
            class="group pl-5 pr-2.5 py-2.5 border border-border/80 bg-surface/70 text-text hover:border-accent hover:text-accent rounded-full font-sans text-xs tracking-wider uppercase font-semibold transition-all duration-300 inline-flex items-center gap-3 active:scale-[0.98]"
          >
            <span data-i18n-vi="Chiếc Gương (The Mirror)" data-i18n-en="The Mirror">Chiếc Gương (The Mirror)</span>
            <span class="w-7 h-7 rounded-full bg-surface-raised border border-border/60 text-accent flex items-center justify-center text-[10px] transition-transform duration-300 group-hover:rotate-45">
              ◈
            </span>
          </a>

          <!-- Tertiary CTA: The Agora -->
          <a
            href="/agora"
            class="px-3 py-2 text-xs text-muted hover:text-accent font-sans tracking-wider uppercase transition-colors inline-flex items-center gap-1.5"
          >
            <span data-i18n-vi="Đối Thoại (Agora)" data-i18n-en="The Agora">Đối Thoại (Agora)</span>
            <span class="text-accent text-sm">↗</span>
          </a>
        </div>

        <!-- Museum Authority Metrics -->
        <div class="flex items-center gap-4 sm:gap-6 pt-1 text-[11px] font-mono text-muted/70 tracking-widest uppercase">
          <div class="flex items-center gap-1.5">
            <span class="text-accent font-semibold font-sans text-xs">●</span>
            <span>Kho Lưu Trữ Sống</span>
          </div>
          <span class="text-border">·</span>
          <div class="flex items-center gap-1.5">
            <span class="text-accent font-semibold font-sans text-xs">Khắc Kỷ & Hiện Sinh</span>
            <span>Tư Tưởng</span>
          </div>
          <span class="text-border">·</span>
          <div class="flex items-center gap-1.5">
            <span class="text-accent font-semibold font-sans text-xs">Sơn Dầu</span>
            <span>Bảo Tàng</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Grand Masterpiece Fine-Art Installation (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-center justify-center order-2">
        
        <!-- Physical Gallery Frame Container with Floating Shadow -->
        <div class="relative w-full max-w-xl lg:max-w-2xl mx-auto filter drop-shadow-[0_25px_45px_rgba(0,0,0,0.55)]">
          
          <!-- Outer Antique Framing Edge (Dark Wood & Classical Bevel) -->
          <div class="relative p-3 sm:p-4 rounded-2xl bg-[#14120E] border border-[#3A3224] shadow-[0_30px_70px_rgba(0,0,0,0.7)] group">
            
            <!-- Gallery Spotlight Halo Behind Canvas -->
            <div class="absolute inset-0 bg-radial-gradient opacity-20 pointer-events-none rounded-2xl"></div>

            <!-- Inner Canvas Mount & Gilded Slip -->
            <div class="relative rounded-xl overflow-hidden bg-[#0A0907] border border-[#3A3224]/50 shadow-inner">
              
              <!-- Masterpiece Painting Display -->
              <div class="relative aspect-[16/11] sm:aspect-[16/10] w-full overflow-hidden bg-[#12100C]">
                <img
                  src={masterpiece.src}
                  alt={masterpiece.alt}
                  class="w-full h-full object-cover filter brightness-[0.96] contrast-[1.03] transition-transform duration-700 group-hover:scale-[1.02]"
                  loading="eager"
                  decoding="async"
                />

                <!-- Fine Archival Corner Brackets -->
                <div class="absolute inset-0 pointer-events-none border border-white/10 m-2 rounded-sm"></div>

                <!-- Top Monogram Badge -->
                <div class="absolute top-3.5 left-3.5 px-2.5 py-1 rounded bg-black/75 backdrop-blur-md border border-white/15 text-[10px] font-mono text-accent tracking-widest uppercase font-semibold">
                  HIYU ARCHIVE · CENTERPIECE
                </div>

                <div class="absolute top-3.5 right-3.5 px-2 py-0.5 rounded bg-black/60 backdrop-blur-xs text-[9px] font-mono text-muted/90 uppercase tracking-widest border border-white/10">
                  {masterpiece.year}
                </div>
              </div>

              <!-- Curatorial Placard (Exhibition Inscription Attached Below) -->
              <div class="p-4 sm:p-5 bg-[#17140F] border-t border-[#3A3224]/50 text-[#D8D2C6] space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 border-b border-[#3A3224]/30 pb-2.5">
                  <div>
                    <h3 class="font-display text-base sm:text-lg text-[#F5EFE4] font-medium leading-tight">
                      {masterpiece.title}
                    </h3>
                    <span class="text-xs font-serif italic text-accent block mt-0.5">
                      {masterpiece.artist} ({masterpiece.year}) · {masterpiece.medium}
                    </span>
                  </div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-muted/70 flex-shrink-0">
                    {masterpiece.museum}
                  </span>
                </div>

                <!-- Curator Philosophical Reflection -->
                <p class="font-serif italic text-xs sm:text-[13px] text-[#C4BDB0] leading-relaxed">
                  "{masterpiece.curatorNote}"
                </p>

                <!-- Archival Provenance Bar -->
                <div class="flex items-center justify-between text-[10px] font-mono text-muted/60 pt-1 tracking-wider uppercase">
                  <span>{masterpiece.license}</span>
                  <span class="text-accent/80 font-semibold">[ DI SẢN BẢO TỒN · ĐỘC LẬP ]</span>
                </div>
              </div>

            </div>

          </div>

          <!-- Bottom Depth Cast Shadow -->
          <div class="w-11/12 mx-auto h-4 bg-black/50 blur-lg rounded-full -mt-2"></div>
        </div>

      </div>

    </div>
  </div>
</section>
