---
// MuseumLightbox.astro - Fullscreen Contemplative Exhibition Mode (Museum V3.1)
interface Props {
  artSrc: string;
  artAlt: string;
  title: string;
  artist: string;
  year?: string;
  museum: string;
  license?: string;
}

const { artSrc, artAlt, title, artist, year, museum, license = 'Public Domain / CC0' } = Astro.props;
---

<!-- Trigger Button on the Artwork Frame -->
<button
  id="open-lightbox-btn"
  type="button"
  class="group/btn relative w-full aspect-[9/16] overflow-hidden bg-surface border border-border/80 shadow-2xl focus:outline-none focus:ring-2 focus:ring-accent cursor-zoom-in block text-left"
  aria-label="Xem tác phẩm toàn màn hình"
  title="Nhấp để thưởng lãm cận cảnh toàn màn hình"
>
  <img
    src={artSrc}
    alt={artAlt}
    class="w-full h-full object-cover filter brightness-[0.93] transition-transform duration-700 group-hover/btn:scale-[1.025]"
    loading="eager"
    decoding="async"
  />

  <!-- Subtle Museum Inspection Pill Overlay -->
  <div class="absolute bottom-3 right-3 px-3 py-1.5 bg-black/75 backdrop-blur-md border border-white/20 text-white font-sans text-[10px] tracking-widest uppercase flex items-center gap-1.5 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-300">
    <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
    </svg>
    <span>Thưởng Lãm Cận Cảnh</span>
  </div>
</button>

<!-- Fullscreen Lightbox Modal -->
<div
  id="museum-lightbox-modal"
  class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-md flex flex-col items-center justify-between p-4 sm:p-8 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Chế độ thưởng lãm bảo tàng toàn màn hình"
>
  <!-- Top Bar: Title & Close Action -->
  <div class="w-full max-w-5xl flex items-center justify-between text-xs font-sans text-neutral-400 pb-4 border-b border-white/10">
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      <span class="text-white font-medium uppercase tracking-widest font-mono text-[11px]">
        CHẾ ĐỘ THƯỞNG LÃM BẢO TÀNG (EXHIBITION MODE)
      </span>
    </div>
    
    <button
      id="close-lightbox-btn"
      type="button"
      class="px-3 py-1.5 rounded-full border border-white/20 hover:border-accent text-white hover:text-accent font-sans text-xs uppercase tracking-wider transition-colors flex items-center gap-1.5"
    >
      <span>Đóng</span>
      <span class="text-xs">[Esc]</span>
    </button>
  </div>

  <!-- Center Exhibition Area -->
  <div class="flex-1 w-full max-w-4xl flex items-center justify-center p-2 sm:p-4 overflow-hidden">
    <img
      id="lightbox-art-img"
      src={artSrc}
      alt={artAlt}
      class="max-h-[75vh] w-auto max-w-full object-contain shadow-2xl border border-white/10 transition-transform duration-300 hover:scale-[1.01]"
    />
  </div>

  <!-- Bottom Museum Placard Bar -->
  <div class="w-full max-w-xl text-center space-y-1 font-serif text-xs text-neutral-300 pt-2 border-t border-white/10">
    <p class="text-sm sm:text-base text-white font-medium italic">
      {title} {year ? `(${year})` : ''}
    </p>
    <p class="font-sans text-[11px] text-accent tracking-wider uppercase">
      {artist} · <span class="text-neutral-400">{museum}</span> · <span class="text-neutral-500">{license}</span>
    </p>
  </div>
</div>

<script is:inline>
  const openBtn = document.getElementById('open-lightbox-btn');
  const modal = document.getElementById('museum-lightbox-modal');
  const closeBtn = document.getElementById('close-lightbox-btn');

  function openLightbox() {
    if (!modal) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!modal) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.classList.remove('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openLightbox);
  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeLightbox();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && modal.classList.contains('opacity-100')) {
      closeLightbox();
    }
  });
</script>
