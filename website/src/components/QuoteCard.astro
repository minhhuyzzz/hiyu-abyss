---
// QuoteCard.astro - Double-Bezel Museum Plaque Card Architecture
import type { PublicQuote } from '../lib/types';

interface Props {
  quote: PublicQuote;
}

const { quote } = Astro.props;
const artSrc = quote.artInfo?.slides?.slide_1 || `/images/themes/${quote.imageRef}/slide_1_establishing.jpg`;
---

<article
  class="quote-card group p-1 rounded-2xl bg-surface/80 border border-border/80 hover:border-accent/70 transition-all duration-500 hover:shadow-2xl flex flex-col justify-between hover:-translate-y-1"
  data-topic={quote.topicCodes.join(' ')}
>
  <div class="rounded-[calc(1rem-0.125rem)] overflow-hidden bg-bg/90 flex-1 flex flex-col justify-between">
    
    <!-- Card Header Artwork Thumbnail (Square 1:1 Gallery Aspect) -->
    <a href={`/library/${quote.slug}`} class="relative w-full aspect-square overflow-hidden bg-surface block">
      <img
        src={artSrc}
        alt={quote.artInfo?.alt_vi || quote.cleanTitle}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 filter brightness-95 group-hover:brightness-100"
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null; this.src='/images/themes/theme_01/slide_1_establishing.jpg'"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent opacity-70"></div>
      
      <!-- Topic Pill (Micro-Badge) -->
      <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[10px] tracking-wider uppercase font-sans font-medium bg-bg/90 backdrop-blur-md text-accent border border-border/60 shadow-sm">
        #{quote.primaryTopicTitle}
      </span>
    </a>

    <!-- Card Body Content -->
    <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs text-muted font-sans">
          <span class="font-medium text-text/80">{quote.author}</span>
          <span class="text-[10px] uppercase tracking-wider text-muted/70">{quote.quoteTypeLabel}</span>
        </div>

        <h3 class="font-display text-lg sm:text-xl text-text font-medium group-hover:text-accent transition-colors leading-snug">
          <a href={`/library/${quote.slug}`}>
            {quote.cleanTitle}
          </a>
        </h3>
      </div>

      <!-- Card Footer (Clean Horizontal Alignment) -->
      <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs font-sans">
        <span class="text-muted text-[11px] font-mono">
          {quote.id}
        </span>
        <a
          href={`/library/${quote.slug}`}
          class="inline-flex items-center gap-1.5 text-accent hover:underline font-semibold tracking-wider uppercase text-[11px] transition-all group-hover:translate-x-0.5"
        >
          <span>Xem chi tiết</span>
          <span>→</span>
        </a>
      </div>
    </div>

  </div>
</article>
