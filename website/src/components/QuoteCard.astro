---
// QuoteCard.astro
import type { PublicQuote } from '../lib/types';

interface Props {
  quote: PublicQuote;
}

const { quote } = Astro.props;
const artSrc = quote.artInfo?.slides?.slide_1 || `/images/themes/${quote.imageRef}/slide_1_establishing.jpg`;
---

<article
  class="quote-card group flex flex-col justify-between rounded-lg border border-border bg-surface/70 hover:border-accent/80 transition-all duration-300 overflow-hidden hover:shadow-xl"
  data-topic={quote.topicCodes.join(' ')}
>
  <!-- Card Header Artwork Thumbnail -->
  <a href={`/library/${quote.slug}`} class="relative w-full aspect-[16/10] overflow-hidden bg-bg block">
    <img
      src={artSrc}
      alt={quote.artInfo?.alt_vi || quote.cleanTitle}
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
    
    <!-- Topic Pill -->
    <span class="absolute top-3 left-3 px-2.5 py-1 rounded text-[10px] tracking-wider uppercase font-sans font-semibold bg-bg/85 backdrop-blur-md text-accent border border-border/50">
      {quote.primaryTopicTitle}
    </span>
  </a>

  <!-- Card Body Text -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-muted mb-2 font-sans">
        <span>{quote.author}</span>
        <span class="text-[10px] uppercase tracking-wider">{quote.quoteTypeLabel}</span>
      </div>

      <h3 class="font-display text-lg sm:text-xl text-text font-bold mb-3 group-hover:text-accent transition-colors leading-snug">
        <a href={`/library/${quote.slug}`}>
          {quote.cleanTitle}
        </a>
      </h3>

      <p class="font-serif text-sm text-text/80 line-clamp-3 italic leading-relaxed mb-4">
        "{quote.content}"
      </p>
    </div>

    <!-- Card Footer -->
    <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs">
      <span class="text-muted text-[11px] font-sans">
        {quote.id} · {quote.slideFormat}
      </span>
      <a
        href={`/library/${quote.slug}`}
        class="text-accent hover:underline font-semibold font-sans tracking-wider uppercase text-[11px] flex items-center gap-1"
      >
        <span>Đọc tác phẩm</span>
        <span>→</span>
      </a>
    </div>
  </div>
</article>
