---
// SavedDrawer.astro - Contemplative Personal Saved Archive Drawer (Masterplan V3.1)
import { getAllPublishedQuotes } from '../lib/content-publisher';

const allQuotes = getAllPublishedQuotes();
const quotesMap = Object.fromEntries(
  allQuotes.map((q) => [
    q.id,
    {
      id: q.id,
      slug: q.slug,
      title: q.cleanTitle || q.title,
      author: q.author,
      content: q.content,
      primaryTopicTitle: q.primaryTopicTitle,
      imageRef: q.artInfo?.slides?.slide_1 || `/images/themes/${q.imageRef}/slide_1_establishing.jpg`,
    },
  ])
);
---

<!-- Drawer Backdrop Overlay -->
<div
  id="saved-drawer-overlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Drawer Slide-out Panel -->
<aside
  id="saved-drawer"
  class="fixed top-0 right-0 h-full w-full max-w-md bg-surface border-l border-border/80 shadow-2xl z-50 translate-x-full invisible transition-all duration-300 ease-out flex flex-col font-sans"
  aria-labelledby="saved-drawer-title"
  aria-modal="true"
  role="dialog"
>
  <!-- Drawer Header -->
  <div class="px-6 py-5 border-b border-border/70 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-2 h-2 rounded-full bg-accent animate-pulse"></div>
      <h2 id="saved-drawer-title" class="font-display text-lg font-bold text-text uppercase tracking-widest">
        Kho Lưu Trữ Cá Nhân
      </h2>
    </div>
    
    <button
      id="close-saved-drawer-btn"
      type="button"
      class="p-2 text-muted hover:text-text rounded-full hover:bg-surface-raised transition-colors text-sm"
      aria-label="Đóng kho lưu trữ"
    >
      ✕
    </button>
  </div>

  <!-- Drawer Body: List of Saved Works -->
  <div id="saved-items-container" class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
    <!-- Hydrated by client script below -->
  </div>

  <!-- Auth Required State (Shown when guest) -->
  <div id="saved-auth-required" class="hidden flex-1 flex flex-col items-center justify-center p-8 text-center space-y-4">
    <div class="w-12 h-12 rounded-full bg-accent/15 border border-accent/40 flex items-center justify-center text-accent text-xl">
      🔒
    </div>
    <h3 class="font-display text-base font-medium text-text">
      Đăng Nhập Để Dùng Kho Lưu Trữ
    </h3>
    <p class="font-serif italic text-xs text-muted max-w-xs leading-relaxed">
      Kho lưu trữ giúp bạn bảo tồn những câu nói tâm đắc và đồng bộ trên mọi thiết bị. Vui lòng đăng nhập để tiếp tục.
    </p>
    <a
      href="/account?redirect=/saved"
      class="px-5 py-2.5 bg-white hover:bg-neutral-100 text-neutral-900 border border-neutral-300 font-sans text-xs uppercase tracking-wider font-bold rounded-full transition-all flex items-center gap-2 shadow-sm min-h-[40px]"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      <span>Đăng nhập bằng Google</span>
    </a>
  </div>

  <!-- Empty State (Hidden when items exist) -->
  <div id="saved-empty-state" class="hidden flex-1 flex flex-col items-center justify-center p-8 text-center space-y-4">
    <div class="w-12 h-12 rounded-full border border-border/80 flex items-center justify-center text-muted text-xl font-serif">
      ∅
    </div>
    <h3 class="font-display text-base font-medium text-text">
      Chưa có tác phẩm nào được lưu
    </h3>
    <p class="font-serif italic text-xs text-muted max-w-xs leading-relaxed">
      Khi bắt gặp một triết ngôn sâu sắc, hãy bấm nút <strong>"Lưu Chiêm Nghiệm"</strong> để giữ lại trong buồng tĩnh tâm của riêng bạn.
    </p>
    <a
      href="/library"
      class="px-5 py-2.5 border border-border/80 hover:border-accent text-accent font-sans text-xs uppercase tracking-widest transition-colors mt-2"
    >
      Khám Phá Thư Viện
    </a>
  </div>

  <!-- Drawer Footer Actions -->
  <div id="saved-drawer-footer" class="p-5 border-t border-border/70 flex items-center justify-between text-xs text-muted bg-surface/50">
    <span id="saved-footer-count">0 tác phẩm</span>
    <button
      id="clear-all-saved-btn"
      type="button"
      class="hover:text-oxide transition-colors underline font-medium"
    >
      Xóa toàn bộ
    </button>
  </div>
</aside>

<script is:inline define:vars={{ quotesMap }}>
  const overlay = document.getElementById('saved-drawer-overlay');
  const drawer = document.getElementById('saved-drawer');
  const openBtn = document.getElementById('open-saved-drawer-btn');
  const closeBtn = document.getElementById('close-saved-drawer-btn');
  const container = document.getElementById('saved-items-container');
  const emptyState = document.getElementById('saved-empty-state');
  const footerCount = document.getElementById('saved-footer-count');
  const clearAllBtn = document.getElementById('clear-all-saved-btn');

  function openSavedDrawer() {
    renderSavedList();
    drawer.classList.remove('invisible');
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.classList.add('opacity-100', 'pointer-events-auto');
    requestAnimationFrame(() => {
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeSavedDrawer() {
    overlay.classList.add('opacity-0', 'pointer-events-none');
    overlay.classList.remove('opacity-100', 'pointer-events-auto');
    drawer.classList.add('translate-x-full');
    drawer.classList.remove('translate-x-0');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (drawer.classList.contains('translate-x-full')) {
        drawer.classList.add('invisible');
      }
    }, 300);
  }

  function getSavedIds() {
    try {
      return JSON.parse(localStorage.getItem('hiyu_saved_quotes') || '[]');
    } catch (e) {
      return [];
    }
  }

  function removeSavedId(id) {
    try {
      let saved = getSavedIds();
      saved = saved.filter((item) => item !== id);
      localStorage.setItem('hiyu_saved_quotes', JSON.stringify(saved));
      window.dispatchEvent(new Event('hiyu-bookmark-updated'));
      renderSavedList();
    } catch (e) {}
  }

  async function renderSavedList() {
    let user = window.__HIYU_USER;
    if (user === undefined) {
      try {
        const res = await fetch('/api/auth/me');
        const data = await res.json();
        user = data.authenticated ? data.user : null;
        window.__HIYU_USER = user;
      } catch (e) {
        user = null;
      }
    }

    const authRequired = document.getElementById('saved-auth-required');

    if (!user) {
      container.classList.add('hidden');
      emptyState.classList.add('hidden');
      if (authRequired) authRequired.classList.remove('hidden');
      footerCount.textContent = 'Yêu cầu đăng nhập';
      if (clearAllBtn) clearAllBtn.style.display = 'none';
      return;
    }

    if (authRequired) authRequired.classList.add('hidden');

    const savedIds = getSavedIds();
    footerCount.textContent = `${savedIds.length} tác phẩm đã lưu`;

    if (savedIds.length === 0) {
      container.classList.add('hidden');
      emptyState.classList.remove('hidden');
      if (clearAllBtn) clearAllBtn.style.display = 'none';
      return;
    }

    container.classList.remove('hidden');
    emptyState.classList.add('hidden');
    if (clearAllBtn) clearAllBtn.style.display = 'block';

    const html = savedIds
      .map((id) => {
        const item = quotesMap[id];
        if (!item) return '';

        return `
        <article class="p-3.5 border border-border/70 bg-surface-raised/40 hover:border-accent/60 transition-all flex items-start gap-3.5 rounded-sm">
          ${
            item.imageRef
              ? `<div class="w-14 h-18 flex-shrink-0 overflow-hidden bg-surface border border-border/60">
                  <img src="${item.imageRef}" alt="${item.title}" class="w-full h-full object-cover" loading="lazy" />
                 </div>`
              : ''
          }
          <div class="flex-1 min-w-0 space-y-1">
            <div class="flex items-center justify-between text-[10px] text-muted font-sans">
              <span class="text-accent font-mono font-semibold">${item.id}</span>
              <button
                type="button"
                class="remove-item-btn text-muted hover:text-oxide p-1 text-xs"
                data-id="${item.id}"
                title="Gỡ khỏi kho"
              >
                ✕
              </button>
            </div>

            <h3 class="font-display text-xs sm:text-sm text-text font-medium leading-snug line-clamp-2">
              <a href="/library/${item.slug}" class="hover:text-accent transition-colors">
                ${item.title}
              </a>
            </h3>

            <p class="text-[11px] text-muted truncate">
              ${item.author}
            </p>

            <div class="pt-1">
              <a href="/library/${item.slug}" class="text-[10px] uppercase font-semibold tracking-wider text-accent hover:underline inline-flex items-center gap-1">
                <span>Đọc chiêm nghiệm</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>
      `;
      })
      .filter(Boolean)
      .join('');

    container.innerHTML = html;

    // Attach remove listeners
    container.querySelectorAll('.remove-item-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        removeSavedId(id);
      });
    });
  }

  // Event Listeners
  if (openBtn) openBtn.addEventListener('click', openSavedDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeSavedDrawer);
  if (overlay) overlay.addEventListener('click', closeSavedDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('translate-x-0')) {
      closeSavedDrawer();
    }
  });

  if (clearAllBtn) {
    clearAllBtn.addEventListener('click', () => {
      if (confirm('Bạn có chắc chắn muốn xóa toàn bộ tác phẩm trong kho lưu trữ?')) {
        localStorage.setItem('hiyu_saved_quotes', JSON.stringify([]));
        window.dispatchEvent(new Event('hiyu-bookmark-updated'));
        renderSavedList();
      }
    });
  }

  window.addEventListener('hiyu-open-saved-drawer', openSavedDrawer);
</script>
