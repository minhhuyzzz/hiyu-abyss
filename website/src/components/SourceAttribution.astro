---
// SourceAttribution.astro - Provenance & Scholarly Integrity Component (L08 / HYA-02)
import type { PublicQuote } from '../lib/types';

interface Props {
  quote: PublicQuote;
}

const { quote } = Astro.props;
const source = quote.scholarlySource;

// Academic status determination per HYA-02
const isStrictlyVerified = source?.verification_status === 'VERIFIED_SOURCE';
const isPendingVerification = source?.verification_status === 'PENDING_VERIFICATION';

const quoteTypeDetails = {
  DIRECT_QUOTE: {
    label: isStrictlyVerified ? 'Trích dẫn (Bản in đã đối chiếu)' : 'Trích dẫn (Đang đối chiếu ấn bản)',
    badgeClass: isStrictlyVerified ? 'text-accent border-accent/50 bg-accent/10' : 'text-muted border-border/70 bg-surface/40',
    desc: isStrictlyVerified
      ? 'Câu văn được dịch sát nghĩa hoặc trích dẫn trực tiếp từ tác phẩm gốc.'
      : 'Câu nói được ghi nhận từ tác giả trong các tài liệu lưu truyền. Dự án đối chiếu nguồn gốc rõ ràng.',
  },
  PARAPHRASE: {
    label: 'Diễn giải & Biên soạn',
    badgeClass: 'text-text/90 border-border/80 bg-surface/50',
    desc: 'Biên tập lại câu nói theo văn phong tiếng Việt hiện đại, mạch lạc và gần gũi.',
  },
  INSPIRED_ORIGINAL: {
    label: 'Lấy cảm hứng từ ý tưởng',
    badgeClass: 'text-muted border-border/60 bg-surface/30',
    desc: 'Câu nói phát triển từ một suy ngẫm sâu sắc trong cuộc sống. Không mượn danh người khác làm tác giả.',
  },
  INDEPENDENT_ORIGINAL: {
    label: 'Đúc kết Hiyu Abyss',
    badgeClass: 'text-muted border-border/60 bg-surface/30',
    desc: 'Đúc kết độc lập của Hiyu Abyss dựa trên quan sát tâm lý và đời sống thường ngày.',
  },
};

const currentKind = quoteTypeDetails[quote.quoteType] || quoteTypeDetails.INSPIRED_ORIGINAL;

// Artwork provenance classification label
const artworkProvenanceLabels: Record<string, string> = {
  ORIGINAL_MUSEUM_SCAN: 'Bản scan số hóa trực tiếp từ bảo tàng quốc tế',
  TRANSFORMED_PUBLIC_DOMAIN: 'Danh tác cổ điển Public Domain chuẩn hóa tỷ lệ dọc & thớ toan hữu cơ (HYA-08)',
  COMMISSIONED_DERIVATIVE: 'Tác phẩm mỹ thuật phái sinh / sáng tác nội bộ',
  HISTORICAL_DOCUMENT: 'Bản khắc & tư liệu lịch sử cổ xưa',
};

const artworkProvenanceText = quote.artInfo?.provenance_type 
  ? (artworkProvenanceLabels[quote.artInfo.provenance_type] || artworkProvenanceLabels.TRANSFORMED_PUBLIC_DOMAIN)
  : artworkProvenanceLabels.TRANSFORMED_PUBLIC_DOMAIN;
---

<div class="border border-border/80 bg-surface/40 p-6 sm:p-8 space-y-6">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-border/60">
    <div class="flex items-center gap-2.5">
      <span class="w-2 h-2 rounded-full bg-accent"></span>
      <h3 class="font-sans text-xs tracking-[0.2em] uppercase font-bold text-text">
        Minh Bạch Học Thuật & Nguồn Gốc (HYA-02)
      </h3>
    </div>
    <span class="font-mono text-xs text-muted">{quote.id}</span>
  </div>

  <!-- 2-Column Grid: Text Origin & Verification Category -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div class="space-y-1.5">
      <span class="text-[10px] uppercase tracking-[0.2em] font-sans text-muted block">
        Tác Giả / Nguồn Trích Dẫn
      </span>
      <p class="font-display text-lg text-text font-medium">
        {quote.author}
      </p>
      <span class="text-xs font-sans text-muted block">
        Chủ đề: #{quote.primaryTopicTitle}
      </span>
    </div>

    <div class="space-y-1.5">
      <span class="text-[10px] uppercase tracking-[0.2em] font-sans text-muted block">
        Chuẩn Phân Loại Biên Tập
      </span>
      <div class="flex items-center gap-2">
        <span class={`font-sans text-xs font-semibold border px-2.5 py-0.5 ${currentKind.badgeClass}`}>
          {currentKind.label}
        </span>
      </div>
      <p class="font-sans text-xs text-muted leading-relaxed pt-1">
        {currentKind.desc}
      </p>
    </div>
  </div>

  <!-- Scholarly Citation & Source Location Box -->
  {source && (source.work || source.location || source.original_text) && (
    <div class="border-t border-border/50 pt-5 space-y-2.5 font-sans text-xs">
      <span class="text-[10px] uppercase tracking-[0.2em] text-muted block">
        Tài Liệu Khảo Cứu & Đối Chiếu Ấn Bản
      </span>
      
      {source.work && (
        <div class="flex flex-wrap items-baseline gap-2">
          <span class="text-muted">Tác phẩm:</span>
          <strong class="text-text font-serif italic text-sm">{source.work}</strong>
          {source.work_original && <span class="text-muted font-serif">({source.work_original})</span>}
        </div>
      )}

      {source.location && (
        <div class="flex flex-wrap items-baseline gap-2">
          <span class="text-muted">Vị trí trích đoạn:</span>
          <span class="text-text/90 font-mono text-[11px]">{source.location}</span>
        </div>
      )}

      {source.original_text && (
        <div class="pt-1">
          <span class="text-muted block text-[11px] mb-1">Nguyên văn:</span>
          <p class="font-serif italic text-xs text-text/80 pl-3 border-l-2 border-border/80">
            "{source.original_text}"
          </p>
        </div>
      )}

      {source.translation_note && (
        <p class="text-[11px] text-muted/90 italic pt-1">
          * {source.translation_note}
        </p>
      )}

      {source.source_url && (
        <div class="pt-1">
          <a
            href={source.source_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-accent hover:underline text-[11px] font-semibold tracking-wider uppercase"
          >
            <span>Tra cứu ấn bản lưu trữ số</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      )}
    </div>
  )}

  <!-- Museum Artwork Provenance Box -->
  {quote.artInfo && (
    <div class="border-t border-border/50 pt-5 space-y-2">
      <span class="text-[10px] uppercase tracking-[0.2em] font-sans text-muted block">
        Chứng Tích Mỹ Thuật Đồng Hành
      </span>
      <p class="font-serif italic text-sm sm:text-base text-text">
        "{quote.artInfo.title}" — {quote.artInfo.artist} {quote.artInfo.year ? `(${quote.artInfo.year})` : ''}
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted font-sans">
        <span>Bảo tàng lưu giữ: <strong class="text-text font-normal">{quote.artInfo.museum}</strong></span>
        <span class="text-border">·</span>
        <span>Bản quyền: <strong class="text-accent font-normal uppercase text-[11px]">{quote.artInfo.license}</strong></span>
      </div>
      <p class="text-[11px] font-sans text-muted/80 pt-0.5">
        Quy chuẩn mỹ thuật: {artworkProvenanceText}
      </p>
    </div>
  )}

  <!-- Rigorous Scholarly Note -->
  <p class="text-[11px] font-sans text-muted/80 leading-relaxed border-t border-border/40 pt-4">
    * Dự án Hiyu Abyss tuân thủ nguyên tắc không bịa đặt nguồn gốc và không nâng trạng thái kiểm chứng ảo. Mọi ghi chú đều nhằm mục đích giúp độc giả tự tra cứu và phản tư một cách độc lập.
  </p>
</div>

  <!-- Rigorous Scholarly Note -->
  <p class="text-[11px] font-sans text-muted/80 leading-relaxed border-t border-border/40 pt-4">
    * Dự án Hiyu Abyss tuân thủ nguyên tắc không bịa đặt nguồn gốc và không nâng trạng thái kiểm chứng ảo. Mọi ghi chú đều nhằm mục đích giúp độc giả tự tra cứu và phản tư một cách độc lập.
  </p>
</div>
