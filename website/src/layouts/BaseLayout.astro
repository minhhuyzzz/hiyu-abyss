---
// BaseLayout.astro - Nền tảng giao diện chuẩn ấn phẩm mỹ thuật (V3.2 / Taste-Skill)
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SavedDrawer from '../components/SavedDrawer.astro';
import BackToTop from '../components/BackToTop.astro';
import { i18nDict } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = 'Hiyu Abyss — Thư Viện Nghệ Thuật & Triết Học Chiêm Nghiệm',
  description = 'Không gian lưu giữ và khám phá tri thức, triết học tâm lý và mỹ học cổ điển. Nơi đối thoại giữa câu chữ và nghệ phẩm bảo tàng.',
  image = '/images/themes/theme_01/slide_1_establishing.jpg',
  canonicalURL = Astro.url.href,
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const siteTitle = title.includes('Hiyu Abyss') ? title : `${title} · Hiyu Abyss`;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://hiyuabyss.vercel.app';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': siteUrl,
      'name': 'Hiyu Abyss',
      'description': description,
      'inLanguage': 'vi-VN',
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      'name': 'Hiyu Abyss',
      'url': siteUrl,
      'logo': `${siteUrl}/favicon.svg`,
      'sameAs': ['https://www.tiktok.com/@hiyuabyss'],
    },
  ],
};
---

<!doctype html>
<html lang="vi" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content="triết học, tâm lý học đen, mỹ học cổ điển, danh ngôn, triết học hành vi, bảo tàng nghệ thuật, hiyu abyss, dark psychology aphorisms, classical art" />
    <meta name="author" content="Hiyu Abyss" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="vi" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Structured Data JSON-LD Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Zero-FOUC Inline Theme Boot Script -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          const theme = savedTheme === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text selection:bg-oxide selection:text-on-accent antialiased flex flex-col relative">
    <!-- Skip to Content Link (Accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[100] px-4 py-2 rounded bg-accent text-on-accent font-sans text-xs uppercase tracking-widest font-semibold shadow-2xl transition-all"
    >
      Chuyển đến nội dung chính
    </a>

    <!-- Header slot or Default Header -->
    {
      Astro.slots.has('header') ? (
        <slot name="header" />
      ) : (
        !hideHeader && <Header />
      )
    }

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1 w-full focus:outline-none">
      <slot />
    </main>

    <!-- Footer slot or Default Footer -->
    {
      Astro.slots.has('footer') ? (
        <slot name="footer" />
      ) : (
        !hideFooter && <Footer />
      )
    }

    <!-- Personal Saved Archive Drawer -->
    <SavedDrawer />

    <!-- Floating Action Widget (Back to Top) -->
    <BackToTop />

    <!-- Global Full-Site Reactive Bilingual Translation Engine -->
    <script is:inline define:vars={{ i18nDict }}>
      function applySiteLanguage(lang) {
        document.documentElement.setAttribute('lang', lang);
        const dict = i18nDict[lang] || i18nDict['vi'];

        // 1. Elements with explicit data-i18n-vi & data-i18n-en
        document.querySelectorAll('[data-i18n-vi]').forEach((el) => {
          const target = lang === 'en' ? el.getAttribute('data-i18n-en') : el.getAttribute('data-i18n-vi');
          if (target) el.textContent = target;
        });

        // 2. Elements with data-i18n-key
        document.querySelectorAll('[data-i18n-key]').forEach((el) => {
          const key = el.getAttribute('data-i18n-key');
          if (dict[key]) el.textContent = dict[key];
        });

        // 3. Translate search input placeholders
        const searchInput = document.getElementById('search-input');
        if (searchInput) {
          searchInput.placeholder = lang === 'en'
            ? 'Enter keyword (manipulation, ego, truth, freedom, solitude...)'
            : 'Nhập từ khóa (thao túng, bản ngã, sự thật, tự do, cô độc...)';
        }

        // 4. Translate button texts across the DOM
        const copyBtnText = document.getElementById('copy-text');
        if (copyBtnText && !copyBtnText.textContent.includes('✓')) {
          copyBtnText.textContent = dict['btn.copy'] || copyBtnText.textContent;
        }

        const shareBtnSpan = document.querySelector('#share-btn span');
        if (shareBtnSpan) {
          shareBtnSpan.textContent = dict['btn.share'] || shareBtnSpan.textContent;
        }

        const viewArtSpan = document.querySelector('#open-lightbox-btn span');
        if (viewArtSpan) {
          viewArtSpan.textContent = dict['btn.viewArt'] || viewArtSpan.textContent;
        }
      }

      // Initialize on load
      const initLang = localStorage.getItem('hiyu_lang') || 'vi';
      applySiteLanguage(initLang);

      // Listen for language switch events from header or anywhere
      window.addEventListener('hiyu-lang-changed', (e) => {
        applySiteLanguage(e.detail.lang);
      });
    </script>
  </body>
</html>
