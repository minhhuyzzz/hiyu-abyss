---
// BaseLayout.astro - Nền tảng giao diện chuẩn ấn phẩm mỹ thuật (V3.1)
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SavedDrawer from '../components/SavedDrawer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = 'Hiyu Abyss — Thư Viện Nghệ Thuật & Triết Học Chiêm Nghiệm',
  description = 'Không gian lưu giữ và khám phá tri thức, triết học tâm lý và mỹ học cổ điển. Nơi đối thoại giữa câu chữ và nghệ phẩm bảo tàng.',
  image = '/images/themes/theme_01/slide_1_establishing.jpg',
  canonicalURL = Astro.url.href,
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const siteTitle = title.includes('Hiyu Abyss') ? title : `${title} · Hiyu Abyss`;
const siteUrl = Astro.site ? Astro.site.toString() : 'https://hiyuabyss.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      'url': siteUrl,
      'name': 'Hiyu Abyss',
      'description': description,
      'inLanguage': ['vi', 'en'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      'name': 'Hiyu Abyss',
      'url': siteUrl,
      'logo': `${siteUrl}/favicon.svg`,
      'sameAs': ['https://www.tiktok.com/@hiyuabyss'],
    },
  ],
};
---

<!doctype html>
<html lang="vi" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content="triết học, tâm lý học đen, mỹ học cổ điển, danh ngôn, triết học hành vi, bảo tàng nghệ thuật, hiyu abyss, dark psychology aphorisms, classical art" />
    <meta name="author" content="Hiyu Abyss" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="vi" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Structured Data JSON-LD Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Zero-FOUC Inline Theme Boot Script -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          const theme = savedTheme === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text selection:bg-oxide selection:text-on-accent antialiased flex flex-col relative">
    <!-- Skip to Content Link (Accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[100] px-4 py-2 rounded bg-accent text-on-accent font-sans text-xs uppercase tracking-widest font-semibold shadow-2xl transition-all"
    >
      Chuyển đến nội dung chính
    </a>

    <!-- Header slot or Default Header -->
    {
      Astro.slots.has('header') ? (
        <slot name="header" />
      ) : (
        !hideHeader && <Header />
      )
    }

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1 w-full focus:outline-none">
      <slot />
    </main>

    <!-- Footer slot or Default Footer -->
    {
      Astro.slots.has('footer') ? (
        <slot name="footer" />
      ) : (
        !hideFooter && <Footer />
      )
    }

    <!-- Personal Saved Archive Drawer -->
    <SavedDrawer />

    <!-- Floating Action Widget (Back to Top) -->
    <BackToTop />
  </body>
</html>
