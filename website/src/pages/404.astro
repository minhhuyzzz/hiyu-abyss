---
// src/pages/404.astro - Branded 404 Philosophical Page Not Found (Museum Editorial)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Khoảng Trống Vô Định | Hiyu Abyss"
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã chìm sâu vào bóng tối của thời gian."
>
  <div class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-16 sm:py-24">
    <div class="max-w-xl mx-auto w-full border border-border/80 bg-surface/40 p-8 sm:p-14 text-center space-y-6">
      
      <div class="flex items-center justify-center gap-2 text-xs tracking-[0.25em] uppercase font-sans text-muted">
        <span class="text-oxide font-semibold">404 ERROR</span>
        <span class="text-muted/30">/</span>
        <span>LẠC LỐI</span>
      </div>

      <h1 class="font-display text-4xl sm:text-6xl text-text font-medium tracking-tight">
        Khoảng Trống Vô Định
      </h1>

      <blockquote class="font-serif italic text-base sm:text-lg text-muted leading-relaxed">
        "Không phải mọi lối đi đều dẫn tới câu trả lời. Nhưng việc thừa nhận mình đang lạc lối luôn là bước khởi đầu của sự nhận thức."
      </blockquote>

      <p class="font-sans text-xs sm:text-sm text-muted/80 leading-relaxed max-w-md mx-auto">
        Tọa độ bạn đang tìm kiếm không tồn tại, đã đổi vị trí, hoặc đã chìm sâu vào bóng tối của thời gian.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4 font-sans text-xs uppercase tracking-widest font-semibold">
        <a
          href="/"
          class="w-full sm:w-auto px-6 py-3 border border-border/80 bg-surface text-muted hover:text-text hover:border-accent transition-colors"
        >
          ← Về Trang Chủ
        </a>
        <a
          href="/library"
          class="w-full sm:w-auto px-8 py-3 bg-accent text-on-accent font-bold hover:opacity-90 transition-opacity"
        >
          Vào Thư Viện →
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
