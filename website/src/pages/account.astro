---
// src/pages/account.astro - Account & Authentication Hub
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tài Khoản & Phiên Đăng Nhập — The Agora | Hiyu Abyss"
  description="Quản lý tài khoản và phiên đăng nhập của bạn trên Hiyu Abyss."
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-xl mx-auto space-y-8">
    
    <header class="space-y-2 text-center pb-6 border-b border-border/70">
      <div class="flex items-center justify-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-accent font-semibold">
        <span>HIYU ABYSS · TÀI KHOẢN</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl font-medium text-text">
        Cổng Xác Thực
      </h1>
      <p class="font-sans text-xs sm:text-sm text-muted leading-relaxed">
        Đăng nhập để tham gia đối thoại, gửi bình luận và đồng bộ các câu nói yêu thích của bạn qua các thiết bị.
      </p>
    </header>

    <div class="p-6 sm:p-8 bg-surface/30 border border-border/70 rounded-sm space-y-6 shadow-xl">
      
      {/* Current Session Mock / Active Card */}
      <div class="flex items-center gap-4 p-4 bg-surface/60 border border-border/50 rounded-sm">
        <span class="w-12 h-12 rounded-full bg-accent/20 border border-accent/40 text-accent font-semibold flex items-center justify-center font-mono text-base uppercase">
          H
        </span>
        <div class="space-y-0.5">
          <span class="text-sm font-medium text-text block">Độc Giả Hiyu Abyss</span>
          <span class="text-xs text-muted font-mono block">@nguoi_dong_hanh</span>
          <span class="text-[11px] text-accent font-mono">Phiên khách chủ động (Guest/Demo)</span>
        </div>
      </div>

      {/* Google OAuth Button */}
      <div class="space-y-3 pt-2">
        <button
          type="button"
          onclick="alert('Chức năng Google OAuth sẽ kết nối với client_id được cấp quyền trong production.')"
          class="w-full py-3.5 px-4 bg-white hover:bg-neutral-100 text-neutral-900 border border-neutral-300 font-sans text-xs uppercase tracking-wider font-semibold rounded-sm transition-all flex items-center justify-center gap-3 shadow-sm min-h-[48px]"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Tiếp tục bằng tài khoản Google</span>
        </button>

        <p class="text-[11px] text-center text-muted font-sans leading-relaxed">
          🔒 Quyền riêng tư: Xác thực Google chỉ dùng để định danh tài khoản, không tiết lộ email hay thông tin cá nhân lên diễn đàn.
        </p>
      </div>

      <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs font-sans">
        <a href="/agora" class="text-accent hover:underline">← Về lại The Agora</a>
        <a href="/saved" class="text-muted hover:text-text">Kho lưu trữ đã lưu →</a>
      </div>

    </div>

  </div>
</BaseLayout>
