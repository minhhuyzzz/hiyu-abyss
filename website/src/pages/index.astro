---
// src/pages/index.astro - Art-Directed Home Page
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import EditorialMosaic from '../components/EditorialMosaic.astro';
import { getAllPublishedQuotes, getFeaturedQuotes, getAllTopics } from '../lib/content-publisher';

const allQuotes = getAllPublishedQuotes();
const featuredQuotes = getFeaturedQuotes();
const topics = getAllTopics();
const primaryHero = featuredQuotes[0] || allQuotes[0];
---

<BaseLayout
  title="Hiyu Abyss — Thư Viện Nghệ Thuật & Triết Học Chiêm Nghiệm"
  description="Thư viện giám tuyển 100 tác phẩm triết học, tâm lý học hành vi và kiệt tác hội họa bảo tàng cổ điển."
>
  <!-- Hero Section with Chiaroscuro Lighting -->
  {primaryHero && <HeroArtwork quote={primaryHero} />}

  <!-- Editorial Mosaic Section with Asymmetric Bento -->
  <EditorialMosaic featuredQuotes={featuredQuotes} topics={topics} />

  <!-- Philosophical Manifesto Section (Double-Bezel Hardware Architecture) -->
  <section class="py-20 sm:py-28 md:py-36 border-b border-border/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="p-1.5 rounded-[2rem] bg-surface/60 border border-border/80 shadow-2xl">
        <div class="rounded-[calc(2rem-0.375rem)] bg-bg/95 p-8 sm:p-14 text-center flex flex-col items-center gap-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-accent/30 bg-accent/10 text-[10px] font-sans tracking-[0.2em] uppercase font-medium text-accent">
            Tuyên Ngôn Hiyu Abyss
          </div>
          <h2 class="font-display text-2xl sm:text-4xl md:text-5xl text-text font-medium leading-tight text-balance">
            "Con người không đau khổ vì sự việc, mà vì góc nhìn của họ về sự việc."
          </h2>
          <p class="font-serif text-base sm:text-xl text-muted max-w-2xl leading-relaxed italic">
            Chúng tôi không xây dựng một blog châm ngôn đại trà. Hiyu Abyss là nơi lưu giữ những tư tưởng sắc bén được đối chứng với các kiệt tác hội họa qua hàng thế kỷ, để mỗi lần ghé thăm là một lần độc giả bước qua ranh giới của sự tự lừa dối.
          </p>
          <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
            <a
              href="/library"
              class="group inline-flex items-center gap-3 pl-7 pr-2.5 py-2.5 rounded-full bg-accent text-on-accent font-sans text-xs tracking-[0.15em] uppercase font-bold hover:opacity-95 transition-all shadow-xl active:scale-[0.98] min-h-[48px]"
            >
              <span>Khám Phá Toàn Bộ Thư Viện</span>
              <span class="w-8 h-8 rounded-full bg-on-accent/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1">
                →
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
