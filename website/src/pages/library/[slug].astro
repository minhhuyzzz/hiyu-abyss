---
// src/pages/library/[slug].astro - Classical Aphorism Reader with Museum Artwork & Provenance
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceAttribution from '../../components/SourceAttribution.astro';
import { getAllPublishedQuotes } from '../../lib/content-publisher';
import type { PublicQuote } from '../../lib/types';

export function getStaticPaths() {
  const quotes = getAllPublishedQuotes();
  return quotes.map((q, index) => {
    const prev = index > 0 ? quotes[index - 1] : quotes[quotes.length - 1];
    const next = index < quotes.length - 1 ? quotes[index + 1] : quotes[0];
    return {
      params: { slug: q.slug },
      props: { quote: q, prevQuote: prev, nextQuote: next },
    };
  });
}

interface Props {
  quote: PublicQuote;
  prevQuote: PublicQuote;
  nextQuote: PublicQuote;
}

const { quote, prevQuote, nextQuote } = Astro.props;
const artSrc = quote.artInfo?.slides?.slide_1 || `/images/themes/${quote.imageRef}/slide_1_establishing.jpg`;
---

<BaseLayout
  title={`${quote.cleanTitle} · ${quote.author}`}
  description={quote.content}
  image={artSrc}
>
  <article class="py-12 sm:py-20 md:py-28">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Breadcrumb Navigation Bar -->
      <nav class="flex items-center justify-between text-xs font-sans text-muted pb-4 border-b border-border/60">
        <div class="flex items-center gap-2">
          <a href="/" class="hover:text-text transition-colors">Trang Chủ</a>
          <span>/</span>
          <a href="/library" class="hover:text-text transition-colors">Thư Viện</a>
          <span>/</span>
          <a href={`/themes/${quote.primaryTopic.toLowerCase().replace(/_/g, '-')}`} class="text-accent hover:underline">
            #{quote.primaryTopicTitle}
          </a>
        </div>
        <span class="font-mono text-xs text-accent font-semibold">{quote.id}</span>
      </nav>

      <!-- Main Visual & Inscription Section -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <!-- Left: Core Aphorism & Actions -->
        <div class="lg:col-span-7 flex flex-col gap-8 order-2 lg:order-1">
          <div class="space-y-4">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="px-3.5 py-1 rounded-full text-[10px] font-sans font-medium tracking-[0.2em] uppercase bg-accent/15 text-accent border border-accent/30">
                #{quote.primaryTopicTitle}
              </span>
              <span class="px-3.5 py-1 rounded-full text-[10px] font-sans tracking-[0.2em] uppercase bg-surface text-muted border border-border/80">
                {quote.quoteTypeLabel}
              </span>
            </div>

            <h1 class="font-display text-3xl sm:text-5xl text-text font-medium leading-tight">
              {quote.cleanTitle}
            </h1>
            <p class="text-xs font-sans text-muted">
              Tác giả luận đề: <strong class="text-text font-medium">{quote.author}</strong>
            </p>
          </div>

          <!-- Master Blockquote -->
          <blockquote class="font-serif text-2xl sm:text-3xl text-text leading-relaxed sm:leading-loose italic border-l-2 border-accent pl-6 py-2 bg-surface/30 rounded-r-xl shadow-inner">
            "{quote.content}"
          </blockquote>

          <!-- Action Toolbar (Button-in-Button Architecture) -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <button
              id="copy-quote-btn"
              type="button"
              class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-full border border-border/80 bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs tracking-wider uppercase font-semibold transition-all shadow-sm active:scale-[0.98] min-h-[48px]"
            >
              <svg class="w-4 h-4 text-accent transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke-width="1.75" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke-width="1.75" />
              </svg>
              <span>Sao Chép Triết Ngôn</span>
            </button>

            <button
              id="share-btn"
              type="button"
              class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-full border border-border/80 bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs tracking-wider uppercase font-semibold transition-all shadow-sm active:scale-[0.98] min-h-[48px]"
            >
              <svg class="w-4 h-4 text-accent transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="18" cy="5" r="3" stroke-width="1.75" />
                <circle cx="6" cy="12" r="3" stroke-width="1.75" />
                <circle cx="18" cy="19" r="3" stroke-width="1.75" />
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" stroke-width="1.75" />
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" stroke-width="1.75" />
              </svg>
              <span>Chia Sẻ</span>
            </button>
          </div>

          <!-- Deep Commentary -->
          <div class="pt-6 border-t border-border/60 space-y-4">
            <h2 class="font-display text-base tracking-[0.15em] uppercase font-semibold text-accent">
              Chiêm Nghiệm & Bóc Tách Tâm Lý
            </h2>
            <div class="font-serif text-base sm:text-lg text-text/90 leading-relaxed sm:leading-loose">
              <p>{quote.description}</p>
            </div>
          </div>
        </div>

        <!-- Right: Museum Artwork Presentation (Double-Bezel Architecture) -->
        <div class="lg:col-span-5 order-1 lg:order-2 flex flex-col gap-4">
          <div class="p-1.5 rounded-[2rem] bg-surface/70 border border-border/80 shadow-2xl">
            <div class="relative w-full aspect-[9/16] rounded-[calc(2rem-0.375rem)] overflow-hidden bg-bg shadow-inner">
              <img
                id="main-artwork-img"
                src={artSrc}
                alt={quote.artInfo?.alt_vi || quote.cleanTitle}
                class="w-full h-full object-cover filter brightness-95"
                loading="eager"
              />
              {quote.artInfo && (
                <div class="absolute bottom-3 left-3 right-3 p-3.5 rounded-xl bg-bg/85 backdrop-blur-md border border-border/60 text-xs shadow-md">
                  <p class="font-serif italic text-text font-medium truncate">
                    "{quote.artInfo.title}"
                  </p>
                  <p class="text-[11px] text-muted truncate mt-0.5 font-sans">
                    {quote.artInfo.artist} ({quote.artInfo.year}) · {quote.artInfo.museum}
                  </p>
                </div>
              )}
            </div>
          </div>
        </div>

      </div>

      <!-- Scholarly Source & Provenance Box -->
      <SourceAttribution quote={quote} />

      <!-- Prev / Next Navigation Plaques -->
      <nav class="pt-10 border-t border-border/60 grid grid-cols-1 sm:grid-cols-2 gap-4 font-sans text-xs">
        <a
          href={`/library/${prevQuote.slug}`}
          class="group p-4 rounded-2xl border border-border/80 hover:border-accent bg-surface/40 hover:bg-surface transition-all flex items-center gap-4"
        >
          <span class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-muted group-hover:border-accent group-hover:text-accent transition-colors flex-shrink-0">
            ←
          </span>
          <div class="overflow-hidden">
            <span class="text-muted text-[10px] uppercase tracking-wider block">Tác phẩm trước</span>
            <span class="text-text font-medium truncate block group-hover:text-accent transition-colors font-serif text-sm">
              {prevQuote.cleanTitle}
            </span>
          </div>
        </a>

        <a
          href={`/library/${nextQuote.slug}`}
          class="group p-4 rounded-2xl border border-border/80 hover:border-accent bg-surface/40 hover:bg-surface transition-all flex items-center justify-end text-right gap-4"
        >
          <div class="overflow-hidden">
            <span class="text-muted text-[10px] uppercase tracking-wider block">Tác phẩm tiếp theo</span>
            <span class="text-text font-medium truncate block group-hover:text-accent transition-colors font-serif text-sm">
              {nextQuote.cleanTitle}
            </span>
          </div>
          <span class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-muted group-hover:border-accent group-hover:text-accent transition-colors flex-shrink-0">
            →
          </span>
        </a>
      </nav>

    </div>
  </article>

  <!-- Toast Notification -->
  <div
    id="toast"
    class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-full bg-surface border border-accent text-text text-xs font-sans shadow-2xl transition-all duration-300 transform translate-y-8 opacity-0 pointer-events-none flex items-center gap-2"
  >
    <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
    <span>Đã sao chép triết ngôn vào bộ nhớ tạm!</span>
  </div>
</BaseLayout>

<script is:inline define:vars={{ quoteText: quote.content, quoteTitle: quote.cleanTitle, quoteUrl: Astro.url.href }}>
  // Copy quote to clipboard
  const copyBtn = document.getElementById('copy-quote-btn');
  const toast = document.getElementById('toast');

  function showToast(msg) {
    if (toast) {
      if (msg) toast.querySelector('span:last-child').textContent = msg;
      toast.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
      }, 3000);
    }
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(`"${quoteText}"\n— ${quoteTitle}`);
        showToast('Đã sao chép triết ngôn vào bộ nhớ tạm!');
      } catch (err) {
        showToast('Không thể sao chép tự động.');
      }
    });
  }

  // Web Share API
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: quoteTitle,
            text: `"${quoteText}" — Hiyu Abyss`,
            url: quoteUrl,
          });
        } catch (err) {
          // User cancelled
        }
      } else {
        try {
          await navigator.clipboard.writeText(quoteUrl);
          showToast('Đã sao chép liên kết vào bộ nhớ tạm!');
        } catch (e) {
          showToast('Không thể sao chép liên kết.');
        }
      }
    });
  }
</script>
