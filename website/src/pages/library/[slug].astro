---
// src/pages/library/[slug].astro - Classical Aphorism Exhibition & Deep Reading (V3.1)
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceAttribution from '../../components/SourceAttribution.astro';
import ArtworkPlacard from '../../components/ArtworkPlacard.astro';
import MuseumLightbox from '../../components/MuseumLightbox.astro';
import LibraryComments from '../../components/library/LibraryComments';
import { getAllPublishedQuotes } from '../../lib/content-publisher';
import type { PublicQuote } from '../../lib/types';

export function getStaticPaths() {
  const quotes = getAllPublishedQuotes();
  return quotes.map((q, index) => {
    const prev = index > 0 ? quotes[index - 1] : quotes[quotes.length - 1];
    const next = index < quotes.length - 1 ? quotes[index + 1] : quotes[0];
    return {
      params: { slug: q.slug },
      props: { quote: q, prevQuote: prev, nextQuote: next },
    };
  });
}

interface Props {
  quote: PublicQuote;
  prevQuote: PublicQuote;
  nextQuote: PublicQuote;
}

const { quote, prevQuote, nextQuote } = Astro.props;
const allQuotes = getAllPublishedQuotes();
let relatedQuotes = allQuotes.filter((q) => q.id !== quote.id && q.primaryTopic === quote.primaryTopic).slice(0, 3);
if (relatedQuotes.length < 3) {
  const otherQuotes = allQuotes.filter((q) => q.id !== quote.id && !relatedQuotes.some((r) => r.id === q.id));
  relatedQuotes.push(...otherQuotes.slice(0, 3 - relatedQuotes.length));
}

const artSrc = quote.artInfo?.slides?.slide_1 || `/images/themes/${quote.imageRef}/slide_1_establishing.jpg`;
const artTitle = quote.artInfo?.title || quote.cleanTitle;
const artArtist = quote.artInfo?.artist || quote.author;
const artYear = quote.artInfo?.year;
const artMuseum = quote.artInfo?.museum || 'Bộ sưu tập bảo tàng';
const artLicense = quote.artInfo?.license || 'Public Domain / CC0';
const artAlt = quote.artInfo?.alt_vi || `${artTitle} - ${artArtist}`;

// Tailored Philosophical Counterpoints per Topic (Eliminates universal repetition)
const TOPIC_COUNTERPOINTS: Record<string, string> = {
  HYPOCRISY: 'Khi ta say sưa chỉ trích sự giả tạo của người khác, chiếc bẫy tinh vi nhất là ta bắt đầu tự mãn rằng mình là hiện thân của sự chân thật tuyệt đối.',
  DOUBLE_STANDARD: 'Thước đo đạo đức công bằng nhất không phải là khi ta phán xét người khác, mà là khi ta dám áp dụng cùng một tiêu chuẩn khắt khe ấy lên chính bản thân mình.',
  MORALITY: 'Lòng tốt sẽ lập tức biến thành gánh nặng tâm lý ngay khoảnh khắc người ban phát bắt đầu ghi sổ nợ ân tình và đòi hỏi sự phục tùng ngầm.',
  EGO: 'Nhu cầu luôn phải chứng minh mình đúng thực chất là tiếng kêu cứu của một cái tôi mỏng manh, luôn run rẩy trước nỗi sợ bị chối bỏ.',
  SELF_DECEPTION: 'Lời nói dối êm ái nhất chính là lời nói dối ta tự kể cho mình nghe mỗi ngày để trốn chạy thực tại.',
  SHADOW: 'Phần tối trong bạn không bao giờ biến mất khi bị đè nén; nó chỉ âm thầm gián tiếp điều khiển cảm xúc và hành động của bạn.',
  MASK: 'Chiếc mặt nạ đeo quá lâu sẽ làm ta mệt mỏi, đến mức một ngày ta không còn nhận ra đâu là con người nguyên bản của chính mình.',
  POWER: 'Kẻ thèm khát kiểm soát người khác thường là kẻ bất lực và hỗn loạn nhất trong việc làm chủ thế giới nội tâm của bản thân.',
  MANIPULATION: 'Kẻ thao túng nguy hiểm nhất không bao giờ quát tháo; họ khiến bạn tự nguyện cảm thấy có lỗi ngay cả khi bạn là người chịu tổn thương.',
  FREEDOM: 'Tự do đích thực không phải là muốn làm gì thì làm, mà là dũng khí dám gánh vác trọn vẹn trách nhiệm cho mọi lựa chọn của cuộc đời mình.',
  TRUTH: 'Sự thật có thể làm ta nhói lòng trong chốc lát, nhưng lời dối trá êm tai sẽ khiến ta lạc lối suốt cả một chặng đường dài.',
  LOVE: 'Ranh giới giữa tình yêu chân thành và sự chiếm hữu ích kỷ nằm ở chỗ: Bạn tôn trọng sự tự do của đối phương, hay yêu cảm giác được sở hữu họ?',
  LOYALTY: 'Lòng trung thành không đi kèm sự tỉnh táo chỉ là sự hy sinh mù quáng cho sự lợi dụng của người khác.',
  ENVY: 'Sự đố kỵ là chiếc độc dược ta uống vào nhưng lại mong người khác tổn thương. Nó phản ánh nỗi bất an sâu kín nhất trong lòng mình.',
  CROWD: 'Khi hòa tan vào đám đông ồn ào, con người dễ dàng đánh mất chính kiến cá nhân để đi theo những trào lưu nhất thời.',
  SUFFERING: 'Nghịch cảnh chỉ có giá trị khi nó giúp ta thêm mạnh mẽ và thấu hiểu, chứ không phải trở thành lý do để ta mãi đóng vai nạn nhân.',
  IDENTITY: 'Bản sắc chân thật nhất của bạn được bộc lộ trong khoảnh khắc bạn ở một mình và hoàn toàn không phải diễn cho ai xem.',
  MEANING: 'Ý nghĩa cuộc sống không phải thứ có sẵn ở đích đến; nó là những giá trị bạn tự tay xây đắp qua từng trải nghiệm mỗi ngày.',
  SOLITUDE: 'Kẻ không chịu nổi sự một mình thực chất là người sợ hãi việc phải đối diện với sự trống trải bên trong lòng mình.',
  STATUS: 'Khiêm nhường thực sự là không bận tâm đến việc phải chứng tỏ cái tôi, chứ không phải một màn trình diễn khiêm tốn giả tạo để mong cầu lời khen.',
};

const counterpointText =
  TOPIC_COUNTERPOINTS[quote.primaryTopic] ||
  'Mọi câu nói hay đều có thể biến thành chiếc bẫy tự lừa dối nếu ta chỉ dùng nó để phán xét người khác mà không dám đặt chính mình vào vị trí tự soi rọi.';

// Determine whether title and quote are redundant echoes
const normTitle = quote.cleanTitle.toLowerCase().replace(/[^a-z0-9]/g, '');
const normContent = quote.content.toLowerCase().replace(/[^a-z0-9]/g, '');
const isEcho = normTitle.includes(normContent.slice(0, 20)) || normContent.includes(normTitle.slice(0, 20));
---

<BaseLayout
  title={`${quote.cleanTitle} · ${quote.author}`}
  description={quote.content}
  image={artSrc}
>
  <article class="py-10 sm:py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- 01. Breadcrumb & Meta Bar -->
      <nav class="flex flex-wrap items-center justify-between gap-3 text-xs font-sans text-muted pb-2">
        <div class="flex items-center gap-2">
          <a href="/" class="hover:text-text transition-colors">Trang Chủ</a>
          <span>/</span>
          <a href="/library" class="hover:text-text transition-colors">Thư Viện</a>
          <span>/</span>
          <a href={`/themes/${quote.primaryTopic.toLowerCase().replace(/_/g, '-')}`} class="text-accent hover:underline font-medium">
            #{quote.primaryTopicTitle}
          </a>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[11px] text-muted">Khoảng 2 phút đọc</span>
          <span class="text-border">·</span>
          <span class="font-mono text-xs text-accent font-semibold">{quote.id}</span>
        </div>
      </nav>

      <!-- 02. Split Editorial Presentation (Chữ & Tranh) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <!-- Left Column: Master Typography & Thought (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-7 order-2 lg:order-1">
          
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-2.5 text-xs font-sans">
              <span class="text-accent font-semibold tracking-widest uppercase text-[11px] font-mono">
                #{quote.primaryTopicTitle}
              </span>
              <span class="text-border">·</span>
              <span class="text-muted tracking-wider uppercase text-[10px]">
                {quote.quoteTypeLabel}
              </span>
            </div>

            <!-- Master Title -->
            <h1 class="font-display text-2xl sm:text-4xl text-text font-medium leading-[1.2] tracking-tight text-balance">
              {quote.cleanTitle}
            </h1>
            
            <p class="font-sans text-xs text-muted">
              Tác giả: <strong class="text-text font-medium">{quote.author}</strong>
            </p>
          </div>

          <!-- Master Inscription Block -->
          <div class="border-l-2 border-accent pl-5 py-1.5">
            <blockquote class="font-serif text-xl sm:text-2xl text-text leading-relaxed sm:leading-loose italic">
              "{quote.content}"
            </blockquote>
          </div>

          <!-- Action Toolbar: Copy / Save (with Drawer sync) / Share -->
          <div class="flex flex-wrap items-center gap-2.5 pt-1">
            <!-- Copy button -->
            <button
              id="copy-quote-btn"
              type="button"
              class="px-4 py-2 rounded-full border border-border/80 bg-surface/80 hover:bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs tracking-wider uppercase font-semibold transition-all duration-200 flex items-center gap-2 min-h-[38px] shadow-xs active:scale-95"
            >
              <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="9" y="9" width="13" height="13" rx="1" stroke-width="1.75" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke-width="1.75" />
              </svg>
              <span id="copy-text">Sao Chép Câu Nói</span>
            </button>

            <!-- Save Bookmark button (Dispatches live update to Saved Drawer & Header) -->
            <button
              id="bookmark-btn"
              type="button"
              data-id={quote.id}
              class="px-4 py-2 rounded-full border border-border/80 bg-surface/80 hover:bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs tracking-wider uppercase font-semibold transition-all duration-200 flex items-center gap-2 min-h-[38px] shadow-xs active:scale-95"
            >
              <span id="bookmark-icon">☆</span>
              <span id="bookmark-text">Lưu Vào Kho</span>
            </button>

            <!-- Share button -->
            <button
              id="share-btn"
              type="button"
              class="px-4 py-2 rounded-full border border-border/80 bg-surface/80 hover:bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs tracking-wider uppercase font-semibold transition-all duration-200 flex items-center gap-2 min-h-[38px] shadow-xs active:scale-95"
            >
              <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="18" cy="5" r="3" stroke-width="1.75" />
                <circle cx="6" cy="12" r="3" stroke-width="1.75" />
                <circle cx="18" cy="19" r="3" stroke-width="1.75" />
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" stroke-width="1.75" />
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" stroke-width="1.75" />
              </svg>
              <span>Chia Sẻ</span>
            </button>

            <!-- The Atlas Bridge -->
            <a
              href={`/atlas?focus=quote-${quote.id.toLowerCase()}`}
              class="px-4 py-2 rounded-full border border-accent/40 bg-accent/10 hover:bg-accent/20 text-accent font-sans text-xs tracking-wider uppercase font-semibold transition-all duration-200 flex items-center gap-2 min-h-[38px] shadow-xs"
              title="Khám phá vị trí tác phẩm trên The Atlas"
            >
              <span>✦</span>
              <span>Xem Trên The Atlas</span>
            </a>
          </div>

          <!-- 04. Context & Commentary -->
          <div class="pt-6 space-y-3">
            <span class="text-xs font-sans tracking-[0.2em] uppercase font-semibold text-accent block">
              Góc Nhìn & Suy Ngẫm
            </span>
            <div class="font-serif text-base sm:text-lg text-text/90 leading-relaxed sm:leading-loose space-y-4">
              <p>{quote.description}</p>
            </div>
          </div>

          <!-- 05. Dialectical Counterpoint (Tailored per topic - No repetition!) -->
          <div class="p-5 bg-surface/50 border-l-2 border-oxide space-y-2">
            <span class="text-[11px] font-sans tracking-[0.2em] uppercase font-semibold text-oxide block">
              Một Góc Nhìn Khác
            </span>
            <p class="font-serif italic text-sm sm:text-base text-text/85 leading-relaxed">
              {counterpointText}
            </p>
          </div>

        </div>

        <!-- Right Column: Museum Artwork Frame & Provenance (With Fullscreen Lightbox) -->
        <div class="lg:col-span-5 order-1 lg:order-2 flex flex-col gap-3">
          
          <!-- Fullscreen Lightbox Trigger Component -->
          <MuseumLightbox
            artSrc={artSrc}
            artAlt={artAlt}
            title={artTitle}
            artist={artArtist}
            year={artYear}
            museum={artMuseum}
            license={artLicense}
          />

          <!-- Museum Placard -->
          <ArtworkPlacard
            title={artTitle}
            artist={artArtist}
            year={artYear}
            museum={artMuseum}
            license={artLicense}
            compact={false}
          />
        </div>

      </div>

      <!-- 06. Scholarly Provenance & Academic Integrity Box -->
      <SourceAttribution quote={quote} />

      <!-- 06.2. The Agora Dialogue Box: Community Perspectives under Library Work -->
      <LibraryComments
        client:visible
        quoteId={quote.id}
        quoteTitle={quote.cleanTitle}
        categorySlug={quote.primaryTopic.toLowerCase().replace(/_/g, '-')}
      />

      <!-- 06.5. Related Works of Contemplation (Tác Phẩm Chiêm Nghiệm Liên Quan) -->
      <section class="pt-16 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <span class="text-[10px] font-mono tracking-[0.25em] uppercase text-accent font-semibold block">
              CHUYÊN ĐỀ #{quote.primaryTopicTitle}
            </span>
            <h2 class="font-display text-xl sm:text-2xl text-text font-medium" data-i18n-key="detail.relatedWorks">
              Những Câu Nói Cùng Chủ Đề
            </h2>
          </div>
          <a
            href={`/themes/${quote.primaryTopic.toLowerCase().replace(/_/g, '-')}`}
            class="text-xs font-sans text-accent hover:underline flex items-center gap-1 font-semibold tracking-wider uppercase text-[11px]"
          >
            <span>Xem tất cả bài cùng chủ đề</span>
            <span>→</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedQuotes.map((rq) => {
            const rqArt = rq.artInfo?.slides?.slide_1 || `/images/themes/${rq.imageRef}/slide_1_establishing.jpg`;
            return (
              <article class="p-4 border border-border/70 bg-surface/40 hover:border-accent transition-all duration-300 flex flex-col justify-between group rounded-sm">
                <a href={`/library/${rq.slug}`} class="relative aspect-[16/10] overflow-hidden bg-surface block border border-border/40 mb-3.5">
                  <img
                    src={rqArt}
                    alt={rq.cleanTitle}
                    class="w-full h-full object-cover filter brightness-[0.9] group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <span class="absolute top-2 left-2 px-2 py-0.5 text-[9px] font-mono tracking-wider uppercase bg-bg/90 text-accent border border-border/60">
                    {rq.id}
                  </span>
                </a>

                <div class="space-y-2 flex-1 flex flex-col justify-between">
                  <div>
                    <span class="text-[10px] font-sans text-muted block mb-1">
                      {rq.author}
                    </span>
                    <h3 class="font-display text-sm sm:text-base text-text font-medium leading-snug group-hover:text-accent transition-colors line-clamp-2">
                      <a href={`/library/${rq.slug}`}>
                        {rq.cleanTitle}
                      </a>
                    </h3>
                  </div>

                  <div class="pt-3 flex items-center justify-between text-[11px] font-sans">
                    <span class="text-muted text-[10px] uppercase tracking-wider">{rq.quoteTypeLabel}</span>
                    <a href={`/library/${rq.slug}`} class="text-accent group-hover:underline font-semibold uppercase tracking-wider text-[10px] flex items-center gap-1">
                      <span>Đọc tiếp</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- 07. Navigation Plaques (Previous / Next) -->
      <nav class="pt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 font-sans text-xs">
        <a
          href={`/library/${prevQuote.slug}`}
          class="p-4 sm:p-5 rounded-xl border border-border/70 hover:border-accent bg-surface/40 hover:bg-surface/80 transition-all duration-300 flex items-center gap-3.5 group shadow-xs"
        >
          <span class="w-8 h-8 rounded-full bg-surface border border-border/60 text-muted group-hover:text-accent group-hover:border-accent/60 flex items-center justify-center text-sm transition-transform duration-200 group-hover:-translate-x-1 flex-shrink-0">
            ←
          </span>
          <div class="overflow-hidden">
            <span class="text-[10px] uppercase tracking-widest text-muted block">Tác phẩm trước</span>
            <span class="font-display text-sm text-text font-medium truncate block group-hover:text-accent transition-colors">
              {prevQuote.cleanTitle}
            </span>
          </div>
        </a>

        <a
          href={`/library/${nextQuote.slug}`}
          class="p-4 sm:p-5 rounded-xl border border-border/70 hover:border-accent bg-surface/40 hover:bg-surface/80 transition-all duration-300 flex items-center justify-between text-right gap-3.5 group shadow-xs"
        >
          <div class="overflow-hidden text-right flex-1">
            <span class="text-[10px] uppercase tracking-widest text-muted block">Tác phẩm kế tiếp</span>
            <span class="font-display text-sm text-text font-medium truncate block group-hover:text-accent transition-colors">
              {nextQuote.cleanTitle}
            </span>
          </div>
          <span class="w-8 h-8 rounded-full bg-surface border border-border/60 text-muted group-hover:text-accent group-hover:border-accent/60 flex items-center justify-center text-sm transition-transform duration-200 group-hover:translate-x-1 flex-shrink-0">
            →
          </span>
        </a>
      </nav>

    </div>
  </article>

  <!-- Client-side script for Copy, Bookmark, and Share -->
  <script is:inline define:vars={{ quoteId: quote.id, quoteText: quote.content, quoteAuthor: quote.author }}>
    // Copy quote button
    const copyBtn = document.getElementById('copy-quote-btn');
    const copyText = document.getElementById('copy-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', () => {
        const fullQuote = `"${quoteText}" — ${quoteAuthor} (Hiyu Abyss #${quoteId})`;
        navigator.clipboard.writeText(fullQuote).then(() => {
          copyText.textContent = 'Đã sao chép ✓';
          setTimeout(() => {
            copyText.textContent = 'Sao Chép Triết Ngôn';
          }, 2000);
        });
      });
    }

    // Bookmark / Saved in LocalStorage
    const bookmarkBtn = document.getElementById('bookmark-btn');
    const bookmarkIcon = document.getElementById('bookmark-icon');
    const bookmarkText = document.getElementById('bookmark-text');

    function checkBookmarkStatus() {
      try {
        const saved = JSON.parse(localStorage.getItem('hiyu_saved_quotes') || '[]');
        const isSaved = saved.includes(quoteId);
        if (bookmarkIcon && bookmarkText) {
          bookmarkIcon.textContent = isSaved ? '★' : '☆';
          bookmarkText.textContent = isSaved ? 'Đã Lưu Vào Kho' : 'Lưu Chiêm Nghiệm';
          if (isSaved) {
            bookmarkBtn.classList.add('border-accent', 'text-accent');
          } else {
            bookmarkBtn.classList.remove('border-accent', 'text-accent');
          }
        }
      } catch (e) {}
    }

    if (bookmarkBtn) {
      checkBookmarkStatus();
      bookmarkBtn.addEventListener('click', () => {
        try {
          const saved = JSON.parse(localStorage.getItem('hiyu_saved_quotes') || '[]');
          const idx = saved.indexOf(quoteId);
          if (idx > -1) {
            saved.splice(idx, 1);
          } else {
            saved.push(quoteId);
          }
          localStorage.setItem('hiyu_saved_quotes', JSON.stringify(saved));
          checkBookmarkStatus();
          window.dispatchEvent(new Event('hiyu-bookmark-updated'));
        } catch (e) {}
      });
    }

    // Share button
    const shareBtn = document.getElementById('share-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        if (navigator.share) {
          navigator.share({
            title: `Hiyu Abyss — ${quoteAuthor}`,
            text: `"${quoteText}"`,
            url: window.location.href,
          }).catch(() => {});
        } else {
          navigator.clipboard.writeText(window.location.href).then(() => {
            alert('Đã sao chép liên kết vào clipboard!');
          });
        }
      });
    }
  </script>
</BaseLayout>
