---
// src/pages/library/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getAllPublishedQuotes, getAllTopics } from '../../lib/content-publisher';

const quotes = getAllPublishedQuotes();
const topics = getAllTopics();
---

<BaseLayout
  title="The Library · Thư Viện Giám Tuyển 100 Tác Phẩm"
  description="Kho lưu trữ 100 tác phẩm triết học tâm lý và mỹ học cổ điển. Phân loại theo 20 dòng tư tưởng mở."
>
  <Header slot="header" />

  <section class="py-12 md:py-16 bg-bg border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-border/60">
        <div>
          <span class="font-sans text-xs tracking-[0.25em] text-accent uppercase font-bold">
            The Living Library
          </span>
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-text font-bold mt-1">
            Thư Viện Triết Học Chiêm Nghiệm
          </h1>
          <p class="font-serif text-sm sm:text-base text-muted mt-2 max-w-2xl leading-relaxed">
            100 tác phẩm đã được giám tuyển nghiêm ngặt, đối thoại giữa câu chữ và hội họa bảo tàng. 
            Chọn một chủ đề hoặc để định mệnh dẫn lối bằng tính năng ngẫu nhiên.
          </p>
        </div>

        <!-- Surprise Me Button -->
        <button
          id="surprise-btn"
          type="button"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded border border-accent bg-accent/10 text-accent hover:bg-accent hover:text-on-accent transition-all duration-300 font-sans text-xs tracking-[0.15em] uppercase font-bold min-h-[44px] shadow-sm self-start md:self-auto flex-shrink-0"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
          <span>Bốc Bài Ngẫu Nhiên (Surprise Me)</span>
        </button>
      </div>

      <!-- Open Taxonomy Filter Bar -->
      <div class="mb-10">
        <div class="text-xs font-sans tracking-[0.15em] text-muted uppercase font-semibold mb-3 flex items-center justify-between">
          <span>Lọc Theo Chủ Đề:</span>
          <span id="active-count" class="text-accent font-bold">100 / 100 tác phẩm</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            class="filter-btn active px-3.5 py-1.5 rounded-full text-xs font-sans border border-accent bg-accent text-on-accent font-semibold transition-all min-h-[36px]"
            data-filter="ALL"
          >
            Tất Cả ({quotes.length})
          </button>
          {topics.map((t) => (
            <button
              class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-sans border border-border bg-surface text-muted hover:text-text hover:border-accent transition-all min-h-[36px]"
              data-filter={t.code}
            >
              {t.title} <span class="opacity-70 text-[10px]">({t.count})</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Quotes Magazine Grid -->
      <div id="quotes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {quotes.map((q) => (
          <QuoteCard quote={q} />
        ))}
      </div>

      <!-- Empty State (hidden by default) -->
      <div id="empty-state" class="hidden py-16 text-center">
        <p class="font-serif text-lg text-muted italic">Không tìm thấy tác phẩm nào thuộc chủ đề này.</p>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ quoteSlugs: quotes.map((q) => q.slug) }}>
  // Surprise Me Functionality
  const surpriseBtn = document.getElementById('surprise-btn');
  if (surpriseBtn) {
    surpriseBtn.addEventListener('click', () => {
      if (quoteSlugs && quoteSlugs.length > 0) {
        const rand = quoteSlugs[Math.floor(Math.random() * quoteSlugs.length)];
        window.location.href = `/library/${rand}`;
      }
    });
  }

  // Dynamic Taxonomy Filtering
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.quote-card');
  const countEl = document.getElementById('active-count');
  const emptyState = document.getElementById('empty-state');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Toggle button styles
      filterBtns.forEach((b) => {
        b.classList.remove('bg-accent', 'text-on-accent', 'border-accent', 'font-semibold');
        b.classList.add('bg-surface', 'text-muted', 'border-border');
      });
      btn.classList.add('bg-accent', 'text-on-accent', 'border-accent', 'font-semibold');
      btn.classList.remove('bg-surface', 'text-muted', 'border-border');

      const filter = btn.getAttribute('data-filter');
      let visible = 0;

      cards.forEach((card) => {
        const topics = card.getAttribute('data-topic') || '';
        if (filter === 'ALL' || topics.includes(filter)) {
          card.classList.remove('hidden');
          visible++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countEl) {
        countEl.textContent = `${visible} / ${cards.length} tác phẩm`;
      }

      if (emptyState) {
        if (visible === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    });
  });
</script>
