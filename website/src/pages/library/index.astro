---
// src/pages/library/index.astro - The Living Library V3 (Editorial / Gallery / Index Views)
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ArtworkPlacard from '../../components/ArtworkPlacard.astro';
import { getAllPublishedQuotes, getAllTopics } from '../../lib/content-publisher';

const quotes = getAllPublishedQuotes();
const topics = getAllTopics();
---

<BaseLayout
  title="The Library · Thư Viện Giám Tuyển Triết Học & Mỹ Thuật"
  description="Kho lưu trữ giám tuyển các tác phẩm triết học tâm lý và kiệt tác hội họa bảo tàng cổ điển. Hỗ trợ 3 chế độ xem: Editorial, Gallery và Index."
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Page Masthead -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 pb-8 border-b border-border/70">
      <div class="space-y-4 max-w-3xl">
        <div class="flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-sans text-muted">
          <span class="text-accent font-semibold">THE LIVING LIBRARY</span>
          <span class="text-muted/30">/</span>
          <span>{quotes.length} TÁC PHẨM ĐÃ GIÁM TUYỂN</span>
        </div>

        <h1 class="font-display text-3xl sm:text-5xl md:text-6xl text-text font-medium leading-[1.12] tracking-tight text-balance">
          Thư Viện Triết Học Chiêm Nghiệm
        </h1>

        <p class="font-serif italic text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
          Kho tàng câu chữ sắc bén đối thoại cùng hội họa bảo tàng qua hàng thế kỷ. Khám phá theo dòng tư tưởng hoặc chuyển đổi giữa các chế độ xem để chiêm ngưỡng tác phẩm theo cách của bạn.
        </p>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex flex-wrap items-center gap-3 self-start lg:self-auto">
        <!-- Surprise Me Button -->
        <button
          id="surprise-btn"
          type="button"
          class="px-5 py-2.5 border border-accent/80 bg-accent/10 text-accent hover:bg-accent hover:text-on-accent transition-colors font-sans text-xs tracking-wider uppercase font-semibold flex items-center gap-2 min-h-[44px]"
          title="Mở ngẫu nhiên 1 tác phẩm"
        >
          <span>🎲 Bốc Bài Ngẫu Nhiên</span>
        </button>
      </div>
    </div>

    <!-- View Modes & Filter Toolbar -->
    <div class="space-y-6 pt-2">
      
      <!-- Top Toolbar: View Switchers & Search Input -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
        <!-- 3 View Mode Switchers -->
        <div class="flex items-center gap-1 font-sans text-xs" role="tablist" aria-label="Chế độ xem thư viện">
          <button
            id="view-editorial-btn"
            type="button"
            class="view-mode-btn active px-4 py-2 border border-accent bg-accent text-on-accent font-semibold uppercase tracking-wider transition-colors"
            data-view="editorial"
          >
            Tạp Chí (Editorial)
          </button>
          <button
            id="view-gallery-btn"
            type="button"
            class="view-mode-btn px-4 py-2 border border-border bg-surface text-muted hover:text-text uppercase tracking-wider transition-colors"
            data-view="gallery"
          >
            Mỹ Thuật (Gallery)
          </button>
          <button
            id="view-index-btn"
            type="button"
            class="view-mode-btn px-4 py-2 border border-border bg-surface text-muted hover:text-text uppercase tracking-wider transition-colors"
            data-view="index"
          >
            Mục Lục (Index)
          </button>
        </div>

        <!-- Filter Count Status -->
        <div class="text-xs font-sans text-muted flex items-center gap-2">
          <span>Hiển thị:</span>
          <strong id="filter-count" class="text-accent font-semibold">{quotes.length} / {quotes.length}</strong>
          <span>tác phẩm</span>
        </div>
      </div>

      <!-- Topic Filter Tabs -->
      <div class="space-y-3">
        <span class="text-[11px] font-sans text-muted tracking-wider uppercase block">
          Lọc theo luồng tư tưởng:
        </span>
        <div class="flex flex-wrap gap-2">
          <button
            class="topic-btn active px-3.5 py-1.5 text-xs font-sans border border-accent bg-accent text-on-accent font-semibold transition-colors"
            data-topic="ALL"
          >
            Tất Cả ({quotes.length})
          </button>
          {topics.map((t) => (
            <button
              class="topic-btn px-3.5 py-1.5 text-xs font-sans border border-border/70 bg-surface/40 text-muted hover:text-text hover:border-accent transition-colors"
              data-topic={t.code}
            >
              #{t.title} ({t.count})
            </button>
          ))}
        </div>
      </div>

    </div>

    <!-- ============================================== -->
    <!-- VIEW MODE 1: EDITORIAL (Magazine Spread Layout) -->
    <!-- ============================================== -->
    <div id="view-editorial" class="view-panel space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 items-stretch">
        {quotes.map((q) => {
          const artSrc = q.artInfo?.slides?.slide_1 || `/images/themes/${q.imageRef}/slide_1_establishing.jpg`;
          return (
            <article
              class="quote-item flex flex-col justify-between border border-border/70 bg-surface/30 hover:border-accent transition-colors duration-300 group"
              data-topic={q.topicCodes.join(' ')}
              data-type={q.quoteType}
              data-slug={q.slug}
            >
              <!-- Artwork Preview Header -->
              <div class="relative aspect-[16/10] overflow-hidden bg-surface block border-b border-border/60">
                <a href={`/library/${q.slug}`} class="block w-full h-full">
                  <img
                    src={artSrc}
                    alt={q.cleanTitle}
                    class="w-full h-full object-cover filter brightness-[0.92] group-hover:scale-105 group-hover:brightness-100 transition-all duration-700"
                    loading="lazy"
                  />
                </a>
                <span class="absolute top-3 left-3 px-2.5 py-0.5 text-[10px] font-sans tracking-widest uppercase bg-bg/90 text-accent border border-border/60 pointer-events-none">
                  #{q.primaryTopicTitle}
                </span>

                <!-- Quick Bookmark Heart Button -->
                <button
                  type="button"
                  class="quick-save-card-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-black/70 backdrop-blur-md border border-white/20 text-white hover:text-accent hover:border-accent hover:scale-110 flex items-center justify-center transition-all z-10 opacity-90 sm:opacity-0 sm:group-hover:opacity-100 shadow-md"
                  data-id={q.id}
                  title="Lưu vào kho chiêm nghiệm"
                  aria-label="Lưu vào kho"
                  aria-pressed="false"
                >
                  <svg class="w-4 h-4 heart-icon transition-colors" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" fill="none">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                </button>
              </div>

              <!-- Card Body -->
              <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center justify-between text-xs text-muted font-sans">
                    <span class="text-text/90 font-medium">{q.author}</span>
                    <span class="text-[10px] uppercase tracking-wider">{q.quoteTypeLabel}</span>
                  </div>

                  <h3 class="font-display text-xl text-text font-medium group-hover:text-accent transition-colors leading-snug">
                    <a href={`/library/${q.slug}`}>
                      {q.cleanTitle}
                    </a>
                  </h3>

                  <p class="font-serif text-sm text-text/85 italic leading-relaxed line-clamp-3">
                    "{q.content}"
                  </p>
                </div>

                <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs font-sans text-muted">
                  <span class="font-mono text-[11px]">{q.id}</span>
                  <a
                    href={`/library/${q.slug}`}
                    class="text-accent group-hover:underline flex items-center gap-1 font-semibold text-[11px] uppercase tracking-widest"
                  >
                    <span>Chiêm nghiệm</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- ============================================== -->
    <!-- VIEW MODE 2: GALLERY (Art-First Museum Wall)   -->
    <!-- ============================================== -->
    <div id="view-gallery" class="view-panel hidden space-y-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8 items-stretch">
        {quotes.map((q) => {
          const artSrc = q.artInfo?.slides?.slide_1 || `/images/themes/${q.imageRef}/slide_1_establishing.jpg`;
          return (
            <article
              class="quote-item flex flex-col justify-between border border-border/80 bg-surface/40 hover:border-accent transition-colors duration-300 group"
              data-topic={q.topicCodes.join(' ')}
              data-type={q.quoteType}
              data-slug={q.slug}
            >
              <div class="relative aspect-[9/16] overflow-hidden bg-surface block">
                <a href={`/library/${q.slug}`} class="block w-full h-full">
                  <img
                    src={artSrc}
                    alt={q.cleanTitle}
                    class="w-full h-full object-cover filter brightness-[0.9] group-hover:scale-105 group-hover:brightness-100 transition-all duration-700"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent opacity-80" />
                  <div class="absolute bottom-3 left-3 right-3 text-left">
                    <span class="font-mono text-[10px] text-accent block">{q.id}</span>
                    <p class="font-display text-sm text-text font-medium truncate">
                      {q.cleanTitle}
                    </p>
                    <span class="text-[10px] font-sans text-muted truncate block">
                      {q.author}
                    </span>
                  </div>
                </a>

                <!-- Quick Bookmark Heart Button -->
                <button
                  type="button"
                  class="quick-save-card-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-black/70 backdrop-blur-md border border-white/20 text-white hover:text-accent hover:border-accent hover:scale-110 flex items-center justify-center transition-all z-10 opacity-90 sm:opacity-0 sm:group-hover:opacity-100 shadow-md"
                  data-id={q.id}
                  title="Lưu vào kho chiêm nghiệm"
                  aria-label="Lưu vào kho"
                  aria-pressed="false"
                >
                  <svg class="w-4 h-4 heart-icon transition-colors" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" fill="none">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                </button>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- ============================================== -->
    <!-- VIEW MODE 3: INDEX (Compact Scan Table)        -->
    <!-- ============================================== -->
    <div id="view-index" class="view-panel hidden">
      <div class="border border-border/80 overflow-x-auto">
        <table class="w-full text-left font-sans text-xs">
          <thead class="bg-surface/80 border-b border-border/80 text-[11px] uppercase tracking-wider text-muted">
            <tr>
              <th class="p-4 font-semibold">Mã</th>
              <th class="p-4 font-semibold">Tác Phẩm & Tuyên Ngôn</th>
              <th class="p-4 font-semibold">Tư Tưởng Gia</th>
              <th class="p-4 font-semibold">Dòng Tư Tưởng</th>
              <th class="p-4 font-semibold">Phân Loại</th>
              <th class="p-4 text-right font-semibold">Đọc</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/40">
            {quotes.map((q) => (
              <tr
                class="quote-item hover:bg-surface/40 transition-colors group"
                data-topic={q.topicCodes.join(' ')}
                data-type={q.quoteType}
                data-slug={q.slug}
              >
                <td class="p-4 font-mono text-accent font-semibold whitespace-nowrap">
                  {q.id}
                </td>
                <td class="p-4 max-w-md">
                  <a href={`/library/${q.slug}`} class="font-display text-base text-text font-medium group-hover:text-accent transition-colors block">
                    {q.cleanTitle}
                  </a>
                  <p class="font-serif italic text-muted text-xs line-clamp-1 mt-0.5">
                    "{q.content}"
                  </p>
                </td>
                <td class="p-4 text-text/90 font-medium whitespace-nowrap">
                  {q.author}
                </td>
                <td class="p-4 text-muted whitespace-nowrap">
                  #{q.primaryTopicTitle}
                </td>
                <td class="p-4 whitespace-nowrap">
                  <span class="px-2 py-0.5 border border-border text-[10px] text-muted">
                    {q.quoteTypeLabel}
                  </span>
                </td>
                <td class="p-4 text-right whitespace-nowrap">
                  <a
                    href={`/library/${q.slug}`}
                    class="text-accent group-hover:underline font-semibold"
                  >
                    Xem →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Client-side Interactive Filter & View State Manager -->
  <script is:inline>
    // State
    const urlParams = new URLSearchParams(window.location.search);
    let activeView = urlParams.get('view') || 'editorial';
    let activeTopic = urlParams.get('topic') || 'ALL';

    const viewPanels = {
      editorial: document.getElementById('view-editorial'),
      gallery: document.getElementById('view-gallery'),
      index: document.getElementById('view-index'),
    };

    const viewButtons = {
      editorial: document.getElementById('view-editorial-btn'),
      gallery: document.getElementById('view-gallery-btn'),
      index: document.getElementById('view-index-btn'),
    };

    const topicButtons = document.querySelectorAll('.topic-btn');
    const filterCountEl = document.getElementById('filter-count');
    const allQuoteItems = document.querySelectorAll('.quote-item');
    const totalCount = allQuoteItems.length / 3; // divided by 3 panels

    function updateUrl() {
      const p = new URLSearchParams();
      if (activeView !== 'editorial') p.set('view', activeView);
      if (activeTopic !== 'ALL') p.set('topic', activeTopic);
      const newQuery = p.toString();
      const newUrl = window.location.pathname + (newQuery ? '?' + newQuery : '');
      window.history.replaceState({}, '', newUrl);
    }

    function setView(mode) {
      if (!viewPanels[mode]) return;
      activeView = mode;

      // Toggle panels
      Object.keys(viewPanels).forEach((k) => {
        if (k === mode) {
          viewPanels[k]?.classList.remove('hidden');
          viewButtons[k]?.classList.add('border-accent', 'bg-accent', 'text-on-accent', 'font-semibold');
          viewButtons[k]?.classList.remove('border-border', 'bg-surface', 'text-muted');
        } else {
          viewPanels[k]?.classList.add('hidden');
          viewButtons[k]?.classList.remove('border-accent', 'bg-accent', 'text-on-accent', 'font-semibold');
          viewButtons[k]?.classList.add('border-border', 'bg-surface', 'text-muted');
        }
      });

      updateUrl();
    }

    function setTopic(topicCode) {
      activeTopic = topicCode;

      // Update topic buttons active style
      topicButtons.forEach((btn) => {
        if (btn.getAttribute('data-topic') === topicCode) {
          btn.classList.add('border-accent', 'bg-accent', 'text-on-accent', 'font-semibold');
          btn.classList.remove('border-border/70', 'bg-surface/40', 'text-muted');
        } else {
          btn.classList.remove('border-accent', 'bg-accent', 'text-on-accent', 'font-semibold');
          btn.classList.add('border-border/70', 'bg-surface/40', 'text-muted');
        }
      });

      // Filter all quote items across all 3 panels
      let visibleInPanel = 0;
      allQuoteItems.forEach((item) => {
        const itemTopics = item.getAttribute('data-topic')?.split(' ') || [];
        if (topicCode === 'ALL' || itemTopics.includes(topicCode)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });

      // Count visible in active panel
      const activeItems = viewPanels[activeView]?.querySelectorAll('.quote-item:not(.hidden)');
      const count = activeItems ? activeItems.length : 0;
      if (filterCountEl) {
        filterCountEl.textContent = `${count} / ${Math.round(allQuoteItems.length / 3)}`;
      }

      updateUrl();
    }

    // Bind view buttons
    Object.keys(viewButtons).forEach((k) => {
      viewButtons[k]?.addEventListener('click', () => setView(k));
    });

    // Bind topic buttons
    topicButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.getAttribute('data-topic') || 'ALL';
        setTopic(t);
      });
    });

    // Initialize from URL
    if (activeView && viewPanels[activeView]) setView(activeView);
    if (activeTopic) setTopic(activeTopic);

    // Surprise Me Randomizer
    const surpriseBtn = document.getElementById('surprise-btn');
    if (surpriseBtn) {
      surpriseBtn.addEventListener('click', () => {
        const visibleItems = viewPanels[activeView]?.querySelectorAll('.quote-item:not(.hidden)');
        if (visibleItems && visibleItems.length > 0) {
          const randomIndex = Math.floor(Math.random() * visibleItems.length);
          const targetSlug = visibleItems[randomIndex].getAttribute('data-slug');
          if (targetSlug) {
            window.location.href = `/library/${targetSlug}`;
          }
        }
      });
    }

    // Quick Bookmark Heart Buttons Logic
    function syncLibraryHeartButtons() {
      try {
        const saved = JSON.parse(localStorage.getItem('hiyu_saved_quotes') || '[]');
        document.querySelectorAll('.quick-save-card-btn').forEach((btn) => {
          const id = btn.getAttribute('data-id');
          const isSaved = saved.includes(id);
          const icon = btn.querySelector('.heart-icon');
          if (isSaved) {
            btn.setAttribute('aria-pressed', 'true');
            btn.classList.remove('opacity-90', 'sm:opacity-0');
            btn.classList.add('opacity-100', 'text-accent', 'border-accent');
            if (icon) icon.setAttribute('fill', 'currentColor');
          } else {
            btn.setAttribute('aria-pressed', 'false');
            btn.classList.remove('text-accent', 'border-accent');
            btn.classList.add('opacity-90', 'sm:opacity-0');
            if (icon) icon.setAttribute('fill', 'none');
          }
        });
      } catch (e) {}
    }

    syncLibraryHeartButtons();
    window.addEventListener('storage', syncLibraryHeartButtons);
    window.addEventListener('hiyu-bookmark-updated', syncLibraryHeartButtons);

    document.querySelectorAll('.quick-save-card-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const id = btn.getAttribute('data-id');
          const saved = JSON.parse(localStorage.getItem('hiyu_saved_quotes') || '[]');
          const idx = saved.indexOf(id);
          if (idx > -1) {
            saved.splice(idx, 1);
          } else {
            saved.push(id);
          }
          localStorage.setItem('hiyu_saved_quotes', JSON.stringify(saved));
          syncLibraryHeartButtons();
          window.dispatchEvent(new Event('hiyu-bookmark-updated'));
        } catch (e) {}
      });
    });
  </script>
</BaseLayout>
