---
// website/src/pages/mirror/[journey].astro
// Permanent 301 redirect from legacy Mirror journeys to The Atlas trails
import { getPublicJourneys } from '../../lib/content-publisher';

export function getStaticPaths() {
  const journeys = getPublicJourneys();
  return journeys.map((journey) => ({
    params: { journey: journey.slug },
  }));
}

const { journey } = Astro.params;
return Astro.redirect(`/atlas?trail=${journey || ''}`, 301);
---
