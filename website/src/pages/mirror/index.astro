---
// src/pages/mirror/index.astro - Cột trụ The Mirror: Không Gian Chiêm Nghiệm Tĩnh Lặng
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublicJourneys } from '../../lib/content-publisher';

const journeys = getPublicJourneys();
---

<BaseLayout
  title="The Mirror — Không Gian Chiêm Nghiệm | Hiyu Abyss"
  description="The Mirror là hành trình đọc tương tác, nơi câu hỏi quan trọng hơn câu trả lời. Đối diện với các lát cắt tâm lý và triết học sâu sắc."
>
  <Header />

  <main class="min-h-screen pt-24 sm:pt-32 pb-20 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto space-y-16 sm:space-y-24">
      {/* Intro Masthead */}
      <div class="text-center max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-secondary)] text-xs font-sans tracking-widest uppercase text-[var(--accent-primary)]">
          <span class="w-2 h-2 rounded-full bg-[var(--accent-primary)]"></span>
          Trụ Cột Chiêm Nghiệm Tương Tác
        </div>
        <h1 class="font-display text-4xl sm:text-6xl font-medium tracking-tight text-[var(--text-primary)]">
          The Mirror
        </h1>
        <p class="font-serif italic text-lg sm:text-2xl text-[var(--text-secondary)] leading-relaxed">
          "Chiếc gương không tạo ra bóng tối hay ánh sáng; nó chỉ trả lại nguyên vẹn những gì bạn dám đặt trước mặt nó."
        </p>
        <p class="font-sans text-sm sm:text-base text-[var(--text-tertiary)] max-w-xl mx-auto leading-relaxed">
          Đây không phải bài kiểm tra tâm lý hay phân loại nhân cách. The Mirror mở ra những lối rẽ tư tưởng để bạn tự vấn, xem xét lại những xác tín quen thuộc và khám phá chiều sâu nội tâm.
        </p>
      </div>

      {/* Journeys List */}
      <div class="space-y-8">
        <div class="border-b border-[var(--border-subtle)] pb-4 flex items-center justify-between">
          <span class="text-xs uppercase tracking-widest font-sans text-[var(--text-tertiary)]">
            Hành Trình Khởi Động ({journeys.length})
          </span>
          <span class="text-xs font-sans text-[var(--text-tertiary)]">
            Bảo mật 100% · Không lưu trữ dữ liệu cá nhân
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {journeys.map((j) => (
            <div class="group relative bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--accent-primary)] rounded overflow-hidden transition-all duration-500 hover:shadow-2xl flex flex-col justify-between">
              {j.artwork_url && (
                <div class="relative aspect-[16/10] overflow-hidden bg-black/40">
                  <img
                    src={j.artwork_url}
                    alt={j.title}
                    class="w-full h-full object-cover filter brightness-85 group-hover:scale-105 group-hover:brightness-100 transition-all duration-700"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-surface)] via-transparent to-transparent opacity-90"></div>
                  <div class="absolute top-4 left-4">
                    <span class="px-2.5 py-1 text-[11px] font-sans uppercase tracking-widest rounded bg-black/60 text-white/90 backdrop-blur-sm border border-white/10">
                      {j.estimated_minutes} phút chiêm nghiệm
                    </span>
                  </div>
                </div>
              )}

              <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-6">
                <div class="space-y-3">
                  <div class="text-xs uppercase tracking-widest font-sans text-[var(--accent-primary)]">
                    {j.id}
                  </div>
                  <h2 class="font-display text-2xl sm:text-3xl font-medium text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">
                    {j.title}
                  </h2>
                  <p class="font-serif italic text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
                    {j.subtitle}
                  </p>
                  <p class="font-sans text-xs sm:text-sm text-[var(--text-tertiary)] leading-relaxed line-clamp-3 pt-2">
                    {j.intro.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between">
                  <span class="font-sans text-xs text-[var(--text-tertiary)]">
                    5 chặng suy tưởng
                  </span>
                  <a
                    href={`/mirror/${j.slug}`}
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--text-primary)] text-[var(--bg-primary)] text-xs uppercase tracking-widest font-sans font-medium rounded hover:opacity-90 transition-all shadow-md group-hover:translate-x-1"
                  >
                    <span>Bước vào</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Safety & Philosophy Callout */}
      <div class="p-8 sm:p-12 rounded bg-[var(--bg-secondary)] border border-[var(--border-subtle)] grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="space-y-2">
          <div class="text-xs uppercase tracking-widest font-sans text-[var(--accent-primary)]">
            01. Quyền Riêng Tư
          </div>
          <h4 class="font-serif font-medium text-base text-[var(--text-primary)]">
            Ẩn danh tuyệt đối
          </h4>
          <p class="font-sans text-xs text-[var(--text-tertiary)] leading-relaxed">
            Mọi thao tác và lựa chọn diễn ra 100% trong trình duyệt của bạn. Chúng tôi không thu thập thông tin cá nhân hay lưu trữ câu trả lời.
          </p>
        </div>

        <div class="space-y-2">
          <div class="text-xs uppercase tracking-widest font-sans text-[var(--accent-primary)]">
            02. Tự Do Lựa Chọn
          </div>
          <h4 class="font-serif font-medium text-base text-[var(--text-primary)]">
            Không áp đặt định kiến
          </h4>
          <p class="font-sans text-xs text-[var(--text-tertiary)] leading-relaxed">
            Không có câu trả lời đúng hay sai. Mỗi lối rẽ là một lăng kính triết học để bạn soi lại kinh nghiệm sống của chính mình.
          </p>
        </div>

        <div class="space-y-2">
          <div class="text-xs uppercase tracking-widest font-sans text-[var(--accent-primary)]">
            03. Tĩnh Lặng
          </div>
          <h4 class="font-serif font-medium text-base text-[var(--text-primary)]">
            Rời đi bất kỳ lúc nào
          </h4>
          <p class="font-sans text-xs text-[var(--text-tertiary)] leading-relaxed">
            Bạn có thể tạm dừng, suy ngẫm hoặc thoát khỏi hành trình bất cứ khi nào cảm thấy cần không gian riêng.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
