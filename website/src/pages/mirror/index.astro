---
// src/pages/mirror/index.astro - The Mirror Portal V3 (Museum Editorial Exhibition)
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ArtworkPlacard from '../../components/ArtworkPlacard.astro';
import { getPublicJourneys } from '../../lib/content-publisher';

const journeys = getPublicJourneys();
---

<BaseLayout
  title="The Mirror — Buồng Chiêm Nghiệm & Những Ngã Rẽ Tư Tưởng | Hiyu Abyss"
  description="The Mirror là không gian tự sự triết học nhiều nhánh (Directed Scene Graph), nơi câu hỏi quan trọng hơn câu trả lời."
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-16 sm:space-y-24">
      
      <!-- Masthead -->
      <div class="text-center max-w-3xl mx-auto space-y-6">
        <div class="flex items-center justify-center gap-2 text-xs tracking-[0.25em] uppercase font-sans text-muted">
          <span class="text-accent font-semibold">THE MIRROR PORTAL</span>
          <span class="text-muted/30">/</span>
          <span>DIRECTED SCENE GRAPH</span>
        </div>

        <h1 class="font-display text-4xl sm:text-6xl font-medium tracking-tight text-text">
          Buồng Chiêm Nghiệm & Tự Vấn
        </h1>

        <blockquote class="font-serif italic text-lg sm:text-2xl text-muted leading-relaxed max-w-2xl mx-auto">
          "Chiếc gương không tạo ra bóng tối hay ánh sáng; nó chỉ trả lại nguyên vẹn những gì bạn dám đặt trước mặt nó."
        </blockquote>

        <p class="font-sans text-sm sm:text-base text-muted/80 max-w-xl mx-auto leading-relaxed">
          The Mirror không phải bài kiểm tra tính cách hay trắc nghiệm tâm lý. Mỗi hành trình là một không gian đối thoại đa chiều với ít nhất 2 ngã rẽ và các kết thúc mở độc lập, giúp bạn bóc tách những xác tín quen thuộc.
        </p>
      </div>

      <!-- Journeys Gallery (Museum Editorial Layout, No SaaS Double-Bezel Cards) -->
      <div class="space-y-8">
        <div class="border-b border-border/70 pb-4 flex items-center justify-between text-xs font-sans text-muted">
          <span class="uppercase tracking-[0.2em] font-semibold text-accent">
            Hành Trình Đã Khởi Động ({journeys.length})
          </span>
          <span class="text-[11px] tracking-wider">
            100% Cục Bộ · Zero Profiling
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-stretch">
          {journeys.map((j) => {
            const entryNode = j.nodes?.[j.entry || 'threshold'];
            const introDescription = entryNode?.body || j.intro?.description || j.subtitle;
            const nodeCount = j.nodes ? Object.keys(j.nodes).length : 5;
            
            return (
              <article class="flex flex-col justify-between border border-border/80 bg-surface/40 hover:border-accent transition-colors duration-300 group">
                <!-- Artwork Preview Frame -->
                {j.artwork_url && (
                  <div class="relative aspect-[16/10] overflow-hidden bg-surface border-b border-border/60">
                    <img
                      src={j.artwork_url}
                      alt={j.title}
                      class="w-full h-full object-cover filter brightness-[0.85] group-hover:scale-105 group-hover:brightness-100 transition-all duration-700"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent opacity-80" />
                    <div class="absolute top-4 left-4">
                      <span class="px-3 py-1 text-[10px] font-sans uppercase tracking-widest bg-bg/90 text-text border border-border/70 font-medium">
                        {j.estimated_minutes || 3} phút chiêm nghiệm
                      </span>
                    </div>
                  </div>
                )}

                <!-- Journey Content -->
                <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-6">
                  <div class="space-y-3">
                    <div class="text-[11px] uppercase tracking-[0.2em] font-sans text-accent font-semibold flex items-center justify-between">
                      <span>{j.id}</span>
                      <span class="text-muted text-[10px]">{nodeCount} phân cảnh đối thoại</span>
                    </div>

                    <h2 class="font-display text-2xl sm:text-3xl font-medium text-text group-hover:text-accent transition-colors leading-snug">
                      <a href={`/mirror/${j.slug}`}>{j.title}</a>
                    </h2>

                    <p class="font-serif italic text-sm sm:text-base text-muted leading-relaxed">
                      {j.subtitle}
                    </p>

                    <p class="font-sans text-xs sm:text-sm text-text/80 leading-relaxed line-clamp-3 pt-1 border-t border-border/40">
                      "{introDescription}"
                    </p>
                  </div>

                  <!-- Museum Action Button -->
                  <div class="pt-4 border-t border-border/60 flex items-center justify-between">
                    <span class="font-sans text-[11px] text-muted tracking-wider">
                      Phân nhánh có 4 kết thúc
                    </span>
                    <a
                      href={`/mirror/${j.slug}`}
                      class="px-5 py-2.5 bg-accent text-on-accent text-xs uppercase tracking-widest font-sans font-bold hover:opacity-90 transition-opacity inline-flex items-center gap-2"
                    >
                      <span>Bước vào</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <!-- Philosophy & Integrity Pillars -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 border-t border-border/70">
        <div class="border-t-2 border-border/70 pt-4 space-y-2">
          <span class="text-xs font-sans tracking-[0.2em] uppercase font-semibold text-accent block">
            01 · Quyền Riêng Tư Tuyệt Đối
          </span>
          <p class="font-sans text-xs sm:text-sm text-muted leading-relaxed">
            Mọi lựa chọn diễn ra 100% trong trình duyệt. Không máy chủ nào ghi nhận câu trả lời hay xây dựng hồ sơ tâm lý của bạn.
          </p>
        </div>

        <div class="border-t-2 border-border/70 pt-4 space-y-2">
          <span class="text-xs font-sans tracking-[0.2em] uppercase font-semibold text-accent block">
            02 · Tự Sự Rẽ Nhánh
          </span>
          <p class="font-sans text-xs sm:text-sm text-muted leading-relaxed">
            Các lựa chọn không dẫn về cùng một đáp án. Mỗi ngã rẽ mở ra một phản đề riêng và một kết thúc độc lập.
          </p>
        </div>

        <div class="border-t-2 border-border/70 pt-4 space-y-2">
          <span class="text-xs font-sans tracking-[0.2em] uppercase font-semibold text-accent block">
            03 · Không Phán Xét
          </span>
          <p class="font-sans text-xs sm:text-sm text-muted leading-relaxed">
            The Mirror không chấm điểm con người bạn. Nó trao lại cho bạn quyền tự quan sát và quyết định hướng đi của chính mình.
          </p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
