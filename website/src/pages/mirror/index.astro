---
// src/pages/mirror/index.astro - Cổng vào Trụ Cột The Mirror: Không Gian Chiêm Nghiệm Tĩnh Lặng
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicJourneys } from '../../lib/content-publisher';

const journeys = getPublicJourneys();
---

<BaseLayout
  title="The Mirror — Không Gian Chiêm Nghiệm | Hiyu Abyss"
  description="The Mirror là hành trình đọc tương tác, nơi câu hỏi quan trọng hơn câu trả lời. Đối diện với các lát cắt tâm lý và triết học sâu sắc."
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto space-y-16 sm:space-y-24">
      
      <!-- Intro Masthead -->
      <div class="text-center max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-accent/30 bg-accent/10 text-[10px] font-sans tracking-[0.2em] uppercase font-medium text-accent">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          Trụ Cột Chiêm Nghiệm Tương Tác
        </div>
        <h1 class="font-display text-4xl sm:text-6xl font-medium tracking-tight text-text">
          The Mirror
        </h1>
        <p class="font-serif italic text-lg sm:text-2xl text-muted leading-relaxed">
          "Chiếc gương không tạo ra bóng tối hay ánh sáng; nó chỉ trả lại nguyên vẹn những gì bạn dám đặt trước mặt nó."
        </p>
        <p class="font-sans text-sm sm:text-base text-muted/80 max-w-xl mx-auto leading-relaxed">
          Đây không phải bài kiểm tra tâm lý hay phân loại nhân cách. The Mirror mở ra những lối rẽ tư tưởng để bạn tự vấn, xem xét lại những xác tín quen thuộc và khám phá chiều sâu nội tâm.
        </p>
      </div>

      <!-- Journeys List -->
      <div class="space-y-8">
        <div class="border-b border-border/60 pb-4 flex items-center justify-between text-xs font-sans text-muted">
          <span class="uppercase tracking-widest text-[11px] font-semibold text-accent">
            Hành Trình Khởi Động ({journeys.length})
          </span>
          <span class="text-[11px]">
            Bảo mật 100% · Không lưu trữ dữ liệu cá nhân
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
          {journeys.map((j) => (
            <div class="group p-1.5 rounded-[2rem] bg-surface border border-border/80 hover:border-accent/70 transition-all duration-500 hover:shadow-2xl flex flex-col justify-between">
              <div class="rounded-[calc(2rem-0.375rem)] overflow-hidden bg-bg/90 flex-1 flex flex-col justify-between">
                
                {j.artwork_url && (
                  <div class="relative aspect-[16/10] overflow-hidden bg-surface">
                    <img
                      src={j.artwork_url}
                      alt={j.title}
                      class="w-full h-full object-cover filter brightness-85 group-hover:scale-105 group-hover:brightness-100 transition-all duration-700"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent opacity-90"></div>
                    <div class="absolute top-4 left-4">
                      <span class="px-3 py-1 text-[10px] font-sans uppercase tracking-widest rounded-full bg-bg/80 text-text backdrop-blur-md border border-border/60 font-medium">
                        {j.estimated_minutes} phút chiêm nghiệm
                      </span>
                    </div>
                  </div>
                )}

                <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-6">
                  <div class="space-y-3">
                    <div class="text-[10px] uppercase tracking-[0.2em] font-sans text-accent font-semibold">
                      {j.id}
                    </div>
                    <h2 class="font-display text-2xl sm:text-3xl font-medium text-text group-hover:text-accent transition-colors">
                      {j.title}
                    </h2>
                    <p class="font-serif italic text-sm sm:text-base text-muted leading-relaxed">
                      {j.subtitle}
                    </p>
                    <p class="font-sans text-xs sm:text-sm text-muted/80 leading-relaxed line-clamp-3 pt-1">
                      {j.intro.description}
                    </p>
                  </div>

                  <div class="pt-4 border-t border-border/40 flex items-center justify-between">
                    <span class="font-sans text-xs text-muted">
                      5 chặng suy tưởng
                    </span>
                    <a
                      href={`/mirror/${j.slug}`}
                      class="group/btn inline-flex items-center gap-2 pl-5 pr-2 py-2 bg-accent text-on-accent text-xs uppercase tracking-widest font-sans font-bold rounded-full hover:opacity-95 transition-all shadow-md active:scale-[0.98]"
                    >
                      <span>Bước vào</span>
                      <span class="w-6 h-6 rounded-full bg-on-accent/15 flex items-center justify-center transition-transform group-hover/btn:translate-x-0.5">
                        →
                      </span>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Safety & Philosophy Callout Cards (Doppelrand Double-Bezel) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-1 rounded-2xl bg-surface border border-border/80">
          <div class="p-6 sm:p-8 rounded-[calc(1rem-0.125rem)] bg-bg/60 space-y-2 h-full">
            <div class="text-[10px] uppercase tracking-[0.2em] font-sans text-accent font-semibold">
              01. Quyền Riêng Tư
            </div>
            <h4 class="font-serif font-medium text-base text-text">
              Ẩn danh tuyệt đối
            </h4>
            <p class="font-sans text-xs text-muted leading-relaxed">
              Mọi thao tác và lựa chọn diễn ra 100% trong trình duyệt của bạn. Chúng tôi không thu thập thông tin cá nhân hay lưu trữ câu trả lời.
            </p>
          </div>
        </div>

        <div class="p-1 rounded-2xl bg-surface border border-border/80">
          <div class="p-6 sm:p-8 rounded-[calc(1rem-0.125rem)] bg-bg/60 space-y-2 h-full">
            <div class="text-[10px] uppercase tracking-[0.2em] font-sans text-accent font-semibold">
              02. Tự Do Lựa Chọn
            </div>
            <h4 class="font-serif font-medium text-base text-text">
              Không áp đặt định kiến
            </h4>
            <p class="font-sans text-xs text-muted leading-relaxed">
              Không có câu trả lời đúng hay sai. Mỗi lối rẽ là một lăng kính triết học để bạn soi lại kinh nghiệm sống của chính mình.
            </p>
          </div>
        </div>

        <div class="p-1 rounded-2xl bg-surface border border-border/80">
          <div class="p-6 sm:p-8 rounded-[calc(1rem-0.125rem)] bg-bg/60 space-y-2 h-full">
            <div class="text-[10px] uppercase tracking-[0.2em] font-sans text-accent font-semibold">
              03. Tĩnh Lặng
            </div>
            <h4 class="font-serif font-medium text-base text-text">
              Rời đi bất kỳ lúc nào
            </h4>
            <p class="font-sans text-xs text-muted leading-relaxed">
              Bạn có thể tạm dừng, suy ngẫm hoặc thoát khỏi hành trình bất cứ khi nào cảm thấy cần không gian riêng.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
