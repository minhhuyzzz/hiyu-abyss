---
// src/pages/search.astro - Instant Vietnamese Full-Text Search (Museum Editorial Architecture V3.1)
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPublishedQuotes, getAllTopics } from '../lib/content-publisher';

const allQuotes = getAllPublishedQuotes();
const allTopics = getAllTopics();

// Serialized search index for zero-latency instant client search
const searchIndex = allQuotes.map((q) => {
  const artSrc = q.artInfo?.slides?.slide_1 || `/images/themes/${q.imageRef}/slide_1_establishing.jpg`;
  return {
    id: q.id,
    slug: q.slug,
    title: q.cleanTitle || q.title,
    author: q.author,
    content: q.content,
    intentBadge: q.intentBadge || '',
    primaryTopic: q.primaryTopic,
    primaryTopicTitle: q.primaryTopicTitle,
    quoteType: q.quoteType,
    quoteTypeLabel: q.quoteTypeLabel,
    imageRef: artSrc,
  };
});
---

<BaseLayout
  title="Tìm Kiếm Câu Nói & Chủ Đề | Hiyu Abyss"
  description="Tìm kiếm những câu nói hay, trích dẫn ý nghĩa về tâm lý và cuộc sống theo từ khóa, tác giả hoặc chủ đề."
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-10 sm:space-y-12">
      
      <!-- Masthead -->
      <div class="text-center space-y-4">
        <div class="flex items-center justify-center gap-2 text-xs tracking-[0.25em] uppercase font-sans text-muted">
          <span class="text-accent font-semibold font-mono">TÌM KIẾM</span>
          <span class="text-muted/30">/</span>
          <span>{allQuotes.length} CÂU NÓI CHỌN LỌC</span>
        </div>

        <h1 class="font-display text-3xl sm:text-5xl font-medium tracking-tight text-text">
          Tìm Kiếm Câu Nói
        </h1>

        <p class="font-serif italic text-sm sm:text-lg text-muted max-w-xl mx-auto">
          Tìm câu nói theo từ khóa (ranh giới, lòng tốt, bản ngã, sự thật, cô độc...), tác giả hoặc chủ đề bạn quan tâm.
        </p>

        <!-- Museum Editorial Search Input Box -->
        <div class="max-w-2xl mx-auto mt-6 border border-border/80 focus-within:border-accent bg-surface/50 shadow-sm transition-colors">
          <div class="relative flex items-center px-4 py-2">
            <div class="text-muted pl-1 pr-3 pointer-events-none">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7.5" stroke-width="1.75" />
                <path d="m21 21-4.35-4.35" stroke-width="1.75" stroke-linecap="round" />
              </svg>
            </div>
            <input
              id="search-input"
              type="search"
              placeholder="Nhập từ khóa (thao túng, bản ngã, sự thật, tự do, cô độc...)"
              autocomplete="off"
              class="w-full py-2.5 text-base sm:text-lg bg-transparent border-none font-serif text-text placeholder-muted/60 outline-none"
            />
            <button
              id="clear-search-btn"
              type="button"
              class="hidden text-xs font-sans text-muted hover:text-text py-1 px-3 hover:bg-surface transition-colors"
            >
              Xóa ✕
            </button>
          </div>
        </div>

        <!-- Quick Keyword Suggestion Chips -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-2 text-xs font-sans">
          <span class="text-muted">Gợi ý từ khóa:</span>
          {['Thao túng', 'Bản ngã', 'Đạo đức giả', 'Sự thật', 'Cô độc', 'Tự do', 'Tiêu chuẩn kép'].map((keyword) => (
            <button
              type="button"
              class="quick-tag px-3 py-1 bg-surface border border-border/80 text-muted hover:text-text hover:border-accent transition-colors"
              data-keyword={keyword}
            >
              {keyword}
            </button>
          ))}
        </div>
      </div>

      <!-- Filters & Results Meta (With Downward-Expanding Custom Dropdowns) -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-2 text-xs font-sans text-muted relative z-20">
        <div id="results-count" class="font-medium text-text/80">
          Đang hiển thị tất cả {allQuotes.length} tác phẩm
        </div>

        <div class="flex flex-wrap items-center gap-3">
          
          <!-- Custom Topic Dropdown (Always Opens Downward) -->
          <div class="relative" id="topic-dropdown-wrapper">
            <input type="hidden" id="topic-filter-val" value="" />
            <button
              id="topic-dropdown-trigger"
              type="button"
              class="bg-surface border border-border/80 text-text px-3.5 py-1.5 text-xs outline-none hover:border-accent flex items-center justify-between gap-2.5 transition-colors min-h-[34px]"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span id="topic-dropdown-label">Tất cả chủ đề ({allTopics.length})</span>
              <svg class="w-3.5 h-3.5 text-muted transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Menu listbox: absolute top-full mt-1.5, expands downward -->
            <div
              id="topic-dropdown-menu"
              class="hidden absolute top-full left-0 sm:right-auto mt-1.5 w-72 max-h-64 overflow-y-auto bg-surface border border-border/90 shadow-2xl z-30 py-1 divide-y divide-border/40 font-sans text-xs"
              role="listbox"
            >
              <button
                type="button"
                class="topic-dropdown-item w-full text-left px-4 py-2 hover:bg-surface-raised hover:text-accent flex items-center justify-between transition-colors text-accent font-semibold"
                data-value=""
              >
                <span>Tất cả chủ đề ({allTopics.length})</span>
                <span class="text-[10px]">✓</span>
              </button>
              {allTopics.map((t) => (
                <button
                  type="button"
                  class="topic-dropdown-item w-full text-left px-4 py-2 hover:bg-surface-raised hover:text-accent flex items-center justify-between transition-colors text-text/90"
                  data-value={t.code}
                >
                  <span class="truncate">{t.title}</span>
                  <span class="text-muted text-[11px] font-mono">({t.count})</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Custom Type Dropdown (Always Opens Downward) -->
          <div class="relative" id="type-dropdown-wrapper">
            <input type="hidden" id="type-filter-val" value="" />
            <button
              id="type-dropdown-trigger"
              type="button"
              class="bg-surface border border-border/80 text-text px-3.5 py-1.5 text-xs outline-none hover:border-accent flex items-center justify-between gap-2.5 transition-colors min-h-[34px]"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span id="type-dropdown-label">Tất cả phân loại</span>
              <svg class="w-3.5 h-3.5 text-muted transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div
              id="type-dropdown-menu"
              class="hidden absolute top-full right-0 mt-1.5 w-56 max-h-64 overflow-y-auto bg-surface border border-border/90 shadow-2xl z-30 py-1 divide-y divide-border/40 font-sans text-xs"
              role="listbox"
            >
              <button
                type="button"
                class="type-dropdown-item w-full text-left px-4 py-2 hover:bg-surface-raised hover:text-accent flex items-center justify-between transition-colors text-accent font-semibold"
                data-value=""
              >
                <span>Tất cả phân loại</span>
                <span class="text-[10px]">✓</span>
              </button>
              <button
                type="button"
                class="type-dropdown-item w-full text-left px-4 py-2 hover:bg-surface-raised hover:text-accent flex items-center justify-between transition-colors text-text/90"
                data-value="DIRECT_QUOTE"
              >
                <span>Trích dẫn nguyên văn</span>
              </button>
              <button
                type="button"
                class="type-dropdown-item w-full text-left px-4 py-2 hover:bg-surface-raised hover:text-accent flex items-center justify-between transition-colors text-text/90"
                data-value="PARAPHRASE"
              >
                <span>Diễn giải tư tưởng</span>
              </button>
              <button
                type="button"
                class="type-dropdown-item w-full text-left px-4 py-2 hover:bg-surface-raised hover:text-accent flex items-center justify-between transition-colors text-text/90"
                data-value="INSPIRED_ORIGINAL"
              >
                <span>Sáng tác lấy cảm hứng</span>
              </button>
              <button
                type="button"
                class="type-dropdown-item w-full text-left px-4 py-2 hover:bg-surface-raised hover:text-accent flex items-center justify-between transition-colors text-text/90"
                data-value="INDEPENDENT_ORIGINAL"
              >
                <span>Sáng tác Hiyu Abyss</span>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- Results Container -->
      <div id="search-results" class="space-y-6">
        <!-- Rendered by client script below -->
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-20 space-y-4 border border-dashed border-border/80 p-8">
        <div class="text-3xl text-muted">∅</div>
        <h3 class="font-display text-2xl text-text font-medium">
          Không tìm thấy kết quả phù hợp
        </h3>
        <p class="font-serif italic text-sm text-muted max-w-md mx-auto leading-relaxed">
          Hãy thử tìm kiếm với từ khóa ngắn gọn hơn, không dấu, hoặc đặt lại các bộ lọc phân loại.
        </p>
        <button
          id="reset-filter-btn"
          type="button"
          class="mt-2 px-5 py-2 border border-border/80 hover:border-accent font-sans text-xs uppercase tracking-widest text-accent transition-colors"
        >
          Đặt lại bộ lọc
        </button>
      </div>

    </div>
  </div>

  <!-- Embedded Instant Search Engine Script -->
  <script is:inline define:vars={{ searchIndex, allTopicsCount: allTopics.length }}>
    function removeVietnameseTones(str) {
      if (!str) return '';
      str = str.toLowerCase();
      str = str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      str = str.replace(/[đĐ]/g, 'd');
      return str;
    }

    const searchInput = document.getElementById('search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    const resultsContainer = document.getElementById('search-results');
    const resultsCount = document.getElementById('results-count');
    const emptyState = document.getElementById('empty-state');
    const resetFilterBtn = document.getElementById('reset-filter-btn');
    const quickTags = document.querySelectorAll('.quick-tag');

    // Custom Dropdown Elements
    const topicTrigger = document.getElementById('topic-dropdown-trigger');
    const topicMenu = document.getElementById('topic-dropdown-menu');
    const topicLabel = document.getElementById('topic-dropdown-label');
    const topicValInput = document.getElementById('topic-filter-val');
    const topicItems = document.querySelectorAll('.topic-dropdown-item');

    const typeTrigger = document.getElementById('type-dropdown-trigger');
    const typeMenu = document.getElementById('type-dropdown-menu');
    const typeLabel = document.getElementById('type-dropdown-label');
    const typeValInput = document.getElementById('type-filter-val');
    const typeItems = document.querySelectorAll('.type-dropdown-item');

    function toggleMenu(menu, trigger) {
      const isClosed = menu.classList.contains('hidden');
      closeAllMenus();
      if (isClosed) {
        menu.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      }
    }

    function closeAllMenus() {
      if (topicMenu) topicMenu.classList.add('hidden');
      if (typeMenu) typeMenu.classList.add('hidden');
      if (topicTrigger) topicTrigger.setAttribute('aria-expanded', 'false');
      if (typeTrigger) typeTrigger.setAttribute('aria-expanded', 'false');
    }

    if (topicTrigger && topicMenu) {
      topicTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu(topicMenu, topicTrigger);
      });
    }

    if (typeTrigger && typeMenu) {
      typeTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu(typeMenu, typeTrigger);
      });
    }

    document.addEventListener('click', () => {
      closeAllMenus();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllMenus();
    });

    topicItems.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const val = btn.getAttribute('data-value');
        topicValInput.value = val;
        topicLabel.textContent = btn.querySelector('span:first-child').textContent;
        topicItems.forEach((b) => b.classList.remove('text-accent', 'font-semibold'));
        btn.classList.add('text-accent', 'font-semibold');
        closeAllMenus();
        doFilter();
      });
    });

    typeItems.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const val = btn.getAttribute('data-value');
        typeValInput.value = val;
        typeLabel.textContent = btn.querySelector('span:first-child').textContent;
        typeItems.forEach((b) => b.classList.remove('text-accent', 'font-semibold'));
        btn.classList.add('text-accent', 'font-semibold');
        closeAllMenus();
        doFilter();
      });
    });

    function renderResults(quotes, query) {
      // Clear previous results safely
      resultsContainer.textContent = '';

      if (quotes.length === 0) {
        emptyState.classList.remove('hidden');
        resultsCount.textContent = 'Không có kết quả nào';
        return;
      }

      emptyState.classList.add('hidden');
      resultsCount.textContent = `Tìm thấy ${quotes.length} tác phẩm phù hợp`;

      const fragment = document.createDocumentFragment();

      for (const q of quotes) {
        const article = document.createElement('article');
        article.className = 'border border-border/70 bg-surface/30 hover:border-accent p-6 sm:p-8 transition-colors duration-200';

        const row = document.createElement('div');
        row.className = 'flex flex-col sm:flex-row gap-6 items-start';

        // Optional Artwork Image
        if (q.imageRef) {
          const imgContainer = document.createElement('div');
          imgContainer.className = 'w-full sm:w-36 h-28 sm:h-36 flex-shrink-0 overflow-hidden bg-surface border border-border/60';

          const img = document.createElement('img');
          img.src = q.imageRef;
          img.alt = q.title || 'Artwork thumbnail';
          img.className = 'w-full h-full object-cover filter brightness-90 hover:scale-105 transition-all duration-500';
          img.loading = 'lazy';
          imgContainer.appendChild(img);
          row.appendChild(imgContainer);
        }

        const contentCol = document.createElement('div');
        contentCol.className = 'flex-1 space-y-3';

        // Badges Row
        const badgesRow = document.createElement('div');
        badgesRow.className = 'flex flex-wrap items-center gap-2 text-xs font-sans';

        const idSpan = document.createElement('span');
        idSpan.className = 'text-accent font-semibold tracking-wider font-mono';
        idSpan.textContent = q.id;

        const dot1 = document.createElement('span');
        dot1.className = 'text-border';
        dot1.textContent = '·';

        const typeSpan = document.createElement('span');
        typeSpan.className = 'text-muted uppercase tracking-wider text-[10px]';
        typeSpan.textContent = q.quoteTypeLabel;

        const dot2 = document.createElement('span');
        dot2.className = 'text-border';
        dot2.textContent = '·';

        const topicSpan = document.createElement('span');
        topicSpan.className = 'text-text font-medium text-[11px]';
        topicSpan.textContent = '#' + q.primaryTopicTitle;

        badgesRow.appendChild(idSpan);
        badgesRow.appendChild(dot1);
        badgesRow.appendChild(typeSpan);
        badgesRow.appendChild(dot2);
        badgesRow.appendChild(topicSpan);
        contentCol.appendChild(badgesRow);

        // Title with link
        const h2 = document.createElement('h2');
        h2.className = 'font-display text-xl sm:text-2xl font-medium text-text leading-snug';
        const titleLink = document.createElement('a');
        titleLink.href = `/library/${encodeURIComponent(q.slug)}`;
        titleLink.className = 'hover:text-accent transition-colors';
        titleLink.textContent = q.title;
        h2.appendChild(titleLink);
        contentCol.appendChild(h2);

        // Quote Content
        const pContent = document.createElement('p');
        pContent.className = 'font-serif italic text-sm text-text/85 line-clamp-3 leading-relaxed';
        pContent.textContent = `"${q.content}"`;
        contentCol.appendChild(pContent);

        // Footer Row
        const footerDiv = document.createElement('div');
        footerDiv.className = 'pt-3 border-t border-border/40 flex items-center justify-between text-xs font-sans';

        const authorSpan = document.createElement('span');
        authorSpan.className = 'text-muted';
        authorSpan.textContent = 'Tác giả: ';
        const strongAuthor = document.createElement('strong');
        strongAuthor.className = 'text-text font-medium';
        strongAuthor.textContent = q.author;
        authorSpan.appendChild(strongAuthor);

        const actionLink = document.createElement('a');
        actionLink.href = `/library/${encodeURIComponent(q.slug)}`;
        actionLink.className = 'inline-flex items-center gap-1.5 text-accent hover:underline font-semibold uppercase tracking-wider text-[11px]';

        const actionSpan = document.createElement('span');
        actionSpan.textContent = 'Chiêm nghiệm';
        const arrowSpan = document.createElement('span');
        arrowSpan.textContent = '→';
        actionLink.appendChild(actionSpan);
        actionLink.appendChild(arrowSpan);

        footerDiv.appendChild(authorSpan);
        footerDiv.appendChild(actionLink);
        contentCol.appendChild(footerDiv);

        row.appendChild(contentCol);
        article.appendChild(row);
        fragment.appendChild(article);
      }

      resultsContainer.appendChild(fragment);
    }

    function syncUrlParams(q, topic, type) {
      if (typeof window === 'undefined') return;
      const url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
      if (topic) url.searchParams.set('topic', topic); else url.searchParams.delete('topic');
      if (type) url.searchParams.set('type', type); else url.searchParams.delete('type');
      window.history.replaceState({}, '', url.toString());
    }

    function doFilter(updateUrl = true) {
      const q = searchInput.value.trim();
      const topicVal = topicValInput.value;
      const typeVal = typeValInput.value;

      if (q.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }

      if (updateUrl) {
        syncUrlParams(q, topicVal, typeVal);
      }

      const normalizedQ = removeVietnameseTones(q);

      const filtered = searchIndex.filter((item) => {
        // Topic filter
        if (topicVal && item.primaryTopic !== topicVal) return false;
        // Type filter
        if (typeVal && item.quoteType !== typeVal) return false;
        // Search text query
        if (normalizedQ) {
          const titleNorm = removeVietnameseTones(item.title);
          const authorNorm = removeVietnameseTones(item.author);
          const contentNorm = removeVietnameseTones(item.content);
          const topicNorm = removeVietnameseTones(item.primaryTopicTitle);

          const matches =
            titleNorm.includes(normalizedQ) ||
            authorNorm.includes(normalizedQ) ||
            contentNorm.includes(normalizedQ) ||
            topicNorm.includes(normalizedQ) ||
            item.id.toLowerCase().includes(normalizedQ);

          if (!matches) return false;
        }

        return true;
      });

      renderResults(filtered, q);
    }

    // Read initial URL params on load
    const initialUrlParams = new URLSearchParams(window.location.search);
    const initialQ = initialUrlParams.get('q');
    const initialTopic = initialUrlParams.get('topic');
    const initialType = initialUrlParams.get('type');

    if (initialQ) {
      searchInput.value = initialQ;
    }
    if (initialTopic) {
      topicValInput.value = initialTopic;
      const matchedBtn = Array.from(topicItems).find((b) => b.getAttribute('data-value') === initialTopic);
      if (matchedBtn) {
        topicLabel.textContent = matchedBtn.querySelector('span:first-child').textContent;
        topicItems.forEach((b) => b.classList.remove('text-accent', 'font-semibold'));
        matchedBtn.classList.add('text-accent', 'font-semibold');
      }
    }
    if (initialType) {
      typeValInput.value = initialType;
      const matchedBtn = Array.from(typeItems).find((b) => b.getAttribute('data-value') === initialType);
      if (matchedBtn) {
        typeLabel.textContent = matchedBtn.querySelector('span:first-child').textContent;
        typeItems.forEach((b) => b.classList.remove('text-accent', 'font-semibold'));
        matchedBtn.classList.add('text-accent', 'font-semibold');
      }
    }

    searchInput.addEventListener('input', doFilter);

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      doFilter();
      searchInput.focus();
    });

    resetFilterBtn.addEventListener('click', () => {
      searchInput.value = '';
      topicValInput.value = '';
      typeValInput.value = '';
      topicLabel.textContent = `Tất cả chủ đề (${allTopicsCount})`;
      typeLabel.textContent = 'Tất cả phân loại';
      topicItems.forEach((b) => b.classList.remove('text-accent', 'font-semibold'));
      typeItems.forEach((b) => b.classList.remove('text-accent', 'font-semibold'));
      if (topicItems[0]) topicItems[0].classList.add('text-accent', 'font-semibold');
      if (typeItems[0]) typeItems[0].classList.add('text-accent', 'font-semibold');
      doFilter();
    });

    quickTags.forEach((tag) => {
      tag.addEventListener('click', () => {
        searchInput.value = tag.getAttribute('data-keyword');
        doFilter();
      });
    });

    // Initial render
    doFilter();
  </script>
</BaseLayout>
