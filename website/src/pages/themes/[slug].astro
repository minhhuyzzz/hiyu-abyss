---
// src/pages/themes/[slug].astro - Dynamic Topic Gallery
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getAllTopics, getQuotesByTopic } from '../../lib/content-publisher';
import type { TopicDefinition } from '../../lib/types';

export function getStaticPaths() {
  const topics = getAllTopics();
  return topics.map((t) => ({
    params: { slug: t.slug },
    props: { topic: t },
  }));
}

interface Props {
  topic: TopicDefinition;
}

const { topic } = Astro.props;
const quotes = getQuotesByTopic(topic.code);
---

<BaseLayout
  title={`${topic.title} · Chủ Đề Triết Học Hiyu Abyss`}
  description={topic.description}
>
  <section class="py-12 sm:py-20 md:py-28 border-b border-border/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-sans text-muted pb-4 border-b border-border/60">
        <a href="/" class="hover:text-text transition-colors">Trang Chủ</a>
        <span>/</span>
        <a href="/themes" class="hover:text-text transition-colors">Chủ Đề</a>
        <span>/</span>
        <span class="text-accent font-semibold">{topic.title}</span>
      </nav>

      <!-- Topic Header -->
      <div class="pb-8 border-b border-border/60 space-y-4">
        <div class="flex items-center gap-3">
          <span class="px-3.5 py-1 rounded-full text-[10px] font-sans font-medium tracking-[0.2em] uppercase bg-accent/15 text-accent border border-accent/30">
            #{topic.code}
          </span>
          <span class="text-xs text-muted font-sans">{quotes.length} tác phẩm</span>
        </div>
        <h1 class="font-display text-3xl sm:text-5xl md:text-6xl text-text font-medium leading-tight">
          {topic.title}
        </h1>
        <p class="font-serif text-base sm:text-xl text-muted max-w-2xl leading-relaxed italic">
          "{topic.description}"
        </p>
      </div>

      <!-- Quotes Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        {quotes.map((q) => (
          <QuoteCard quote={q} />
        ))}
      </div>

      <!-- Back to all topics button -->
      <div class="pt-8 flex justify-center">
        <a
          href="/themes"
          class="px-6 py-3 rounded-full border border-border/80 hover:border-accent font-sans text-xs uppercase tracking-widest text-muted hover:text-text transition-colors"
        >
          ← Xem tất cả chủ đề
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
