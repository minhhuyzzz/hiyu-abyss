---
// src/pages/themes/[slug].astro - Dynamic Thematic Atlas & Curated Works
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkPlacard from '../../components/ArtworkPlacard.astro';
import { getAllTopics, getQuotesByTopic } from '../../lib/content-publisher';
import { getOptimizedThumb } from '../../lib/image-optimizer';
import type { TopicDefinition } from '../../lib/types';

export function getStaticPaths() {
  const topics = getAllTopics();
  return topics.map((t) => ({
    params: { slug: t.slug },
    props: { topic: t },
  }));
}

interface Props {
  topic: TopicDefinition;
}

const { topic } = Astro.props;
const quotes = getQuotesByTopic(topic.code);
---

<BaseLayout
  title={`${topic.title} · Những Câu Nói Hay & Góc Nhìn Sâu Sắc · Hiyu Abyss`}
  description={topic.description}
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-sans text-muted pb-4 border-b border-border/70">
      <a href="/" class="hover:text-text transition-colors">Trang Chủ</a>
      <span>/</span>
      <a href="/themes" class="hover:text-text transition-colors">Chủ Đề</a>
      <span>/</span>
      <span class="text-accent font-semibold">#{topic.title}</span>
    </nav>

    <!-- Thematic Masthead -->
    <div class="pb-8 border-b border-border/70 space-y-4">
      <div class="flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-sans text-muted">
        <span class="text-accent font-semibold">#{topic.code}</span>
        <span class="text-muted/30">/</span>
        <span>{quotes.length} CÂU NÓI CHỌN LỌC</span>
      </div>

      <h1 class="font-display text-3xl sm:text-5xl md:text-6xl text-text font-medium leading-[1.12] tracking-tight text-balance">
        {topic.title}
      </h1>

      <p class="font-serif italic text-base sm:text-xl text-muted max-w-3xl leading-relaxed">
        "{topic.description}"
      </p>

      <div class="pt-2 flex items-center gap-3">
        <a
          href={`/atlas?focus=theme-${topic.code.toLowerCase().replace(/_/g, '-')}`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-sm bg-surface hover:bg-surface-raised border border-accent/40 text-accent font-sans text-xs uppercase tracking-wider font-semibold transition-all shadow-xs"
        >
          <span>✦</span>
          <span>Khám Phá Vị Trí Trên The Atlas</span>
        </a>
      </div>
    </div>

    <!-- Curated Works Grid (Museum Editorial Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {quotes.map((q) => {
        const artSrc = q.artInfo?.slides?.slide_1 || `/images/themes/${q.imageRef}/slide_1_establishing.jpg`;
        const thumbSrc = getOptimizedThumb(artSrc, { width: 400, height: 400 });
        return (
          <article class="flex flex-col justify-between border border-border/80 bg-surface/30 hover:border-accent transition-colors duration-300 group">
            <!-- Artwork Preview (Square 1:1 Gallery Aspect) -->
            <a href={`/library/${q.slug}`} class="relative aspect-square overflow-hidden bg-surface block border-b border-border/60">
              <img
                src={thumbSrc}
                alt={q.cleanTitle}
                class="w-full h-full object-cover filter brightness-[0.92] group-hover:scale-105 group-hover:brightness-100 transition-all duration-700"
                loading="lazy"
                onerror={`this.onerror=null; this.src='${artSrc}';`}
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 text-[10px] font-sans tracking-widest uppercase bg-bg/90 text-accent border border-border/60">
                {q.id}
              </span>
            </a>

            <!-- Content Area -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs text-muted font-sans">
                  <span class="text-text/90 font-medium">{q.author}</span>
                  <span class="text-[10px] uppercase tracking-wider">{q.quoteTypeLabel}</span>
                </div>

                <h3 class="font-display text-xl text-text font-medium group-hover:text-accent transition-colors leading-snug">
                  <a href={`/library/${q.slug}`}>
                    {q.cleanTitle}
                  </a>
                </h3>
              </div>

              <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs font-sans text-muted">
                <span class="text-[11px] font-mono">{q.id}</span>
                <a
                  href={`/library/${q.slug}`}
                  class="text-accent group-hover:underline flex items-center gap-1 font-semibold text-[11px] uppercase tracking-widest"
                >
                  <span>Chiêm nghiệm</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Footer Back Navigation -->
    <div class="pt-8 border-t border-border/60 flex items-center justify-between">
      <a
        href="/themes"
        class="px-6 py-3 border border-border/80 bg-surface text-muted hover:text-text hover:border-accent font-sans text-xs uppercase tracking-widest font-semibold transition-colors flex items-center gap-2"
      >
        <span>← Xem tất cả chủ đề</span>
      </a>

      <a
        href="/library"
        class="text-accent hover:underline font-sans text-xs uppercase tracking-widest font-semibold"
      >
        Vào toàn bộ Thư Viện →
      </a>
    </div>

  </div>
</BaseLayout>
