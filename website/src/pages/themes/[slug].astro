---
// src/pages/themes/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getAllTopics, getQuotesByTopic } from '../../lib/content-publisher';
import type { TopicDefinition } from '../../lib/types';

export function getStaticPaths() {
  const topics = getAllTopics();
  return topics.map((t) => ({
    params: { slug: t.slug },
    props: { topic: t },
  }));
}

interface Props {
  topic: TopicDefinition;
}

const { topic } = Astro.props;
const quotes = getQuotesByTopic(topic.code);
---

<BaseLayout
  title={`${topic.title} · Chủ Đề Triết Học Hiyu Abyss`}
  description={topic.description}
>
  <Header slot="header" />

  <section class="py-12 md:py-16 bg-bg border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-sans text-muted mb-8 pb-4 border-b border-border/50">
        <a href="/" class="hover:text-text transition-colors">Trang Chủ</a>
        <span>/</span>
        <a href="/themes" class="hover:text-text transition-colors">Chủ Đề</a>
        <span>/</span>
        <span class="text-accent font-semibold">{topic.title}</span>
      </nav>

      <!-- Topic Header -->
      <div class="mb-12 pb-6 border-b border-border/60">
        <div class="flex items-center gap-3 mb-2">
          <span class="px-3 py-1 rounded-full text-xs font-sans font-semibold tracking-wider uppercase bg-accent/15 text-accent border border-accent/30">
            {topic.code}
          </span>
          <span class="text-xs text-muted font-sans">{quotes.length} tác phẩm</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-text font-bold mt-2">
          {topic.title}
        </h1>
        <p class="font-serif text-base sm:text-lg text-muted mt-3 max-w-2xl leading-relaxed italic">
          "{topic.description}"
        </p>
      </div>

      <!-- Quotes Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {quotes.map((q) => (
          <QuoteCard quote={q} />
        ))}
      </div>

      <!-- Navigation back to all themes -->
      <div class="mt-14 pt-8 border-t border-border/60 text-center">
        <a
          href="/themes"
          class="inline-flex items-center gap-2 px-6 py-3 rounded border border-border bg-surface text-text hover:border-accent hover:text-accent font-sans text-xs tracking-wider uppercase font-semibold transition-colors"
        >
          <span>← Quay lại tất cả các chủ đề</span>
        </a>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
