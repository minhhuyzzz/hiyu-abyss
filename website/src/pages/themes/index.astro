---
// src/pages/themes/index.astro - Atlas of Ideas (Open Taxonomy Map - Masterplan V3)
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getAllTopics } from '../../lib/content-publisher';

const topics = getAllTopics();
---

<BaseLayout
  title="Chủ Đề Cuộc Sống & Lòng Người · Hiyu Abyss"
  description="Tổng hợp những câu nói hay, sâu sắc theo từng chủ đề về cuộc sống, tâm lý và con người."
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Masthead -->
    <div class="pb-8 border-b border-border/70 space-y-4">
      <div class="flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-sans text-muted">
        <span class="text-accent font-semibold">DANH MỤC CHỦ ĐỀ</span>
        <span class="text-muted/30">/</span>
        <span>GÓC NHÌN ĐỜI THƯỜNG</span>
      </div>

      <h1 class="font-display text-3xl sm:text-5xl md:text-6xl text-text font-medium leading-[1.12] tracking-tight text-balance">
        Chủ Đề Cuộc Sống & Tâm Lý
      </h1>

      <p class="font-serif italic text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
        Mỗi chủ đề là một góc nhìn gần gũi về những trăn trở, cảm xúc và các mối quan hệ đời thực, giúp bạn tìm thấy câu nói chạm đến lòng mình.
      </p>
    </div>

    <!-- Themes Grid (Museum Editorial Atlas Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {topics.map((t) => (
        <a
          href={`/themes/${t.slug}`}
          class="border border-border/80 bg-surface/30 hover:border-accent p-6 sm:p-8 flex flex-col justify-between gap-6 transition-colors duration-300 group"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs font-sans text-muted">
              <span class="font-mono text-[11px] tracking-widest uppercase text-accent font-semibold">
                {t.code}
              </span>
              <span class="text-[11px] text-muted">
                {t.count} câu nói
              </span>
            </div>

            <h2 class="font-display text-2xl text-text font-medium group-hover:text-accent transition-colors leading-snug">
              {t.title}
            </h2>

            <p class="font-serif italic text-sm text-text/80 leading-relaxed line-clamp-3">
              "{t.description}"
            </p>
          </div>

          <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs text-accent font-sans font-semibold tracking-widest uppercase text-[11px]">
            <span>Xem các câu nói</span>
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>
