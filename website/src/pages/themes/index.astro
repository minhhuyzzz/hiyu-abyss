---
// src/pages/themes/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllTopics } from '../../lib/content-publisher';

const topics = getAllTopics();
---

<BaseLayout
  title="Bản Đồ Chủ Đề Triết Học Mở · Hiyu Abyss"
  description="Khám phá 20 dòng tư tưởng và nghịch lý tâm lý học hành vi được giám tuyển trong Thư Viện Hiyu Abyss."
>
  <Header slot="header" />

  <section class="py-12 md:py-16 bg-bg border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12 pb-6 border-b border-border/60">
        <span class="font-sans text-xs tracking-[0.25em] text-accent uppercase font-bold">
          Open Seed Taxonomy
        </span>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-text font-bold mt-1">
          Bản Đồ Chủ Đề Triết Học
        </h1>
        <p class="font-serif text-sm sm:text-base text-muted mt-2 max-w-2xl leading-relaxed">
          Hệ thống phân loại tư tưởng mở của Hiyu Abyss không bị giới hạn cố định. Mỗi chủ đề là một lát cắt sâu sắc về thân phận con người và những chiếc mặt nạ xã hội.
        </p>
      </div>

      <!-- Themes Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {topics.map((t) => (
          <a
            href={`/themes/${t.slug}`}
            class="group p-6 rounded-lg border border-border bg-surface/70 hover:border-accent hover:bg-surface transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-muted font-sans mb-3">
                <span class="font-mono text-[11px] tracking-wider uppercase text-accent font-semibold">{t.code}</span>
                <span class="px-2 py-0.5 rounded-full bg-bg border border-border text-[10px]">{t.count} tác phẩm</span>
              </div>
              <h2 class="font-display text-xl text-text font-bold mb-2 group-hover:text-accent transition-colors">
                {t.title}
              </h2>
              <p class="font-serif text-sm text-muted leading-relaxed line-clamp-3">
                {t.description}
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-border/40 flex items-center justify-between text-xs text-accent font-sans font-semibold">
              <span>Khám phá chủ đề</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
