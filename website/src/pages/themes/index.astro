---
// src/pages/themes/index.astro - Atlas of Ideas (Open Taxonomy Map - Masterplan V3)
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getAllTopics } from '../../lib/content-publisher';

const topics = getAllTopics();
---

<BaseLayout
  title="Chủ Đề Cuộc Sống & Lòng Người · Hiyu Abyss"
  description="Tổng hợp những câu nói hay, sâu sắc theo từng chủ đề về cuộc sống, tâm lý và con người."
>
  <div class="py-12 sm:py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Masthead -->
    <div class="pb-8 border-b border-border/70 space-y-4">
      <div class="flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-mono text-muted">
        <span class="text-accent font-semibold">DANH MỤC CHỦ ĐỀ</span>
        <span class="text-muted/30">/</span>
        <span>ATLAS TRIẾT HỌC & TÂM LÝ</span>
      </div>

      <h1 class="font-display text-3xl sm:text-5xl md:text-6xl text-text font-medium leading-[1.12] tracking-tight text-balance">
        Chủ Đề Cuộc Sống & Tâm Lý
      </h1>

      <p class="font-serif italic text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
        20 cánh sảnh tư tưởng — nơi mỗi chủ đề là một lát cắt giải phẫu các nghịch lý bản ngã, cơ chế phòng vệ và chiều sâu đối thoại trong nhân tính.
      </p>
    </div>

    <!-- Themes Grid (Museum Editorial Atlas Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {topics.map((t) => (
        <a
          href={`/themes/${t.slug}`}
          class="border border-border/70 bg-surface/30 hover:bg-surface/60 hover:border-accent/70 p-6 sm:p-7 rounded-xl flex flex-col justify-between gap-6 transition-all duration-300 hover:shadow-[0_12px_32px_rgba(0,0,0,0.35)] hover:-translate-y-0.5 group"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs font-sans text-muted">
              <span class="font-mono text-[10px] tracking-widest uppercase text-accent font-semibold px-2 py-0.5 rounded bg-accent/10 border border-accent/20">
                {t.code}
              </span>
              <span class="text-[11px] font-mono text-muted/80">
                {t.count} tác phẩm
              </span>
            </div>

            <h2 class="font-display text-xl sm:text-2xl text-text font-medium group-hover:text-accent transition-colors leading-snug">
              {t.title}
            </h2>

            <p class="font-serif italic text-sm text-text/80 leading-relaxed line-clamp-3">
              "{t.description}"
            </p>
          </div>

          <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs text-accent font-sans font-semibold tracking-widest uppercase text-[11px]">
            <span>Khám phá chủ đề</span>
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>
